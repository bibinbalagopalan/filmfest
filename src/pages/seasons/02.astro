---
// src/pages/seasons/02.astro
import Layout from "../../layouts/Layout.astro";

const festivalFacts = [
  { label: "Edition", value: "Season 02 (2025)" },
  { label: "Date", value: "29 November 2025" },
  { label: "Venue", value: "Varna Theatre & Outdoor LED Arena, Mananthavady" },
  { label: "Inaugurated by", value: "Ajayan Chalissery (Kerala State Award Winner - Manjummel Boys)" },
  { label: "Jury Chairman", value: "Santhosh Mandoor (Writer & Director)" },
];

const winners = [
  {
    category: "Best Short Film",
    film: "Kanam",
    recipient: "Directed by Mridul S",
    prize: "₹25,000 Cash Prize & Trophy",
    sponsor: "Endowed by Rishi Group, Bangalore",
    images: [
      { src: "https://i.ibb.co/YTKSmkLj/Best-Film.jpg", alt: "Kanam - Best Film Presentation" },
      { src: "https://i.ibb.co/4g9Y6xp5/10.jpg", alt: "Kanam Team on Stage" },
    ],
  },
  {
    category: "Best Popular Short Film",
    film: "Kanam",
    recipient: "Directed by Mridul S",
    prize: "₹10,000 Cash Prize & Trophy",
    sponsor: "Endowed by Inox Agencies, Mananthavady (Voted via Electronic Voting)",
    images: [
      { src: "https://i.ibb.co/JwZj6Tdk/4.jpg", alt: "Varna Theatre Audience & Screening" },
    ],
  },
  {
    category: "Best Director",
    film: "Ura",
    recipient: "Sruthil Mathew",
    prize: "₹15,000 Cash Prize & Trophy",
    sponsor: "Endowed by Nilgiri Arts & Science College, Thaloor",
    images: [
      { src: "https://i.ibb.co/ksZcnnhr/Best-Director-URA-Sruthil-Mathew.jpg", alt: "Sruthil Mathew - Director of Ura" },
      { src: "https://i.ibb.co/Z9jWDCD/Best-Directer.jpg", alt: "Best Director Award Presentation" },
    ],
  },
  {
    category: "Best Cinematographer",
    film: "Golden Love",
    recipient: "Nijo Abraham",
    prize: "₹10,000 Cash Prize & Trophy",
    sponsor: "Category Introduced in Season 02",
    images: [
      { src: "https://i.ibb.co/j9qTM6wM/Best-Cinematographer.jpg", alt: "Nijo Abraham - Best Cinematographer" },
    ],
  },
];

const specialMentions = [
  { title: "Tta", type: "Jury Special Mention" },
  { title: "Treesa", type: "Jury Special Mention" },
  { title: "Timeless", type: "Jury Special Mention" },
];

const festivalDignitaries = [
  "Ajayan Chalissery (Chief Guest & Inaugurator)",
  "Santhosh Mandoor (Jury Chairman)",
  "P. C. Sanath (Patron, Drishtidosham Chalachithravedi)",
  "Pradeep Mangalassery (Advisor, Drishtidosham)",
  "Babu Philip (President, Spandanam Charitable Trust)",
  "Neethu Vincent (President, Pazhassi Smaraka Granthalayam)",
  "Thomas Sevior (Secretary, Pazhassi Smaraka Granthalayam)",
  "A. Ayoob (Joint Secretary, Pazhassi Smaraka Granthalayam)",
  "K. P. Sunith (Convenor, Drishtidosham Chalachithravedi)",
  "E. V. Arun (Joint Convenor, Drishtidosham)",
  "A. Ajaykumar",
];

const seasonMoments = [
  { src: "https://i.ibb.co/mC4H1MgK/1.jpg", alt: "Season 02 Moment 1" },
  { src: "https://i.ibb.co/KxHxmk1T/2.jpg", alt: "Season 02 Moment 2" },
  { src: "https://i.ibb.co/TBTCTz1z/3.jpg", alt: "Season 02 Moment 3" },
  { src: "https://i.ibb.co/hRBb5YNy/5.jpg", alt: "Season 02 Moment 5" },
  { src: "https://i.ibb.co/Qj8VWR5G/6.jpg", alt: "Season 02 Moment 6" },
  { src: "https://i.ibb.co/WNkXQhPH/7.jpg", alt: "Season 02 Moment 7" },
  { src: "https://i.ibb.co/B53kxjGZ/8.jpg", alt: "Season 02 Moment 8" },
  { src: "https://i.ibb.co/tp8Hh3Vg/9.jpg", alt: "Season 02 Moment 9" },
];
---

<Layout title="Pazhassi Film Festival Season 02 (2025) | PSFF S02">
  <div class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden">
    
    <!-- Background Graph Grid, Swirls & Film Perforations -->
    <div class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden">
      <!-- Top & Bottom Film Reel Border Patterns -->
      <div 
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>
      <div 
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>

      <!-- Golden Graph Grid Overlay -->
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      ></div>

      <!-- Golden Traditional Line Art & Swirl Vectors -->
      <svg class="absolute -left-20 top-20 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8" />
      </svg>
      <svg class="absolute -right-24 bottom-24 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6" />
      </svg>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Page Header -->
      <header class="border-b border-[#FDB813]/30 pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-200">
          <a href="/" class="hover:text-[#FDB813] transition-colors">&larr; Back to Festival</a>
          <span>&bull;</span>
          <span class="text-[#FDB813] font-bold">Archives</span>
          <span>&bull;</span>
          <span>2025 Edition</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white font-mono leading-none drop-shadow-sm">
          Season 02 (2025)
        </h1>
        <p class="font-mono text-sm sm:text-base text-zinc-200 max-w-3xl leading-relaxed">
          Held on 29 November 2025 at Varna Theatre, Mananthavady, in commemoration of Pazhassi Day. Organized jointly by Mananthavady Municipality, Pazhassi Raja Smaraka Granthalayam, and Drishtidosham Chalachithravedi.
        </p>
      </header>

      <!-- Key Festival Facts Table -->
      <section class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] overflow-hidden backdrop-blur-xs">
        <div class="p-6 border-b border-[#FDB813]/30 bg-[#5C0D07] text-[#FDB813]">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white font-mono">
            Festival Overview &amp; Key Milestones
          </h2>
        </div>
        <div class="divide-y divide-[#FDB813]/20 font-mono text-xs sm:text-sm">
          {festivalFacts.map((fact) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-1 hover:bg-[#5C0D07]/50 transition-colors">
              <span class="text-[#FDB813] uppercase tracking-wider font-semibold">{fact.label}</span>
              <span class="font-bold text-white sm:text-right">{fact.value}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Award Winners Roster -->
      <section class="space-y-8">
        <div class="border-b border-[#FDB813]/30 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono">
            Season 02 Award Laureates
          </h2>
          <span class="font-mono text-xs uppercase text-[#FDB813] font-bold">
            Jury &amp; Audience Verdict
          </span>
        </div>

        <div class="space-y-12">
          {winners.map((item) => (
            <article class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-6 sm:p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] space-y-6 backdrop-blur-xs">
              
              <!-- Winner Header -->
              <div class="border-b border-[#FDB813]/20 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
                <div>
                  <span class="font-mono text-xs font-black uppercase tracking-widest text-[#FDB813] block mb-1">
                    {item.category}
                  </span>
                  <h3 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono">
                    {item.film}
                  </h3>
                  <p class="font-mono text-sm font-bold text-zinc-200 mt-1">
                    {item.recipient}
                  </p>
                </div>

                <div class="font-mono text-right sm:text-right space-y-1">
                  <div class="text-base sm:text-lg font-black text-[#FDB813]">
                    {item.prize}
                  </div>
                  <div class="text-xs text-zinc-300">
                    {item.sponsor}
                  </div>
                </div>
              </div>

              <!-- Full-Fit Presentation Photos -->
              <div class={`grid gap-4 ${item.images.length > 1 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1'}`}>
                {item.images.map((img) => (
                  <div class="border border-[#FDB813]/30 rounded-lg h-[340px] sm:h-[420px] bg-[#5C0D07] p-2 flex items-center justify-center overflow-hidden shadow-inner">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-contain rounded"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Jury Special Mentions -->
      <section class="space-y-6 font-mono">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono">
            Jury Special Mentions
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {specialMentions.map((item, idx) => (
            <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-6 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] space-y-2 backdrop-blur-xs hover:border-[#FDB813] transition-colors">
              <span class="text-xs font-bold text-[#FDB813] block">0{idx + 1}</span>
              <h3 class="text-2xl font-black uppercase text-white tracking-tight font-mono">
                {item.title}
              </h3>
              <p class="text-xs text-zinc-300 uppercase">
                {item.type}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- On-Ground Festival Photography Grid -->
      <section class="space-y-6">
        <div class="border-b border-[#FDB813]/30 pb-3 flex items-baseline justify-between">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono">
            Festival Glimpses &amp; Public Screenings
          </h2>
          <span class="font-mono text-xs uppercase text-[#FDB813] font-bold">
            Varna Theatre Arena
          </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {seasonMoments.map((photo) => (
            <div class="border border-[#FDB813]/30 rounded-lg aspect-[4/3] bg-[#5C0D07] p-1.5 overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,0.3)]">
              <img
                src={photo.src}
                alt={photo.alt}
                class="w-full h-full object-cover rounded"
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>

      <!-- Dignitaries & Speakers Roster -->
      <section class="space-y-6">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono">
            Dignitaries &amp; Festival Leadership
          </h2>
        </div>

        <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-6 sm:p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] backdrop-blur-xs">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs sm:text-sm">
            {festivalDignitaries.map((person, idx) => (
              <div class="flex items-center gap-3 border-l-2 border-[#FDB813] pl-3 py-1 text-zinc-100">
                <span class="font-bold text-[#FDB813]">{idx + 1 < 10 ? `0${idx + 1}` : idx + 1}.</span>
                <span class="font-bold text-white">{person}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Navigation Link to Season 01 -->
      <div class="border-t border-[#FDB813]/30 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
        <a
          href="/seasons/01"
          class="inline-flex items-center gap-2 font-bold uppercase tracking-wider text-zinc-200 hover:text-[#FDB813] transition-colors"
        >
          <span>&larr; View Season 01 Archive (2024)</span>
        </a>

        <a
          href="/submit"
          class="inline-flex items-center gap-2 px-6 py-3 font-black uppercase tracking-widest text-[#B31D12] bg-[#FDB813] hover:bg-white rounded-lg shadow-[2px_2px_0px_0px_#000000] hover:-translate-y-0.5 transition-all cursor-pointer"
        >
          <span>Enter Season 03</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </div>
</Layout>