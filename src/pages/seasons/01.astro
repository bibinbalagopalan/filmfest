---
// src/pages/seasons/01.astro
import Layout from "../../layouts/Layout.astro";

const festivalFacts = [
  { label: "Edition", value: "Season 01 (2024)" },
  { label: "Date", value: "30 November 2024" },
  { label: "Location", value: "Veena-Varna Theatre, Mananthavady, Wayanad" },
  { label: "Jury Chairman", value: "Sanath PC" },
  { label: "Organizers", value: "Mananthavady Municipality, Pazhassi Raja Smaraka Granthalayam, Drishtidosham Chalachithravedi" },
];

const winners = [
  {
    category: "Best Short Film",
    film: "The Show",
    recipient: "Directed by Waseem Ameer",
    prize: "₹25,000 Cash Prize & Citation",
    images: [
      { src: "https://i.ibb.co/zVvD3TJt/Best-Film-The-Show-Waseem-Ameer.jpg", alt: "Waseem Ameer - Best Film Award for The Show" },
      { src: "https://i.ibb.co/Qv8265K3/Best-Film-THE-SHOW-Poster.jpg", alt: "The Show - Official Poster" },
    ],
  },
  {
    category: "Best Director",
    film: "Kolam",
    recipient: "Nandulal M",
    prize: "₹15,000 Cash Prize & Citation",
    images: [
      { src: "https://i.ibb.co/VWWMgr2z/Best-Director-Nandulal-M-S-Kolam.jpg", alt: "Nandulal M - Best Director for Kolam" },
      { src: "https://i.ibb.co/gFRwkMBz/Best-Director-KOLAM-Poster.jpg", alt: "Kolam - Official Poster" },
    ],
  },
  {
    category: "Best Popular Short Film",
    film: "Chudalamadan",
    recipient: "Directed by Atul Raj",
    prize: "₹10,000 Cash Prize & Citation",
    images: [
      { src: "https://i.ibb.co/sdk9byBD/Popular-Film-Chudalamadan.jpg", alt: "Atul Raj receiving Best Popular Short Film Award" },
      { src: "https://i.ibb.co/5W8FkDVp/Popular-Film-CHUDALAMADEN-Poster.png", alt: "Chudalamadan - Official Poster" },
    ],
  },
];
---

<Layout title="Season 01 Retrospective (2024) | PSFF">
  <div class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]">
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500">
          <a href="/" class="hover:text-[#D9381E] transition-colors">&larr; Back to Festival</a>
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Archives</span>
          <span>&bull;</span>
          <span>Inaugural Edition</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none">
          Season 01 (2024)
        </h1>
        <p class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed">
          The inaugural edition of the Pazhassi Short Film Festival was conducted on 30 November 2024 in Mananthavady in commemoration of Pazhassi Day, establishing a dedicated public platform for independent cinema in Wayanad.
        </p>
      </header>

      <!-- Key Festival Facts Table -->
      <section class="border-2 border-[#161616] bg-[#F6F4EE] shadow-[5px_5px_0px_0px_#161616]">
        <div class="p-6 border-b-2 border-[#161616] bg-[#161616] text-[#F6F4EE]">
          <h2 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white font-mono">
            Inaugural Edition Overview
          </h2>
        </div>
        <div class="divide-y border-zinc-300 font-mono text-xs sm:text-sm">
          {festivalFacts.map((fact) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <span class="text-zinc-500 uppercase tracking-wider font-semibold">{fact.label}</span>
              <span class="font-bold text-[#161616] sm:text-right">{fact.value}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Award Winners Roster -->
      <section class="space-y-8">
        <div class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
            Inaugural Award Laureates
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Season 01 Roll of Honor
          </span>
        </div>

        <div class="space-y-12">
          {winners.map((item) => (
            <article class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#161616] space-y-6">
              
              <!-- Winner Header -->
              <div class="border-b border-zinc-300 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
                <div>
                  <span class="font-mono text-xs font-black uppercase tracking-widest text-[#D9381E] block mb-1">
                    {item.category}
                  </span>
                  <h3 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
                    {item.film}
                  </h3>
                  <p class="font-mono text-sm font-bold text-zinc-800 mt-1">
                    {item.recipient}
                  </p>
                </div>

                <div class="font-mono sm:text-right">
                  <div class="text-base sm:text-lg font-black text-[#161616]">
                    {item.prize}
                  </div>
                </div>
              </div>

              <!-- Full-Fit Images Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {item.images.map((img) => (
                  <div class="border-2 border-[#161616] h-[340px] sm:h-[420px] bg-[#161616] p-2 flex items-center justify-center overflow-hidden">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-contain"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Navigation Routing -->
      <div class="border-t-2 border-[#161616] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
        <a
          href="/seasons/02"
          class="inline-flex items-center gap-2 font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          <span>View Season 02 Archive (2025) &rarr;</span>
        </a>

        <a
          href="/submit"
          class="inline-flex items-center gap-2 px-6 py-3 font-black uppercase tracking-widest text-[#F6F4EE] bg-[#161616] shadow-[3px_3px_0px_0px_#D9381E] hover:bg-[#D9381E] transition-all"
        >
          <span>Enter Season 03</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </div>
</Layout>