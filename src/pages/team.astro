---

<Layout title="Organizing Collective | PSFF Season 03">
  <div
    class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
  >
    <!-- Background Graph Grid, Swirls & Film Perforations -->
    <div
      class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden"
    >
      <!-- Top & Bottom Film Reel Border Patterns -->
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>

      <!-- Golden Graph Grid Overlay -->
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>

      <!-- Golden Traditional Line Art & Swirl Vectors -->
      <svg
        class="absolute -left-20 top-12 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8"></circle>
      </svg>
      <svg
        class="absolute -right-24 bottom-12 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6"></circle>
      </svg>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto space-y-12 sm:space-y-16">
      <!-- Masthead -->
      <header class="border-b border-[#FDB813]/30 pb-6 space-y-3">
        <div
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-zinc-200"
        >
          <a href="/" class="hover:text-[#FDB813] transition-colors"
            >&larr; Home</a
          >
          <span>/</span>
          <span class="text-[#FDB813] font-bold">Organizing Committee</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white font-mono drop-shadow-sm"
        >
          Festival Team
        </h1>
        <p
          class="font-mono text-xs sm:text-sm text-zinc-200 leading-relaxed max-w-3xl"
        >
          PSFF is built and executed collectively by local film enthusiasts,
          cultural workers, and volunteers working collaboratively across all
          departments.
        </p>
      </header>

      <!-- SECTION 1: Leadership -->
      <div class="space-y-8">
        <div class="border-b border-[#FDB813]/20 pb-3">
          <h2
            class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#FDB813] font-mono flex items-center gap-3"
          >
            Leadership
          </h2>
        </div>
        <section
          class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 font-mono"
        >
          {
            leadership
              .filter((m) => m.visible)
              .map((member) => (
                <article class="group relative rounded-xl bg-[#8B140B]/90 border border-[#FDB813]/40 hover:border-[#FDB813] transition-all duration-300 p-6 sm:p-8 flex flex-col justify-between shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] hover:shadow-[6px_6px_0px_0px_#FDB813] hover:-translate-y-1 backdrop-blur-xs">
                  <div class="space-y-4">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#5C0D07] text-[#FDB813] text-[10px] font-black uppercase tracking-wider rounded border border-[#FDB813]/30 shadow-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#FDB813]" />
                      <span>{member.role}</span>
                    </div>
                    <div class="space-y-1 pt-1">
                      <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono group-hover:text-[#FDB813] transition-colors">
                        {member.name}
                      </h3>
                    </div>
                  </div>
                  <div class="pt-5 mt-6 border-t border-[#FDB813]/20 flex items-center justify-between text-[11px] text-zinc-300">
                    <span class="uppercase tracking-widest text-[#FDB813] font-bold">
                      PSFF 2026
                    </span>
                    <span class="font-sans text-white group-hover:translate-x-1 transition-transform">
                      &rarr;
                    </span>
                  </div>
                </article>
              ))
          }
        </section>
      </div>

      <!-- SECTION 2: Pre-Selection Committee -->
      <div class="space-y-8 mt-16">
        <div class="border-b border-[#FDB813]/20 pb-3">
          <h2
            class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#FDB813] font-mono flex items-center gap-3"
          >
            Pre-selection Committee
          </h2>
        </div>
        <section
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 font-mono"
        >
          {
            preSelectionCommittee
              .filter((m) => m.visible)
              .map((member) => (
                <div class="group relative rounded-lg bg-[#8B140B]/60 border border-[#FDB813]/30 hover:border-[#FDB813] p-4 flex items-center gap-3 shadow-[2px_2px_0px_0px_rgba(0,0,0,0.35)] hover:shadow-[4px_4px_0px_0px_#FDB813] hover:-translate-y-0.5 transition-all duration-300 backdrop-blur-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FDB813]/50 group-hover:bg-[#FDB813] transition-colors" />
                  <span class="text-sm sm:text-base font-bold uppercase text-white group-hover:text-[#FDB813] transition-colors">
                    {member.name}
                  </span>
                </div>
              ))
          }
        </section>
      </div>

      <!-- SECTION 3: Festival Operations & Team -->
      <div class="space-y-8 mt-16">
        <div class="border-b border-[#FDB813]/20 pb-3">
          <h2
            class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#FDB813] font-mono flex items-center gap-3"
          >
            Festival Operations & Team
          </h2>
        </div>
        <section
          class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 font-mono"
        >
          {
            operationsTeam
              .filter((m) => m.visible)
              .map((member) => (
                <article class="group relative rounded-xl bg-[#8B140B]/90 border border-[#FDB813]/40 hover:border-[#FDB813] transition-all duration-300 p-6 sm:p-8 flex flex-col justify-between shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] hover:shadow-[6px_6px_0px_0px_#FDB813] hover:-translate-y-1 backdrop-blur-xs">
                  <div class="space-y-4">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#5C0D07] text-[#FDB813] text-[10px] font-black uppercase tracking-wider rounded border border-[#FDB813]/30 shadow-xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#FDB813]" />
                      <span>{member.role}</span>
                    </div>
                    <div class="space-y-1 pt-1">
                      <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono group-hover:text-[#FDB813] transition-colors">
                        {member.name}
                      </h3>
                    </div>
                  </div>
                  <div class="pt-5 mt-6 border-t border-[#FDB813]/20 flex items-center justify-between text-[11px] text-zinc-300">
                    <span class="uppercase tracking-widest text-[#FDB813] font-bold">
                      PSFF 2026
                    </span>
                    <span class="font-sans text-white group-hover:translate-x-1 transition-transform">
                      &rarr;
                    </span>
                  </div>
                </article>
              ))
          }
        </section>
      </div>
    </div>
  </div>
</Layout>
