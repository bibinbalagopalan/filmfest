---
// src/pages/team.astro
import Layout from "../layouts/Layout.astro";

const directorate = [
  { role: "Festival Director", name: "Sunith KP" },
  { role: "Festival Convenor", name: "Bibin Balagopal, Vishnu K" },
];
---

<Layout title="Organizing Collective | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-12 sm:py-20 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-5xl mx-auto space-y-12 sm:space-y-16">
      <!-- Masthead -->
      <header class="border-b-2 border-[#161616] pb-6 space-y-3">
        <div
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          >
          <span>/</span>
          <span>Organizing Committee</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#161616]"
        >
          Festival Team
        </h1>
        <p
          class="font-mono text-xs sm:text-sm text-zinc-700 leading-relaxed max-w-3xl"
        >
          PSFF is built and executed collectively by local film enthusiasts,
          cultural workers, and volunteers working collaboratively across all
          departments.
        </p>
      </header>

      <!-- Table 1: Core Coordination -->
      <section class="space-y-3 font-mono text-xs">
        <div
          class="border-2 border-[#161616] bg-white shadow-[4px_4px_0px_0px_#161616] overflow-x-auto"
        >
          <table class="w-full text-left border-collapse">
            <thead>
              <tr
                class="bg-[#161616] text-[#F6F4EE] uppercase tracking-wider text-[10px] border-b-2 border-[#161616]"
              >
                <th class="p-3.5 border-r border-zinc-700 w-1/3 sm:w-1/4"
                  >Role / Body</th
                >
                <th class="p-3.5">Members &amp; Key Coordinators</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-[#161616]">
              {
                directorate.map((item) => (
                  <tr class="hover:bg-[#F6F4EE] transition-colors">
                    <td class="p-3.5 border-r-2 border-[#161616] font-bold text-zinc-600 uppercase text-[11px] bg-[#F6F4EE]/40">
                      {item.role}
                    </td>
                    <td class="p-3.5 font-black text-sm sm:text-base text-[#161616] uppercase tracking-tight">
                      {item.name}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>
