---
// src/pages/team.astro
import Layout from "../layouts/Layout.astro";

const directorate = [
  { role: "Festival Director", name: "Sunith KP" },
  { role: "Festival Convenor", name: "Bibin Balagopal" },
  { role: "General Committee", name: "Sunith KP, Bibin Balagopal, Vishnu K" },
];

const workingTeams = [
  {
    area: "Programme & Registration",
    convenor: "A. Ajaykumar",
    team: "Convenors of all Committees, Vishnu V, Athira",
  },
  {
    area: "Finance & Accounts",
    convenor: "Thomas Sevior",
    team: "Prasad VK, Shajan Jose",
  },
  {
    area: "Publicity & Venue Decor",
    convenor: "Latheesh Prabhakar",
    team: "Manoj, Aji Colonia",
  },
  {
    area: "Stage & Infrastructure",
    convenor: "Fr. Jomon",
    team: "Jithin MC",
  },
  {
    area: "Guest Reception & Hospitality",
    convenor: "Dr. Mridulal",
    team: "Shabitha Teacher, Neethu Vincent, Laya Latheesh, Vijisha, Ayoob",
  },
  {
    area: "Food & Catering",
    convenor: "Jayaprakash",
    team: "Amal Prashanth, Anurag VM, Anu Vinod SJ, Abhilash, Rajesh Kambetty",
  },
  {
    area: "Trophies & Mementos",
    convenor: "Sooraj H",
    team: "Jishnu Karunakara, Swetha, Saritha Jacob, Nazar",
  },
];
---

<Layout title="Organizing Collective | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-12 sm:py-20 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-5xl mx-auto space-y-12 sm:space-y-16">
      <!-- Masthead -->
      <header class="border-b-2 border-[#161616] pb-6 space-y-3">
        <div
          class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          >
          <span>/</span>
          <span>Organizing Committee</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#161616]"
        >
          Festival Team
        </h1>
        <p
          class="font-mono text-xs sm:text-sm text-zinc-700 leading-relaxed max-w-3xl"
        >
          PSFF is built and executed collectively by local film enthusiasts,
          cultural workers, and volunteers working collaboratively across all
          departments.
        </p>
      </header>

      <!-- Table 1: Core Coordination -->
      <section class="space-y-3 font-mono text-xs">
        <div
          class="flex items-center gap-2 text-[#D9381E] font-bold uppercase tracking-wider text-[11px] pb-1"
        >
          <span>01</span>
          <span>&bull;</span>
          <span>Core Coordination &amp; Directorate</span>
        </div>

        <div
          class="border-2 border-[#161616] bg-white shadow-[4px_4px_0px_0px_#161616] overflow-x-auto"
        >
          <table class="w-full text-left border-collapse">
            <thead>
              <tr
                class="bg-[#161616] text-[#F6F4EE] uppercase tracking-wider text-[10px] border-b-2 border-[#161616]"
              >
                <th class="p-3.5 border-r border-zinc-700 w-1/3 sm:w-1/4"
                  >Role / Body</th
                >
                <th class="p-3.5">Members &amp; Key Coordinators</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-[#161616]">
              {
                directorate.map((item) => (
                  <tr class="hover:bg-[#F6F4EE] transition-colors">
                    <td class="p-3.5 border-r-2 border-[#161616] font-bold text-zinc-600 uppercase text-[11px] bg-[#F6F4EE]/40">
                      {item.role}
                    </td>
                    <td class="p-3.5 font-black text-sm sm:text-base text-[#161616] uppercase tracking-tight">
                      {item.name}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Table 2: Working Committees -->
      <section class="space-y-3 font-mono text-xs">
        <div
          class="flex items-center gap-2 text-[#D9381E] font-bold uppercase tracking-wider text-[11px] pb-1"
        >
          <span>02</span>
          <span>&bull;</span>
          <span>Departmental Responsibilities &amp; Teams</span>
        </div>

        <div
          class="border-2 border-[#161616] bg-white shadow-[4px_4px_0px_0px_#161616] overflow-x-auto"
        >
          <table class="w-full text-left border-collapse">
            <thead>
              <tr
                class="bg-[#161616] text-[#F6F4EE] uppercase tracking-wider text-[10px] border-b-2 border-[#161616]"
              >
                <th class="p-3.5 border-r border-zinc-700 w-12 text-center"
                  >#</th
                >
                <th class="p-3.5 border-r border-zinc-700 sm:w-1/4"
                  >Department</th
                >
                <th class="p-3.5 border-r border-zinc-700 sm:w-1/4">Convenor</th
                >
                <th class="p-3.5">Team Members</th>
              </tr>
            </thead>
            <tbody class="divide-y-2 divide-[#161616]">
              {
                workingTeams.map((team, idx) => (
                  <tr class="hover:bg-[#F6F4EE] transition-colors">
                    <td class="p-3.5 border-r-2 border-[#161616] font-bold text-[#D9381E] text-center text-[11px] bg-[#F6F4EE]/40">
                      {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}
                    </td>
                    <td class="p-3.5 border-r-2 border-[#161616] font-black uppercase text-[#161616] tracking-tight">
                      {team.area}
                    </td>
                    <td class="p-3.5 border-r-2 border-[#161616] font-black uppercase text-[#D9381E]">
                      {team.convenor}
                    </td>
                    <td class="p-3.5 font-bold text-zinc-800 leading-relaxed text-[11px]">
                      {team.team}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>
