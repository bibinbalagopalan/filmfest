  { role: "Festival Director", name: "Sunith KP", visible: true },
  { role: "Festival Patron", name: "Sanath PC", visible: true },
  { role: "Festival Producer", name: "Arun EV", visible: true },
  { role: "Curation Lead", name: "Ajayakumar A", visible: true },
  { role: "Curator Emeritus", name: "Shajan Jose", visible: true },
  { role: "Finance Lead / Treasurer", name: "Prasad VK", visible: true },
  {
    role: "Sponsorship & Partnerships Lead",
    name: "Thomas Saviour",
    visible: true,
  },
  {
    role: "President of the Advisory Board",
    name: "Neethu Vincent",
    visible: true,
  },
];

const operationsTeam = [
  { role: "Technical Director", name: "Bibin M", visible: true },
  {
    role: "Master QC (Quality Control) & Digital Ingestion",
    name: "",
    visible: false,
  },
  {
    role: "Filmmaker & VIP Hospitality Coordinator",
    name: "Vinod Kumar SJ",
    visible: true,
  },
  {
    role: "Front of House (FOH) & Audience Flow Lead",
    name: "",
    visible: false,
  },
  { role: "Stage Manager", name: "Jithin MC", visible: true },
  { role: "Emcee", name: "", visible: false },
  { role: "Submissions Coordinator", name: "Vishnu K", visible: true },
  { role: "Volunteer Coordinator", name: "Vijisha Vijayakumar", visible: true },
  { role: "Marketing & Campaigns Lead", name: "Arun VV", visible: true },
  {
    role: "Content & Social Media Manager",
    name: "Dhanush Krishna",
    visible: true,
  },
  { role: "Visual Designer & Branding Lead", name: "", visible: false },
  { role: "Event Photographer / Videographer", name: "", visible: false },
];

// Pre-selection committee members are listed in exact required order
const preSelectionCommittee = [
  { name: "Sunith KP", visible: true },
  { name: "Arun EV", visible: true },
  { name: "A Ajayakumar", visible: true },
  { name: "Dr. Mridulal", visible: true },
  { name: "Vinod Kumar SJ", visible: true },
  { name: "Bibin M", visible: true },
  { name: "Thomas Saviour", visible: true },
  { name: "Latheesh Prabhakar", visible: true },
  { name: "Sooraj H", visible: true },
  { name: "Rajesh Kambatty", visible: true },
  { name: "Rajeesh", visible: true },
  { name: "Vishnu K", visible: true },
