---
// src/pages/team.astro
import Layout from "../layouts/Layout.astro";

// Core Festival Directorate
const festivalDirectorate = [
  {
    role: "Festival Director",
    names: ["Sunith KP"],
  },
  {
    role: "Festival Convenors",
    names: ["Bibin Balagopal", "Vishnu K"],
  },
];

// General Committee
const generalCommittee = ["Sunith KP", "Bibin Balagopal", "Vishnu K"];

// Working Committees
const committees = [
  {
    name: "Programme & Registration Committee",
    convenor: "A. Ajaykumar",
    members: ["Convenors of all Committees"],
    subCommittee: {
      name: "Registration Committee",
      members: ["Vishnu Vava", "Athira"],
    },
  },
  {
    name: "Finance Committee",
    convenor: "Thomas Sevior",
    members: ["Prasad VK", "Shajan Jose"],
  },
  {
    name: "Publicity & Decoration Committee",
    convenor: "Latheesh Prabhakar",
    members: ["Manoj", "Aji Colonia"],
  },
  {
    name: "Stage Committee",
    convenor: "Fr. Jomon",
    members: ["Jithin MC"],
  },
  {
    name: "Reception Committee",
    convenor: "Dr. Mridulal",
    members: [
      "Shabitha Teacher",
      "Neethu Vincent",
      "Laya Latheesh",
      "Vijisha",
      "Ayoob",
    ],
  },
  {
    name: "Food Committee",
    convenor: "Jayaprakash",
    members: [
      "Amal Prashanth",
      "Anurag VM",
      "Anu Vinod SJ",
      "Abhilash",
      "Rajesh Kambetty",
    ],
  },
  {
    name: "Trophy Committee",
    convenor: "Sooraj H",
    members: [
      "Jishnu Karunakara",
      "Swetha",
      "Saritha Jacob",
      "Nazar (Naachi)",
    ],
  },
];
---

<Layout title="Organizing Team & Committees | PSFF Season 03">
  <div class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]">
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Editorial Page Masthead -->
      <header class="border-b-2 border-zinc-950 pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500">
          <a href="/" class="hover:text-[#D9381E] transition-colors">&larr; Back to Festival</a>
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Organization</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none">
          Festival Team
        </h1>
        <p class="font-serif text-lg sm:text-2xl text-zinc-800 max-w-3xl leading-relaxed">
          The organizing collective, directorate, and working committees behind the 3rd Pazhassi Short Film Festival 2026.
        </p>
      </header>

      <!-- Section 1: Executive Directorate -->
      <section class="space-y-6">
        <div class="border-b-2 border-zinc-950 pb-2">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E]">
            Executive Directorate
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {festivalDirectorate.map((leader) => (
            <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#161616] space-y-4">
              <span class="inline-block font-mono text-xs uppercase tracking-wider bg-[#161616] text-[#F6F4EE] px-3 py-1 font-bold">
                {leader.role}
              </span>
              <div class="space-y-2 pt-2 border-t border-zinc-300">
                {leader.names.map((name, idx) => (
                  <div class="flex items-baseline gap-3">
                    {leader.names.length > 1 && (
                      <span class="font-mono text-sm font-bold text-[#D9381E]">
                        {idx + 1}.
                      </span>
                    )}
                    <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#161616]">
                      {name}
                    </h2>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: General Steering Committee -->
      <section class="space-y-6">
        <div class="border-b-2 border-zinc-950 pb-2">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E]">
            General Committee
          </span>
        </div>

        <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#161616]">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 font-mono">
            {generalCommittee.map((member, idx) => (
              <div class="flex items-center gap-3.5 border-l-4 border-[#161616] pl-4 py-2 bg-white/60">
                <span class="text-sm font-black text-[#D9381E]">0{idx + 1}</span>
                <span class="text-lg sm:text-xl font-black uppercase text-[#161616] tracking-tight">
                  {member}
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Section 3: Working & Execution Committees -->
      <section class="space-y-8">
        <div class="border-b-2 border-zinc-950 pb-2 flex items-baseline justify-between">
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E]">
            Working Committees &amp; Convenors
          </span>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Season 03 Roster
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
          {committees.map((comm) => (
            <article class="border-2 border-[#161616] bg-[#F6F4EE] p-6 flex flex-col justify-between shadow-[5px_5px_0px_0px_#161616] space-y-6">
              
              <div class="space-y-5">
                <!-- Committee Name -->
                <div class="border-b-2 border-zinc-950 pb-3">
                  <h3 class="text-xl font-black uppercase tracking-tight text-[#161616] leading-tight">
                    {comm.name}
                  </h3>
                </div>

                <!-- Convenor Highlight -->
                {comm.convenor && (
                  <div class="bg-[#161616] text-[#F6F4EE] p-3.5 space-y-1">
                    <span class="block font-mono text-[11px] uppercase tracking-widest text-[#D9381E] font-bold">
                      Convenor
                    </span>
                    <p class="font-mono text-base sm:text-lg font-black tracking-tight text-white uppercase">
                      {comm.convenor}
                    </p>
                  </div>
                )}

                <!-- Committee Members List -->
                <div class="space-y-3 pt-1">
                  <span class="block font-mono text-xs uppercase tracking-wider text-zinc-500 font-bold">
                    Committee Members
                  </span>
                  <div class="space-y-2">
                    {comm.members.map((member, idx) => (
                      <div class="flex items-start gap-2.5 font-mono text-sm">
                        <span class="font-bold text-[#D9381E] text-xs mt-0.5">{idx + 1}.</span>
                        <span class="font-bold text-[#161616] leading-snug">{member}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Nested Sub-Committee -->
                {comm.subCommittee && (
                  <div class="border-t-2 border-dashed border-zinc-400 pt-4 mt-4 space-y-3">
                    <span class="block font-mono text-[11px] uppercase tracking-widest text-[#D9381E] font-bold">
                      {comm.subCommittee.name}
                    </span>
                    <div class="space-y-2">
                      {comm.subCommittee.members.map((sm, idx) => (
                        <div class="flex items-center gap-2.5 font-mono text-sm">
                          <span class="font-bold text-zinc-500 text-xs">{idx + 1}.</span>
                          <span class="font-bold text-[#161616]">{sm}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <!-- Bottom Tag -->
              <div class="pt-4 border-t border-zinc-300">
                <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 block font-semibold">
                  PSFF 2026 Operating Committee
                </span>
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Institutional Footnote -->
      <div class="border-t-2 border-zinc-950 pt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs text-zinc-600">
        <p>
          Organized by <strong class="text-[#161616]">Drishtidosham Chalachithravedi</strong> &amp; <strong class="text-[#161616]">Pazhassi Raja Smaraka Granthalayam</strong>.
        </p>
        <a href="/contact" class="font-bold uppercase tracking-wider text-[#D9381E] hover:text-[#161616] underline underline-offset-4 transition-colors">
          Contact Directorate &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>