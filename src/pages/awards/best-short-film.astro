---
// src/pages/awards/best-short-film.astro
import Layout from "../../layouts/Layout.astro";

const criteria = [
  {
    title: "Concept / Premise",
    points: "10",
    desc: "Strength, clarity, and depth of the core premise.",
  },
  {
    title: "Originality",
    points: "10",
    desc: "Freshness of perspective and unique cinematic voice.",
  },
  {
    title: "Screenplay / Structure",
    points: "15",
    desc: "Dialogue, scene transitions, and narrative economy.",
  },
  {
    title: "Direction",
    points: "15",
    desc: "Directorial vision, control of tone, and execution.",
  },
  {
    title: "Characterization & Performances",
    points: "10",
    desc: "Authenticity, emotional nuance, casting, and acting.",
  },
  {
    title: "Cinematography / Visual Language",
    points: "10",
    desc: "Framing, lighting, camera movement, and visual mood.",
  },
  {
    title: "Editing / Pacing",
    points: "10",
    desc: "Rhythm, temporal flow, and dramatic cuts.",
  },
  {
    title: "Sound Design / Sound Recording",
    points: "8",
    desc: "Atmosphere, dialogue clarity, foley, and sound mixing.",
  },
  {
    title: "Production Design / Locations / Costume",
    points: "4",
    desc: "Sets, location realism, props, and costume design.",
  },
  {
    title: "Music / Background Score",
    points: "3",
    desc: "Original composition, atmosphere, and emotional integration.",
  },
  {
    title: "Thematic Depth / Social Insight",
    points: "5",
    desc: "Social resonance, philosophical depth, and human insight.",
  },
  {
    title: "Emotional / Intellectual Impact",
    points: "10",
    desc: "Lasting impression, cinematic punch, and memorability.",
  },
];

const winners = [
  {
    season: "Season 02 (2025)",
    film: "Kanam",
    director: "Mridul S",
    dop: "Anil Babu",
    images: [
      { src: "https://i.ibb.co/YTKSmkLj/Best-Film.jpg", alt: "Kanam winning Best Film" },
      { src: "https://i.ibb.co/4g9Y6xp5/10.jpg", alt: "Kanam team at the festival" },
    ],
  },
  {
    season: "Season 01 (2024)",
    film: "The Show",
    director: "Waseem Ameer",
    dop: null,
    images: [
      { src: "https://i.ibb.co/zVvD3TJt/Best-Film-The-Show-Waseem-Ameer.jpg", alt: "Waseem Ameer with the award" },
      { src: "https://i.ibb.co/Qv8265K3/Best-Film-THE-SHOW-Poster.jpg", alt: "The Show poster" },
    ],
  },
];
---

<Layout title="Best Short Film | PSFF Season 03">
  <div class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden">
    
    <!-- Background Graph Grid, Swirls & Film Perforations -->
    <div class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden">
      <!-- Top & Bottom Film Reel Border Patterns -->
      <div 
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>
      <div 
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>

      <!-- Golden Graph Grid Overlay -->
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      ></div>

      <!-- Golden Traditional Line Art & Swirl Vectors -->
      <svg class="absolute -left-20 top-20 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8" />
      </svg>
      <svg class="absolute -right-24 bottom-24 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6" />
      </svg>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Header -->
      <header class="border-b border-[#FDB813]/30 pb-8 space-y-3">
        <div class="font-mono text-xs uppercase tracking-wider text-zinc-200">
          <a href="/" class="hover:text-[#FDB813] transition-colors">&larr; Home</a> / Awards
        </div>
        <h1 class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white font-mono drop-shadow-sm">
          Best Short Film
        </h1>
        <p class="font-mono text-sm sm:text-base text-[#FDB813] font-bold">
          Selected by the official jury based on the 12-criterion scoring rubric.
        </p>
      </header>

      <!-- Prize Summary -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] space-y-2 backdrop-blur-xs">
          <span class="font-mono text-xs uppercase tracking-wider text-[#FDB813] font-bold block">
            Cash Award
          </span>
          <p class="text-5xl sm:text-6xl font-black text-white font-mono">
            ₹25,000
          </p>
        </div>

        <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] space-y-2 flex flex-col justify-center backdrop-blur-xs">
          <span class="font-mono text-xs uppercase tracking-wider text-[#FDB813] font-bold block">
            Award Includes
          </span>
          <p class="text-2xl sm:text-3xl font-black uppercase text-white font-mono">
            Trophy + Official Citation
          </p>
        </div>
      </section>

      <!-- Scoring Rubrics -->
      <section class="space-y-6">
        <div class="border-b border-[#FDB813]/30 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono">
            Jury Scoring Rubric (100 Marks)
          </h2>
          <span class="font-mono text-xs font-bold uppercase text-[#FDB813]">
            Comprehensive Criterion Breakdown
          </span>
        </div>

        <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl divide-y divide-[#FDB813]/20 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] overflow-hidden backdrop-blur-xs font-mono">
          {criteria.map((item, idx) => (
            <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-[#5C0D07]/50 transition-colors">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <span class="text-xs font-bold text-[#FDB813]">
                    {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}.
                  </span>
                  <h3 class="text-base sm:text-lg font-black uppercase text-white font-mono">
                    {item.title}
                  </h3>
                </div>
                <p class="text-xs sm:text-sm text-zinc-200 font-sans pl-6">
                  {item.desc}
                </p>
              </div>

              <div class="pl-6 sm:pl-0 text-right flex sm:flex-col items-baseline justify-between shrink-0">
                <span class="text-2xl sm:text-3xl font-black text-[#FDB813]">
                  {item.points}
                </span>
                <span class="text-[10px] text-zinc-300 uppercase font-bold">
                  Max Marks
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Previous Winners -->
      <section class="space-y-8">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono">
            Previous Winners
          </h2>
        </div>

        <div class="space-y-10">
          {winners.map((item) => (
            <article class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-xl p-6 sm:p-8 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] space-y-6 backdrop-blur-xs">
              
              <!-- Header -->
              <div class="border-b border-[#FDB813]/20 pb-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                <div>
                  <span class="font-mono text-xs font-bold uppercase text-[#FDB813] block mb-1">
                    {item.season}
                  </span>
                  <h3 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono">
                    {item.film}
                  </h3>
                </div>

                <div class="font-mono text-sm text-zinc-200 space-y-1">
                  <div>
                    <span class="text-zinc-400 uppercase text-xs">Director:</span>{" "}
                    <strong class="text-white">{item.director}</strong>
                  </div>
                  {item.dop && (
                    <div>
                      <span class="text-zinc-400 uppercase text-xs">DoP:</span>{" "}
                      <strong class="text-white">{item.dop}</strong>
                    </div>
                  )}
                </div>
              </div>

              <!-- Photos -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {item.images.map((img) => (
                  <div class="border border-[#FDB813]/30 rounded-lg aspect-[4/3] bg-[#5C0D07] overflow-hidden shadow-inner flex items-center justify-center p-1.5">
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-contain rounded"
                      loading="lazy"
                    />
                  </div>
                ))}
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Submission CTA -->
      <div class="border-2 border-black bg-[#8B140B] text-[#FDFCF7] p-8 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-[6px_6px_0px_0px_#000000] font-mono">
        <div>
          <h3 class="text-xl sm:text-2xl font-black uppercase text-white font-mono">
            Submit for Season 03
          </h3>
          <p class="font-mono text-xs text-zinc-200 mt-1">
            Films completed between Sep 2023 and Aug 2026. Runtime under 30 minutes.
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3 text-xs font-mono font-black uppercase tracking-wider text-[#B31D12] bg-[#FDB813] hover:bg-white rounded-lg transition-all shadow-[2px_2px_0px_0px_#000000] hover:-translate-y-0.5 cursor-pointer"
        >
          Submit Film &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>