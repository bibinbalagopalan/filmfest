---
// src/pages/juries.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Jury Screening Room | PSFF Season 03">
  <!-- Scoped CSS: Hide public navbar & footer for focused workspace -->
  <style is:global>
    header:not(#jury-top-bar),
    nav,
    footer {
      display: none !important;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f0f0f;
    }
    ::-webkit-scrollbar-thumb {
      background: #333333;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #555555;
    }
  </style>

  <div
    class="w-full min-h-screen bg-[#0F0F0F] text-[#F1F1F1] font-sans antialiased selection:bg-[#D9381E] selection:text-white"
  >
    <!-- 1. LOGIN SCREEN -->
    <div
      id="auth-guard"
      class="min-h-screen flex items-center justify-center p-4 sm:p-6"
    >
      <div
        class="w-full max-w-md bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6"
      >
        <div class="text-center space-y-3">
          <div class="inline-flex items-center gap-2.5 justify-center">
            <span
              class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono"
            >
              PSFF
            </span>
            <span
              class="inline-flex items-center justify-center font-mono text-xs font-black uppercase tracking-wider text-white bg-[#D9381E] px-2.5 py-1 border border-[#D9381E] shadow-[2px_2px_0px_0px_#000000]"
            >
              Season 03
            </span>
          </div>
          <h1 class="text-base sm:text-lg font-bold text-white pt-1">
            Jury Screening Portal
          </h1>
          <p class="text-xs text-zinc-400 font-mono">
            Sign in with authorized juror credentials to begin evaluation.
          </p>
        </div>

        <form id="jury-login-form" class="space-y-4 text-xs font-mono">
          <div class="space-y-1.5">
            <label
              class="block font-bold text-zinc-400 uppercase tracking-wider"
              >Email Address</label
            >
            <input
              type="email"
              id="jury-email"
              required
              class="w-full bg-[#121212] border border-[#3A3A3A] rounded-lg p-3 text-sm text-white focus:outline-none focus:border-[#D9381E] transition-colors"
              placeholder="jury@psff.in"
            />
          </div>

          <div class="space-y-1.5">
            <label
              class="block font-bold text-zinc-400 uppercase tracking-wider"
              >Password</label
            >
            <input
              type="password"
              id="jury-pwd"
              required
              class="w-full bg-[#121212] border border-[#3A3A3A] rounded-lg p-3 text-sm text-white focus:outline-none focus:border-[#D9381E] transition-colors"
              placeholder="••••••••"
            />
          </div>

          <div
            id="auth-err"
            class="hidden p-3 bg-red-950/80 border border-red-800 rounded-lg text-red-300 text-xs font-bold font-mono"
          >
          </div>

          <button
            type="submit"
            id="jury-auth-btn"
            class="w-full py-3.5 bg-[#D9381E] hover:bg-[#b82d16] text-white font-bold rounded-lg text-xs uppercase tracking-wider transition-colors cursor-pointer shadow-lg"
          >
            Enter Screening Room &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- 2. MAIN WORKSPACE -->
    <div id="jury-workspace" class="hidden min-h-screen flex flex-col">
      <!-- Top App Bar -->
      <header
        id="jury-top-bar"
        class="sticky top-0 z-50 bg-[#0F0F0F] border-b border-[#272727] px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2 sm:gap-4"
      >
        <div class="flex items-center gap-2 sm:gap-4 shrink-0">
          <button
            type="button"
            id="nav-home-btn"
            class="flex items-center gap-2.5 text-white hover:opacity-90 focus:outline-none cursor-pointer"
            title="Return to Films Queue"
          >
            <span
              class="text-xl sm:text-2xl font-black uppercase tracking-tight text-white font-mono"
            >
              PSFF
            </span>
            <span
              class="inline-flex items-center justify-center font-mono text-[10px] sm:text-xs font-black uppercase tracking-wider text-white bg-[#D9381E] px-2 py-0.5 border border-[#D9381E] shadow-[2px_2px_0px_0px_#000000]"
            >
              Season 03
            </span>
          </button>
        </div>

        <div class="flex-1 max-w-xl mx-2">
          <div class="relative w-full">
            <input
              type="text"
              id="top-search-bar"
              placeholder="Search films, directors, genres, IDs..."
              class="w-full bg-[#121212] border border-[#303030] rounded-full py-1.5 sm:py-2 pl-9 pr-4 text-xs sm:text-sm text-white focus:outline-none focus:border-[#D9381E] transition-all placeholder:text-zinc-500 font-mono"
            />
            <svg
              class="w-4 h-4 text-zinc-400 absolute left-3 top-1/2 -translate-y-1/2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <div
          class="flex items-center gap-2 sm:gap-3 shrink-0 font-mono text-xs"
        >
          <div
            class="hidden md:flex items-center gap-2 bg-[#272727] px-3 py-1.5 rounded-full border border-zinc-700"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
            ></span>
            <span
              id="juror-name-badge"
              class="font-bold text-zinc-200 truncate max-w-[120px]">Juror</span
            >
          </div>

          <button
            type="button"
            id="jury-signout-btn"
            class="px-3 py-1.5 bg-[#272727] hover:bg-[#3F3F3F] text-zinc-200 hover:text-white rounded-full text-[11px] font-bold transition-colors cursor-pointer border border-zinc-700"
          >
            Sign Out
          </button>
        </div>
      </header>

      <!-- VIEW 1: HOME & MOVIE TABLE -->
      <main
        id="home-view"
        class="flex-1 max-w-7xl mx-auto w-full p-4 sm:p-6 space-y-6"
      >
        <div class="grid grid-cols-3 gap-2 sm:gap-4 font-mono">
          <div
            class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-3 sm:p-4 text-center"
          >
            <span
              class="text-[9px] sm:text-xs text-zinc-400 uppercase font-bold block"
              >Assigned</span
            >
            <span
              id="stat-total-assigned"
              class="text-lg sm:text-2xl font-black text-white">0</span
            >
          </div>
          <div
            class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-3 sm:p-4 text-center"
          >
            <span
              class="text-[9px] sm:text-xs text-emerald-400 uppercase font-bold block"
              >Completed</span
            >
            <span
              id="stat-completed"
              class="text-lg sm:text-2xl font-black text-emerald-400">0</span
            >
          </div>
          <div
            class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-3 sm:p-4 text-center"
          >
            <span
              class="text-[9px] sm:text-xs text-amber-400 uppercase font-bold block"
              >Pending</span
            >
            <span
              id="stat-pending"
              class="text-lg sm:text-2xl font-black text-amber-400">0</span
            >
          </div>
        </div>

        <div
          class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-mono font-bold"
        >
          <button
            type="button"
            data-filter="ALL"
            class="filter-chip px-4 py-1.5 rounded-lg bg-white text-black shrink-0 transition-colors"
          >
            All Films
          </button>
          <button
            type="button"
            data-filter="Pending"
            class="filter-chip px-4 py-1.5 rounded-lg bg-[#272727] text-zinc-300 hover:bg-[#3F3F3F] shrink-0 transition-colors"
          >
            Yet to Start
          </button>
          <button
            type="button"
            data-filter="In Progress"
            class="filter-chip px-4 py-1.5 rounded-lg bg-[#272727] text-zinc-300 hover:bg-[#3F3F3F] shrink-0 transition-colors"
          >
            In Progress
          </button>
          <button
            type="button"
            data-filter="Completed"
            class="filter-chip px-4 py-1.5 rounded-lg bg-[#272727] text-zinc-300 hover:bg-[#3F3F3F] shrink-0 transition-colors"
          >
            Completed 🔒
          </button>
        </div>

        <div
          class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl overflow-hidden shadow-xl"
        >
          <div
            class="p-3 sm:p-4 border-b border-[#2E2E2E] flex items-center justify-between"
          >
            <h2
              class="text-xs sm:text-sm font-bold uppercase tracking-wider text-zinc-300 font-mono"
            >
              Competition Film Queue
            </h2>
            <span id="results-count" class="text-xs text-zinc-500 font-mono"
              >0 Films</span
            >
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr
                  class="bg-[#121212] text-zinc-400 uppercase tracking-wider text-[10px] font-mono border-b border-[#2E2E2E]"
                >
                  <th class="p-3 sm:p-3.5 border-r border-[#2E2E2E] w-24"
                    >Entry ID</th
                  >
                  <th class="p-3 sm:p-3.5 border-r border-[#2E2E2E]"
                    >Film Title &amp; Genre</th
                  >
                  <th
                    class="p-3 sm:p-3.5 border-r border-[#2E2E2E] hidden sm:table-cell"
                    >Director</th
                  >
                  <th
                    class="p-3 sm:p-3.5 border-r border-[#2E2E2E] hidden md:table-cell"
                    >Duration</th
                  >
                  <th class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-center"
                    >Status</th
                  >
                  <th class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-center"
                    >Score</th
                  >
                  <th class="p-3 sm:p-3.5 text-center w-28">Screening</th>
                </tr>
              </thead>
              <tbody
                id="home-movies-tbody"
                class="divide-y divide-[#2E2E2E] font-mono"
              >
                <tr>
                  <td
                    colspan="7"
                    class="p-8 text-center text-zinc-500 font-bold"
                  >
                    Loading competition films...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </main>

      <!-- VIEW 2: SCREENING & MARKING ROOM -->
      <main
        id="player-view"
        class="hidden flex-1 max-w-5xl mx-auto w-full p-2 sm:p-6 space-y-4"
      >
        <div>
          <button
            type="button"
            id="player-back-btn"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#272727] hover:bg-[#3F3F3F] text-xs font-mono font-bold text-white transition-colors cursor-pointer border border-zinc-700"
          >
            <span>&larr;</span> Back to Films List
          </button>
        </div>

        <!-- 1. Video Player Container -->
        <div
          class="w-full bg-black rounded-xl sm:rounded-2xl overflow-hidden aspect-video border border-[#2E2E2E] shadow-2xl relative flex items-center justify-center"
        >
          <div id="player-placeholder" class="text-center p-6 space-y-2">
            <span class="text-zinc-600 text-4xl block">▶</span>
            <p class="text-xs text-zinc-400 font-mono">
              Loading film video stream...
            </p>
          </div>
          <iframe
            id="video-frame"
            class="hidden w-full h-full"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- 2. Film Heading & Collapsible Details Section -->
        <div
          class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 space-y-3"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <h1
                id="screen-film-title"
                class="text-lg sm:text-2xl font-black text-white uppercase tracking-tight"
              >
                Film Title
              </h1>
              <span
                id="screen-film-language-runtime"
                class="text-xs font-mono text-zinc-400 block mt-0.5"
              >
                Malayalam &bull; 15 Mins
              </span>
            </div>

            <!-- Toggle Details Accordion Button -->
            <button
              type="button"
              id="toggle-details-btn"
              class="px-3 py-1.5 bg-[#2A2A2A] hover:bg-[#3A3A3A] text-zinc-200 rounded-lg text-xs font-mono font-bold transition-colors cursor-pointer shrink-0 flex items-center gap-1.5 border border-zinc-700"
            >
              <span id="details-btn-label">Show Film Info</span>
              <span
                id="details-btn-arrow"
                class="transition-transform duration-200">&darr;</span
              >
            </button>
          </div>

          <!-- Collapsible Film Metadata Drawer -->
          <div
            id="collapsible-film-details"
            class="hidden space-y-3 pt-2 border-t border-[#2E2E2E]"
          >
            <div
              class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 font-mono text-xs"
            >
              <div
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727]"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Director</span
                >
                <strong
                  id="screen-director"
                  class="text-zinc-200 text-xs block truncate">—</strong
                >
              </div>

              <div
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727]"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Producer</span
                >
                <strong
                  id="screen-producer"
                  class="text-zinc-200 text-xs block truncate">—</strong
                >
              </div>

              <div
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727]"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Cameraperson (DoP)</span
                >
                <strong
                  id="screen-dop"
                  class="text-zinc-200 text-xs block truncate">—</strong
                >
              </div>

              <div
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727]"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Genre</span
                >
                <strong
                  id="screen-genre"
                  class="text-zinc-200 text-xs block truncate">—</strong
                >
              </div>

              <div
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727]"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Entry ID</span
                >
                <strong
                  id="screen-entry-id"
                  class="text-[#D9381E] text-xs block truncate font-mono select-all"
                  >PSFF26-XXXX</strong
                >
              </div>

              <div
                id="screen-pwd-box"
                class="bg-[#141414] p-2.5 rounded-lg border border-[#272727] hidden"
              >
                <span
                  class="text-[10px] text-zinc-500 uppercase block font-bold"
                  >Screener Password</span
                >
                <strong
                  id="screen-pwd"
                  class="text-amber-400 text-xs block truncate font-mono select-all"
                  >None</strong
                >
              </div>
            </div>

            <div
              class="bg-[#121212] p-3 rounded-lg border border-[#272727] text-xs font-mono text-zinc-300 space-y-1"
            >
              <span class="text-[10px] font-bold text-zinc-500 uppercase block"
                >Synopsis</span
              >
              <p id="screen-synopsis" class="leading-relaxed text-zinc-300">
                No synopsis provided.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Scrollable Scoring Panel -->
        <div
          class="bg-[#1A1A1A] border border-[#2E2E2E] rounded-xl p-4 sm:p-6 space-y-5"
        >
          <!-- Sticky Sub-Bar for Live Marks & Status -->
          <div
            class="sticky top-16 sm:top-20 z-30 bg-[#242424] border border-[#3A3A3A] rounded-xl p-3 sm:p-4 shadow-xl flex items-center justify-between gap-4 font-mono"
          >
            <div>
              <span class="text-[10px] uppercase font-bold text-zinc-400 block"
                >Total Marks</span
              >
              <div class="flex items-baseline gap-1 mt-0.5">
                <span
                  id="live-total-score"
                  class="text-2xl sm:text-3xl font-black text-white">0</span
                >
                <span class="text-xs text-zinc-500 font-bold">/ 100</span>
              </div>
            </div>

            <div class="text-right">
              <span
                id="eval-status-pill"
                class="inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded-md bg-[#333333] text-zinc-300 border border-zinc-600"
              >
                Draft
              </span>
              <div
                id="rubric-progress-text"
                class="text-xs font-bold text-[#D9381E] mt-1"
              >
                0 / 12 Scored
              </div>
            </div>
          </div>

          <!-- Lock Notification -->
          <div
            id="locked-notice"
            class="hidden p-4 bg-emerald-950/80 border border-emerald-800 rounded-xl text-emerald-300 text-xs font-mono font-bold"
          >
            ✓ Evaluation is locked and finalized. Marks cannot be modified
            unless unlocked by the Festival Convener.
          </div>

          <!-- 12-Criterion Scoring Form -->
          <form id="rubric-form" class="space-y-4 font-mono text-xs">
            <div id="criteria-form-container" class="space-y-3">
              <!-- Dynamically populated via JS -->
            </div>

            <div
              class="bg-[#141414] border border-[#2E2E2E] rounded-xl p-4 space-y-2"
            >
              <label class="block text-xs font-bold uppercase text-zinc-300">
                General Juror Remarks / Recommendations
              </label>
              <textarea
                name="general_feedback"
                rows="3"
                placeholder="Enter remarks, critiques, or specific award citations..."
                class="w-full bg-[#0F0F0F] border border-[#333333] rounded-lg p-3 text-xs text-white focus:outline-none focus:border-[#D9381E]"
              ></textarea>
            </div>

            <!-- Submit & Lock CTA Trigger -->
            <div id="submit-block" class="pt-2 space-y-2">
              <button
                type="button"
                id="open-confirm-modal-btn"
                class="w-full py-4 bg-[#D9381E] hover:bg-[#b82d16] text-white font-black uppercase tracking-wider text-xs sm:text-sm rounded-xl transition-colors cursor-pointer shadow-lg disabled:opacity-50"
              >
                Submit &amp; Lock Scores (100 Marks) &rarr;
              </button>
              <p class="text-[10px] text-zinc-500 text-center">
                Drafts are automatically saved as you score.
              </p>
            </div>
          </form>
        </div>
      </main>
    </div>

    <!-- 3. MOBILE-OPTIMIZED IN-APP CONFIRMATION MODAL -->
    <div
      id="custom-confirm-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4"
    >
      <div
        class="w-full max-w-sm bg-[#1E1E1E] border border-[#333333] rounded-2xl p-6 space-y-5 shadow-2xl font-mono text-center"
      >
        <div
          class="w-12 h-12 bg-amber-500/10 text-amber-500 rounded-full flex items-center justify-center mx-auto border border-amber-500/30 text-xl font-bold"
        >
          🔒
        </div>

        <div class="space-y-1.5">
          <h3 class="text-base font-black uppercase text-white">
            Lock Evaluation?
          </h3>
          <p
            id="confirm-modal-film-title"
            class="text-xs font-bold text-zinc-300 truncate"
          >
            Movie Title
          </p>
          <p class="text-xs text-zinc-400 leading-relaxed pt-1">
            Total Marks Awarded: <strong
              id="confirm-modal-score"
              class="text-white text-sm font-black">0/100</strong
            >
          </p>
          <p class="text-[11px] text-zinc-500 pt-1">
            Once submitted, your marks are official and locked. You cannot
            modify them further.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <button
            type="button"
            id="cancel-confirm-modal-btn"
            class="py-3 bg-[#2A2A2A] hover:bg-[#383838] text-zinc-200 text-xs font-bold uppercase rounded-xl transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-lock-btn"
            class="py-3 bg-[#D9381E] hover:bg-[#b82d16] text-white text-xs font-black uppercase rounded-xl transition-colors cursor-pointer shadow-md"
          >
            Confirm &amp; Lock
          </button>
        </div>
      </div>
    </div>

    <!-- 4. IN-APP TOAST NOTIFICATION -->
    <div
      id="toast-notification"
      class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[#1E1E1E] border border-zinc-700 text-white px-5 py-3 rounded-full shadow-2xl text-xs font-mono font-bold flex items-center gap-2"
    >
      <span id="toast-icon">✓</span>
      <span id="toast-message">Action completed</span>
    </div>
  </div>
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const CRITERIA = [
    {
      key: "score_concept",
      label: "1. Concept / Premise",
      max: 10,
      desc: "Clarity, premise strength, and originality of theme",
    },
    {
      key: "score_originality",
      label: "2. Originality",
      max: 10,
      desc: "Fresh cinematic voice and perspective",
    },
    {
      key: "score_screenplay",
      label: "3. Screenplay / Structure",
      max: 15,
      desc: "Narrative pacing, scene dynamics, and dialogue",
    },
    {
      key: "score_direction",
      label: "4. Direction",
      max: 15,
      desc: "Directorial control, tonal balance, and visual vision",
    },
    {
      key: "score_characterization",
      label: "5. Characterization & Acting",
      max: 10,
      desc: "Performances, emotional authenticity, and casting",
    },
    {
      key: "score_cinematography",
      label: "6. Cinematography",
      max: 10,
      desc: "Framing, lighting, camera movement, and aesthetic",
    },
    {
      key: "score_editing",
      label: "7. Editing & Pacing",
      max: 10,
      desc: "Rhythm, scene transitions, and narrative economy",
    },
    {
      key: "score_sound",
      label: "8. Sound Design & Foley",
      max: 8,
      desc: "Clarity of audio, mixing, and sound effects",
    },
    {
      key: "score_production_design",
      label: "9. Production Design",
      max: 4,
      desc: "Locations, sets, props, and art direction",
    },
    {
      key: "score_music",
      label: "10. Music & Score",
      max: 3,
      desc: "Atmosphere, mood, and original score integration",
    },
    {
      key: "score_thematic_depth",
      label: "11. Thematic Depth",
      max: 5,
      desc: "Human insight, social depth, and relevance",
    },
    {
      key: "score_impact",
      label: "12. Overall Impact",
      max: 10,
      desc: "Lasting emotional resonance and memorable execution",
    },
  ];

  let currentJuror: any = null;
  let competitionFilms: any[] = [];
  let jurorEvaluations: any[] = [];
  let currentMovie: any = null;
  let currentEvaluation: any = null;
  let activeFilter: string = "ALL";
  let autosaveTimer: any = null;

  const authGuard = document.getElementById("auth-guard");
  const workspace = document.getElementById("jury-workspace");
  const homeView = document.getElementById("home-view");
  const playerView = document.getElementById("player-view");
  const loginForm = document.getElementById(
    "jury-login-form",
  ) as HTMLFormElement;
  const authErr = document.getElementById("auth-err");
  const navHomeBtn = document.getElementById("nav-home-btn");
  const playerBackBtn = document.getElementById("player-back-btn");
  const rubricForm = document.getElementById("rubric-form") as HTMLFormElement;
  const openConfirmModalBtn = document.getElementById(
    "open-confirm-modal-btn",
  ) as HTMLButtonElement;
  const confirmLockBtn = document.getElementById(
    "confirm-lock-btn",
  ) as HTMLButtonElement;
  const cancelConfirmModalBtn = document.getElementById(
    "cancel-confirm-modal-btn",
  );
  const customConfirmModal = document.getElementById("custom-confirm-modal");
  const lockedNotice = document.getElementById("locked-notice");
  const submitBlock = document.getElementById("submit-block");

  // Accordion details toggle elements
  const toggleDetailsBtn = document.getElementById("toggle-details-btn");
  const collapsibleDetails = document.getElementById(
    "collapsible-film-details",
  );
  const detailsBtnLabel = document.getElementById("details-btn-label");
  const detailsBtnArrow = document.getElementById("details-btn-arrow");

  let isDetailsExpanded = false;
  toggleDetailsBtn?.addEventListener("click", () => {
    isDetailsExpanded = !isDetailsExpanded;
    if (isDetailsExpanded) {
      collapsibleDetails?.classList.remove("hidden");
      if (detailsBtnLabel) detailsBtnLabel.innerText = "Hide Film Info";
      if (detailsBtnArrow) detailsBtnArrow.classList.add("rotate-180");
    } else {
      collapsibleDetails?.classList.add("hidden");
      if (detailsBtnLabel) detailsBtnLabel.innerText = "Show Film Info";
      if (detailsBtnArrow) detailsBtnArrow.classList.remove("rotate-180");
    }
  });

  // In-App Toast Messenger
  const showToast = (message: string, isError = false) => {
    const toast = document.getElementById("toast-notification");
    const icon = document.getElementById("toast-icon");
    const text = document.getElementById("toast-message");
    if (!toast || !text || !icon) return;

    icon.innerText = isError ? "✕" : "✓";
    icon.className = isError
      ? "text-red-400 font-bold"
      : "text-emerald-400 font-bold";
    text.innerText = message;
    toast.classList.remove("hidden");

    setTimeout(() => {
      toast.classList.add("hidden");
    }, 3200);
  };

  // Render 12 Criteria input rows
  const container = document.getElementById("criteria-form-container");
  if (container) {
    container.innerHTML = CRITERIA.map(
      (c) => `
      <div class="bg-[#141414] border border-[#2A2A2A] rounded-xl p-3.5 sm:p-4 space-y-2">
        <div class="flex items-center justify-between gap-2">
          <div>
            <h4 class="text-xs font-bold uppercase text-white">${c.label}</h4>
            <span class="text-[10px] text-zinc-500 block">${c.desc}</span>
          </div>
          <div class="flex items-center gap-1.5 shrink-0">
            <input
              type="number"
              name="${c.key}"
              min="0"
              max="${c.max}"
              placeholder="—"
              class="rubric-input w-14 bg-[#0F0F0F] border border-[#3A3A3A] rounded-lg p-2 text-center text-sm font-black text-white focus:border-[#D9381E] focus:outline-none"
            />
            <span class="text-xs text-zinc-500 font-bold">/ ${c.max}</span>
          </div>
        </div>
      </div>
    `,
    ).join("");
  }

  // Session Authentication Check
  const checkSession = async () => {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (session) {
      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", session.user.id)
        .single();

      if (profile && profile.is_active) {
        currentJuror = profile;
        document.getElementById("juror-name-badge")!.innerText =
          profile.full_name;
        authGuard?.classList.add("hidden");
        workspace?.classList.remove("hidden");
        showHomeView();
        await loadAcceptedFilms();
      } else {
        await supabase.auth.signOut();
        showError("Account is inactive or restricted.");
      }
    } else {
      authGuard?.classList.remove("hidden");
      workspace?.classList.add("hidden");
    }
  };

  const showError = (msg: string) => {
    if (authErr) {
      authErr.innerText = msg;
      authErr.classList.remove("hidden");
    }
  };

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    authErr?.classList.add("hidden");
    const email = (
      document.getElementById("jury-email") as HTMLInputElement
    ).value.trim();
    const password = (document.getElementById("jury-pwd") as HTMLInputElement)
      .value;

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });
    if (error) {
      showError(error.message);
    } else {
      await checkSession();
    }
  });

  document
    .getElementById("jury-signout-btn")
    ?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.reload();
    });

  const showHomeView = () => {
    homeView?.classList.remove("hidden");
    playerView?.classList.add("hidden");
    const videoFrame = document.getElementById(
      "video-frame",
    ) as HTMLIFrameElement;
    if (videoFrame) videoFrame.src = "";
  };

  const showPlayerView = () => {
    homeView?.classList.add("hidden");
    playerView?.classList.remove("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  navHomeBtn?.addEventListener("click", showHomeView);
  playerBackBtn?.addEventListener("click", showHomeView);

  // Load Data
  const loadAcceptedFilms = async () => {
    const [filmsRes, evalsRes] = await Promise.all([
      supabase
        .from("submissions")
        .select("*")
        .eq("status", "Accepted")
        .order("created_at", { ascending: true }),
      supabase.from("evaluations").select("*").eq("jury_id", currentJuror.id),
    ]);

    competitionFilms = filmsRes.data || [];
    jurorEvaluations = evalsRes.data || [];

    updateMetrics();
    renderHomeMovies();
  };

  const updateMetrics = () => {
    const total = competitionFilms.length;
    const completed = jurorEvaluations.filter((e) => e.is_submitted).length;
    const pending = total - completed;

    document.getElementById("stat-total-assigned")!.innerText =
      total.toString();
    document.getElementById("stat-completed")!.innerText = completed.toString();
    document.getElementById("stat-pending")!.innerText = pending.toString();
  };

  const renderHomeMovies = () => {
    const tbody = document.getElementById("home-movies-tbody");
    if (!tbody) return;

    const query =
      (document.getElementById("top-search-bar") as HTMLInputElement)?.value
        .toLowerCase()
        .trim() || "";
    const evalMap = new Map(jurorEvaluations.map((e) => [e.submission_id, e]));

    const filtered = competitionFilms.filter((film) => {
      const evaluation = evalMap.get(film.id);
      const isCompleted = evaluation?.is_submitted;
      const isInProgress =
        evaluation && !isCompleted && evaluation.status === "In Progress";

      let statusStr = "Pending";
      if (isCompleted) statusStr = "Completed";
      else if (isInProgress) statusStr = "In Progress";

      const matchesFilter =
        activeFilter === "ALL" || statusStr === activeFilter;
      const matchesSearch =
        !query ||
        film.film_title?.toLowerCase().includes(query) ||
        film.director_full_name?.toLowerCase().includes(query) ||
        film.genre?.toLowerCase().includes(query) ||
        film.entry_number?.toLowerCase().includes(query);

      return matchesFilter && matchesSearch;
    });

    document.getElementById("results-count")!.innerText =
      `${filtered.length} Films`;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-zinc-500 font-bold">No competition films found.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered
      .map((movie) => {
        const evaluation = evalMap.get(movie.id);
        const isCompleted = evaluation?.is_submitted;
        const isInProgress =
          evaluation && !isCompleted && evaluation.status === "In Progress";

        let statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-[#272727] text-zinc-400 border border-zinc-700">Yet to Start</span>`;
        if (isCompleted) {
          statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-emerald-950 text-emerald-400 border border-emerald-700">✓ Completed</span>`;
        } else if (isInProgress) {
          statusBadge = `<span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-amber-950 text-amber-400 border border-amber-700">In Progress</span>`;
        }

        // Calculate score dynamically if completed
        let displayScore = "—";
        if (isCompleted && evaluation) {
          let computed = 0;
          CRITERIA.forEach((c) => {
            computed += Number(evaluation[c.key] || 0);
          });
          displayScore = `${computed} / 100`;
        }

        return `
        <tr class="hover:bg-[#2A2A2A]/50 transition-colors text-xs">
          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E] font-bold text-zinc-400 select-all">${movie.entry_number}</td>
          
          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E]">
            <div class="font-bold text-white text-sm truncate max-w-[180px] sm:max-w-[260px]">${movie.film_title}</div>
            <span class="text-[10px] text-zinc-400 font-normal">${movie.genre || "Short Film"} &bull; ${movie.film_language}</span>
          </td>

          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-zinc-300 hidden sm:table-cell">${movie.director_full_name}</td>
          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-zinc-400 hidden md:table-cell">${movie.duration_minutes} Mins</td>
          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-center">${statusBadge}</td>

          <td class="p-3 sm:p-3.5 border-r border-[#2E2E2E] text-center font-black ${isCompleted ? "text-emerald-400" : "text-zinc-500"}">
            ${displayScore}
          </td>

          <td class="p-3 sm:p-3.5 text-center">
            <button
              type="button"
              data-id="${movie.id}"
              class="play-movie-btn px-3 py-1.5 rounded-lg ${isCompleted ? "bg-[#272727] text-zinc-300 hover:bg-[#383838]" : "bg-[#D9381E] text-white hover:bg-[#b82d16]"} font-bold text-[10px] uppercase transition-colors cursor-pointer inline-flex items-center gap-1 shadow-sm"
            >
              <span>▶</span> ${isCompleted ? "Review" : "Watch"}
            </button>
          </td>
        </tr>
      `;
      })
      .join("");

    document.querySelectorAll(".play-movie-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = parseInt(
          (e.currentTarget as HTMLElement).getAttribute("data-id") || "0",
          10,
        );
        openPlayerScreen(id);
      });
    });
  };

  document.querySelectorAll(".filter-chip").forEach((chip) => {
    chip.addEventListener("click", (e) => {
      activeFilter =
        (e.currentTarget as HTMLElement).getAttribute("data-filter") || "ALL";
      document.querySelectorAll(".filter-chip").forEach((c) => {
        c.className =
          "filter-chip px-4 py-1.5 rounded-lg bg-[#272727] text-zinc-300 hover:bg-[#3F3F3F] shrink-0 transition-colors";
      });
      (e.currentTarget as HTMLElement).className =
        "filter-chip px-4 py-1.5 rounded-lg bg-white text-black shrink-0 transition-colors";
      renderHomeMovies();
    });
  });

  document
    .getElementById("top-search-bar")
    ?.addEventListener("input", renderHomeMovies);

  const openPlayerScreen = async (submissionId: number) => {
    currentMovie = competitionFilms.find((m) => m.id === submissionId);
    if (!currentMovie) return;

    showPlayerView();

    // Reset collapsible details to default hidden state for clean scannability
    isDetailsExpanded = false;
    collapsibleDetails?.classList.add("hidden");
    if (detailsBtnLabel) detailsBtnLabel.innerText = "Show Film Info";
    if (detailsBtnArrow) detailsBtnArrow.classList.remove("rotate-180");

    document.getElementById("screen-film-title")!.innerText =
      currentMovie.film_title;
    document.getElementById("screen-film-language-runtime")!.innerText =
      `${currentMovie.film_language} • ${currentMovie.duration_minutes} Mins • ${currentMovie.year_of_production || 2026}`;
    document.getElementById("screen-director")!.innerText =
      currentMovie.director_full_name || "—";
    document.getElementById("screen-producer")!.innerText =
      currentMovie.producer_name || currentMovie.production_company || "—";
    document.getElementById("screen-dop")!.innerText =
      currentMovie.dop_full_name || "—";
    document.getElementById("screen-genre")!.innerText =
      currentMovie.genre || "Short Film";
    document.getElementById("screen-entry-id")!.innerText =
      currentMovie.entry_number;
    document.getElementById("screen-synopsis")!.innerText =
      currentMovie.synopsis || "No synopsis recorded.";

    const pwdBox = document.getElementById("screen-pwd-box");
    if (
      currentMovie.screener_password &&
      currentMovie.screener_password !== "None"
    ) {
      document.getElementById("screen-pwd")!.innerText =
        currentMovie.screener_password;
      pwdBox?.classList.remove("hidden");
    } else {
      pwdBox?.classList.add("hidden");
    }

    const videoFrame = document.getElementById(
      "video-frame",
    ) as HTMLIFrameElement;
    const playerPlaceholder = document.getElementById("player-placeholder");
    const screenerUrl = currentMovie.screener_url || "";

    if (screenerUrl) {
      let embedUrl = screenerUrl;
      if (screenerUrl.includes("vimeo.com")) {
        const idMatch = screenerUrl.match(/vimeo\.com\/(\d+)/);
        if (idMatch)
          embedUrl = `https://player.vimeo.com/video/${idMatch[1]}?autoplay=0`;
      } else if (
        screenerUrl.includes("youtube.com") ||
        screenerUrl.includes("youtu.be")
      ) {
        const ytMatch = screenerUrl.match(
          /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/,
        );
        if (ytMatch) embedUrl = `https://www.youtube.com/embed/${ytMatch[1]}`;
      }

      videoFrame.src = embedUrl;
      videoFrame.classList.remove("hidden");
      playerPlaceholder?.classList.add("hidden");
    }

    await loadEvaluation(currentMovie.id);
  };

  const loadEvaluation = async (submissionId: number) => {
    let { data: evalData } = await supabase
      .from("evaluations")
      .select("*")
      .eq("submission_id", submissionId)
      .eq("jury_id", currentJuror.id)
      .maybeSingle();

    if (!evalData) {
      const { data: newEval } = await supabase
        .from("evaluations")
        .insert([
          {
            submission_id: submissionId,
            jury_id: currentJuror.id,
            status: "In Progress",
            started_at: new Date().toISOString(),
          },
        ])
        .select()
        .single();
      evalData = newEval;
    }

    currentEvaluation = evalData;
    populateRubricForm(currentEvaluation);
  };

  const populateRubricForm = (evaluation: any) => {
    rubricForm.reset();
    const isLocked = evaluation.is_submitted;

    const statusPill = document.getElementById("eval-status-pill")!;
    if (isLocked) {
      statusPill.innerText = "Locked 🔒";
      statusPill.className =
        "inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded-md bg-emerald-950 text-emerald-400 border border-emerald-700";
      lockedNotice?.classList.remove("hidden");
      submitBlock?.classList.add("hidden");
    } else {
      statusPill.innerText = "Draft";
      statusPill.className =
        "inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded-md bg-amber-950 text-amber-400 border border-amber-700";
      lockedNotice?.classList.add("hidden");
      submitBlock?.classList.remove("hidden");
    }

    CRITERIA.forEach(({ key }) => {
      const val = evaluation[key];
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      if (input) {
        input.value = val !== null && val !== undefined ? val.toString() : "";
        input.disabled = isLocked;
      }
    });

    const generalFeedback = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    if (generalFeedback) {
      generalFeedback.value = evaluation.general_feedback || "";
      generalFeedback.disabled = isLocked;
    }

    recalcScores();
  };

  const recalcScores = () => {
    let total = 0;
    let scoredCount = 0;

    CRITERIA.forEach(({ key, max }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();

      if (rawVal !== "" && rawVal !== undefined) {
        let num = parseInt(rawVal, 10);
        if (isNaN(num)) num = 0;
        if (num > max) {
          num = max;
          input.value = max.toString();
        }
        if (num < 0) {
          num = 0;
          input.value = "0";
        }
        total += num;
        scoredCount++;
      }
    });

    document.getElementById("live-total-score")!.innerText = total.toString();
    document.getElementById("rubric-progress-text")!.innerText =
      `${scoredCount} / 12 Scored`;

    return { total, scoredCount };
  };

  const triggerAutosave = () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(async () => {
      await saveDraft();
    }, 1200);
  };

  // Safe draft save: Exclude total_score as it is an auto-computed database generated column
  const saveDraft = async () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;

    const payload: any = {
      last_saved_at: new Date().toISOString(),
      status: "In Progress",
    };

    CRITERIA.forEach(({ key }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();
      payload[key] =
        rawVal === "" || rawVal === undefined ? null : parseInt(rawVal, 10);
    });

    const generalFeedback = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    payload.general_feedback = generalFeedback
      ? generalFeedback.value.trim()
      : null;

    const { error } = await supabase
      .from("evaluations")
      .update(payload)
      .eq("id", currentEvaluation.id);
    if (!error) {
      showToast("Draft autosaved");
    }
  };

  rubricForm?.addEventListener("input", () => {
    recalcScores();
    triggerAutosave();
  });

  // Open Custom In-App Confirmation Modal (Replaces browser window alert/confirm)
  openConfirmModalBtn?.addEventListener("click", () => {
    const { total, scoredCount } = recalcScores();

    if (scoredCount < 12) {
      showToast(`Please score all 12 criteria (${scoredCount}/12 done)`, true);
      return;
    }

    document.getElementById("confirm-modal-film-title")!.innerText =
      currentMovie.film_title;
    document.getElementById("confirm-modal-score")!.innerText =
      `${total} / 100`;
    customConfirmModal?.classList.remove("hidden");
  });

  cancelConfirmModalBtn?.addEventListener("click", () => {
    customConfirmModal?.classList.add("hidden");
  });

  // Confirm and Finalize Evaluation Lock
  confirmLockBtn?.addEventListener("click", async () => {
    confirmLockBtn.disabled = true;
    confirmLockBtn.innerText = "Locking...";

    await saveDraft();

    // Do NOT include `total_score` in update payload; the database generated column computes it automatically
    const { error } = await supabase
      .from("evaluations")
      .update({
        is_submitted: true,
        status: "Completed",
        submitted_at: new Date().toISOString(),
      })
      .eq("id", currentEvaluation.id);

    confirmLockBtn.disabled = false;
    confirmLockBtn.innerText = "Confirm & Lock";
    customConfirmModal?.classList.add("hidden");

    if (error) {
      showToast(`Error locking: ${error.message}`, true);
    } else {
      currentEvaluation.is_submitted = true;
      populateRubricForm(currentEvaluation);
      await loadAcceptedFilms();
      showToast("Scores submitted and locked!");
    }
  });

  checkSession();
</script>
