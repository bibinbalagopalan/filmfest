---
// src/pages/juries.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Jury Screening Room | PSFF Season 03">
  <!-- Scoped CSS: Hide public navbar & footer for focused workspace -->
  <style is:global>
    header:not(#jury-top-bar),
    nav,
    footer {
      display: none !important;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #fdfcf7;
    }
    ::-webkit-scrollbar-thumb {
      background: #18181b;
      border-radius: 0px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #b31d12;
    }
  </style>

  <div
    class="relative w-full min-h-screen bg-[#B31D12] text-[#FDFCF7] font-mono p-2 sm:p-4 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden flex flex-col"
  >
    <!-- Background Frame Accents & Swirl Patterns -->
    <div
      class="fixed inset-0 pointer-events-none opacity-15 overflow-hidden z-0"
    >
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <!-- 1. LOGIN SCREEN -->
    <div
      id="auth-guard"
      class="min-h-screen flex items-center justify-center p-4 relative z-10"
    >
      <div
        class="w-full max-w-md bg-[#FDFCF7] text-[#18181B] border-2 border-black p-6 sm:p-8 rounded-2xl shadow-[6px_6px_0px_0px_#000000] space-y-6"
      >
        <div
          class="border-b-2 border-black/10 pb-4 flex items-center justify-between gap-4"
        >
          <div>
            <span
              class="text-[10px] font-black uppercase text-[#B31D12] tracking-widest block"
            >
              PSFF Season 03
            </span>
            <h1
              class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#18181B] mt-0.5"
            >
              Jury Portal
            </h1>
            <p class="text-xs text-zinc-600 font-sans mt-0.5">
              Sign in with authorized credentials.
            </p>
          </div>
          <div
            class="h-12 w-12 bg-[#B31D12] border-2 border-black rounded-xl p-1 flex items-center justify-center shadow-sm shrink-0"
          >
            <img
              src="https://i.ibb.co/0R0xXBmN/logo-2.png"
              alt="PSFF Logo"
              class="h-full w-auto object-contain"
            />
          </div>
        </div>

        <form id="jury-login-form" class="space-y-4 text-xs font-mono">
          <div class="space-y-1.5">
            <label
              class="block font-bold uppercase tracking-wider text-[#18181B]"
            >
              Email Address
            </label>
            <input
              type="email"
              id="jury-email"
              required
              class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              placeholder="jury@psff.in"
            />
          </div>
          <div class="space-y-1.5">
            <label
              class="block font-bold uppercase tracking-wider text-[#18181B]"
            >
              Password
            </label>
            <input
              type="password"
              id="jury-pwd"
              required
              class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              placeholder="••••••••"
            />
          </div>
          <div
            id="auth-err"
            class="hidden p-3 bg-red-100 border border-[#B31D12] text-[#B31D12] font-bold text-[11px] rounded-lg"
          >
          </div>
          <button
            type="submit"
            id="jury-auth-btn"
            class="w-full py-3 font-black uppercase tracking-widest text-[#FDFCF7] bg-[#B31D12] border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[3px_3px_0px_0px_#000000]"
          >
            Enter Screening Room &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- 2. MAIN WORKSPACE -->
    <div
      id="jury-workspace"
      class="hidden flex-1 relative z-10 flex flex-col max-w-7xl mx-auto w-full space-y-4 sm:space-y-6"
    >
      <!-- Top App Bar -->
      <header
        id="jury-top-bar"
        class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-2 border-black rounded-2xl bg-[#FDFCF7] text-[#18181B] p-4 sm:p-5 shadow-[6px_6px_0px_0px_#000000] sticky top-4 z-40"
      >
        <div class="flex items-center gap-4 shrink-0">
          <div
            class="h-10 w-10 bg-[#B31D12] border-2 border-black rounded-xl p-1 flex items-center justify-center shadow-sm shrink-0"
          >
            <img
              src="https://i.ibb.co/0R0xXBmN/logo-2.png"
              alt="PSFF Logo"
              class="h-full w-auto object-contain"
            />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span class="text-[10px] font-bold uppercase text-[#B31D12]"
                >Screening Room</span
              >
            </div>
            <button
              type="button"
              id="nav-home-btn"
              class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#18181B] hover:text-[#B31D12] transition-colors mt-0.5 text-left focus:outline-none"
            >
              Jury Dashboard
            </button>
          </div>
        </div>

        <div class="flex-1 max-w-xl mx-0 md:mx-4 w-full">
          <div class="relative w-full">
            <input
              type="text"
              id="top-search-bar"
              placeholder="Search films, directors, genres, IDs..."
              class="w-full bg-white border-2 border-black rounded-lg py-2 pl-9 pr-4 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12] placeholder:text-zinc-500 font-mono shadow-xs"
            />
            <svg
              class="w-4 h-4 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>

        <div
          class="flex items-center gap-2 sm:gap-3 shrink-0 font-mono text-xs"
        >
          <div
            class="hidden md:flex items-center gap-2 bg-zinc-100 px-3 py-2 rounded-lg border-2 border-black shadow-[2px_2px_0px_0px_#000000]"
          >
            <span
              id="juror-name-badge"
              class="font-black text-[#18181B] truncate max-w-[120px] uppercase"
            >
              Juror
            </span>
          </div>
          <button
            type="button"
            id="jury-signout-btn"
            class="px-3 py-2 bg-[#B31D12] text-white border-2 border-black rounded-lg hover:bg-black font-black uppercase tracking-wider text-[11px] transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000]"
          >
            Sign Out
          </button>
        </div>
      </header>

      <!-- VIEW 1: HOME & MOVIE TABLE -->
      <main id="home-view" class="flex-1 w-full space-y-4 sm:space-y-6">
        <div class="grid grid-cols-3 gap-3 sm:gap-4 font-mono">
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span
              class="text-[10px] sm:text-xs text-zinc-600 uppercase font-bold block"
            >
              Assigned
            </span>
            <span
              id="stat-total-assigned"
              class="text-xl sm:text-3xl font-black mt-1 block"
            >
              0
            </span>
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span
              class="text-[10px] sm:text-xs text-emerald-700 uppercase font-bold block"
            >
              Completed
            </span>
            <span
              id="stat-completed"
              class="text-xl sm:text-3xl font-black text-emerald-700 mt-1 block"
            >
              0
            </span>
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span
              class="text-[10px] sm:text-xs text-[#B31D12] uppercase font-bold block"
            >
              Pending
            </span>
            <span
              id="stat-pending"
              class="text-xl sm:text-3xl font-black text-[#B31D12] mt-1 block"
            >
              0
            </span>
          </div>
        </div>

        <div
          class="flex items-center gap-2 overflow-x-auto pb-1 text-xs font-mono"
        >
          <button
            type="button"
            data-filter="ALL"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-[#B31D12] text-white border-2 border-black rounded-md shadow-[2px_2px_0px_0px_#000000] shrink-0 transition-colors"
          >
            All Films
          </button>
          <button
            type="button"
            data-filter="Pending"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] hover:bg-zinc-300 border-2 border-transparent rounded-md shrink-0 transition-colors"
          >
            Yet to Start
          </button>
          <button
            type="button"
            data-filter="In Progress"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] hover:bg-zinc-300 border-2 border-transparent rounded-md shrink-0 transition-colors"
          >
            In Progress
          </button>
          <button
            type="button"
            data-filter="Completed"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] hover:bg-zinc-300 border-2 border-transparent rounded-md shrink-0 transition-colors"
          >
            Completed 🔒
          </button>
        </div>

        <div
          class="bg-[#FDFCF7] border-2 border-black rounded-2xl shadow-[6px_6px_0px_0px_#000000] overflow-hidden text-[#18181B]"
        >
          <div
            class="p-4 border-b-2 border-black flex items-center justify-between bg-zinc-100"
          >
            <h2
              class="text-xs sm:text-sm font-black uppercase tracking-wider text-[#18181B] font-mono"
            >
              Competition Queue
            </h2>
            <span
              id="results-count"
              class="text-xs text-zinc-600 font-bold font-mono"
            >
              0 Films
            </span>
          </div>
          <div class="overflow-x-auto max-h-[60vh]">
            <table class="w-full text-left text-xs border-collapse">
              <thead class="sticky top-0 z-20">
                <tr
                  class="bg-[#18181B] text-[#FDFCF7] uppercase tracking-wider text-[10px] font-mono border-b-2 border-black"
                >
                  <th class="p-3 sm:p-3.5 border-r border-zinc-700 w-24"
                    >Entry ID</th
                  >
                  <th class="p-3 sm:p-3.5 border-r border-zinc-700"
                    >Film Title &amp; Genre</th
                  >
                  <th
                    class="p-3 sm:p-3.5 border-r border-zinc-700 hidden sm:table-cell"
                  >
                    Director
                  </th>
                  <th
                    class="p-3 sm:p-3.5 border-r border-zinc-700 hidden md:table-cell"
                  >
                    Duration
                  </th>
                  <th class="p-3 sm:p-3.5 border-r border-zinc-700 text-center"
                    >Status</th
                  >
                  <th class="p-3 sm:p-3.5 border-r border-zinc-700 text-center"
                    >Score</th
                  >
                  <th class="p-3 sm:p-3.5 text-center w-28">Screening</th>
                </tr>
              </thead>
              <tbody
                id="home-movies-tbody"
                class="divide-y divide-zinc-200 font-mono"
              >
                <tr>
                  <td
                    colspan="7"
                    class="p-8 text-center text-zinc-500 font-bold"
                  >
                    Loading competition films...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </main>

      <!-- VIEW 2: SCREENING & MARKING ROOM -->
      <main id="player-view" class="hidden flex-1 w-full space-y-4 pb-12">
        <div>
          <button
            type="button"
            id="player-back-btn"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border-2 border-black hover:bg-zinc-100 text-[11px] font-mono font-black text-[#18181B] uppercase transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000]"
          >
            <span>&larr;</span> Back to Films List
          </button>
        </div>

        <!-- 1. Video Player Container -->
        <div
          class="w-full bg-black rounded-xl overflow-hidden aspect-video border-2 border-black shadow-[6px_6px_0px_0px_#000000] relative flex items-center justify-center"
        >
          <div id="player-placeholder" class="text-center p-6 space-y-2">
            <span class="text-zinc-600 text-4xl block">▶</span>
            <p
              class="text-xs text-zinc-400 font-mono font-bold uppercase tracking-widest"
            >
              Loading Film Stream
            </p>
          </div>
          <iframe
            id="video-frame"
            class="hidden w-full h-full"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen></iframe>
        </div>

        <!-- 2. Film Heading & Collapsible Details Section -->
        <div
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-4 sm:p-6 shadow-[6px_6px_0px_0px_#000000] space-y-4"
        >
          <div
            class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
          >
            <div>
              <span
                class="text-[10px] font-black uppercase text-[#B31D12] tracking-widest block"
                id="screen-entry-id"
              >
                PSFF26-XXXX
              </span>
              <h1
                id="screen-film-title"
                class="text-xl sm:text-3xl font-black uppercase tracking-tight mt-0.5 font-mono"
              >
                Film Title
              </h1>
              <span
                id="screen-film-language-runtime"
                class="text-xs font-mono font-bold text-zinc-600 block mt-1"
              >
                Malayalam &bull; 15 Mins
              </span>
            </div>
            <!-- Toggle Details Accordion Button -->
            <button
              type="button"
              id="toggle-details-btn"
              class="px-3 py-2 bg-zinc-200 hover:bg-zinc-300 border-2 border-black text-[#18181B] rounded-lg text-[10px] font-mono font-black uppercase transition-colors cursor-pointer shrink-0 flex items-center gap-1.5 shadow-[2px_2px_0px_0px_#000000]"
            >
              <span id="details-btn-label">Show Film Info</span>
              <span
                id="details-btn-arrow"
                class="transition-transform duration-200 font-sans"
              >
                &darr;
              </span>
            </button>
          </div>

          <!-- Collapsible Film Metadata Drawer -->
          <div
            id="collapsible-film-details"
            class="hidden space-y-3 pt-4 border-t-2 border-black/10"
          >
            <div
              class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 font-mono text-xs"
            >
              <div
                class="bg-white p-3 rounded-lg border-2 border-black shadow-sm"
              >
                <span class="text-[9px] text-zinc-500 uppercase block font-bold"
                  >Director</span
                >
                <strong
                  id="screen-director"
                  class="text-[#18181B] text-xs block truncate mt-0.5"
                >
                  —
                </strong>
              </div>
              <div
                class="bg-white p-3 rounded-lg border-2 border-black shadow-sm"
              >
                <span class="text-[9px] text-zinc-500 uppercase block font-bold"
                  >Producer</span
                >
                <strong
                  id="screen-producer"
                  class="text-[#18181B] text-xs block truncate mt-0.5"
                >
                  —
                </strong>
              </div>
              <div
                class="bg-white p-3 rounded-lg border-2 border-black shadow-sm"
              >
                <span
                  class="text-[9px] text-zinc-500 uppercase block font-bold"
                >
                  Cameraperson (DoP)
                </span>
                <strong
                  id="screen-dop"
                  class="text-[#18181B] text-xs block truncate mt-0.5"
                >
                  —
                </strong>
              </div>
              <div
                class="bg-white p-3 rounded-lg border-2 border-black shadow-sm"
              >
                <span class="text-[9px] text-zinc-500 uppercase block font-bold"
                  >Genre</span
                >
                <strong
                  id="screen-genre"
                  class="text-[#18181B] text-xs block truncate mt-0.5"
                >
                  —
                </strong>
              </div>
              <div
                id="screen-pwd-box"
                class="bg-amber-100 p-3 rounded-lg border-2 border-amber-400 shadow-sm hidden md:col-span-4"
              >
                <span
                  class="text-[9px] text-amber-800 uppercase block font-bold"
                >
                  Screener Password
                </span>
                <strong
                  id="screen-pwd"
                  class="text-[#18181B] text-xs block font-mono select-all mt-0.5"
                >
                  None
                </strong>
              </div>
            </div>
            <div
              class="bg-zinc-50 p-4 rounded-lg border-2 border-black text-xs font-mono text-[#18181B] space-y-1.5 shadow-sm"
            >
              <span
                class="text-[10px] font-black text-[#B31D12] uppercase block tracking-wider"
              >
                Synopsis
              </span>
              <p id="screen-synopsis" class="leading-relaxed font-sans text-sm">
                No synopsis provided.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Scrollable Scoring Panel -->
        <div
          class="bg-[#FDFCF7] border-2 border-black rounded-2xl p-4 sm:p-6 space-y-6 shadow-[6px_6px_0px_0px_#000000]"
        >
          <h2
            class="text-base sm:text-lg font-black uppercase text-[#18181B] border-b-2 border-black/10 pb-2"
          >
            Jury Evaluation Rubric
          </h2>

          <!-- Sticky Sub-Bar for Live Marks & Status -->
          <div
            class="sticky top-[88px] sm:top-[104px] z-30 bg-white border-2 border-black rounded-xl p-4 shadow-[4px_4px_0px_0px_#000000] flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono"
          >
            <div>
              <span class="text-[10px] uppercase font-bold text-zinc-500 block"
                >Total Marks</span
              >
              <div class="flex items-baseline gap-1 mt-0.5">
                <span
                  id="live-total-score"
                  class="text-3xl font-black text-[#18181B]">0</span
                >
                <span class="text-sm text-zinc-600 font-bold">/ 100</span>
              </div>
            </div>
            <div
              class="text-left sm:text-right flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-center w-full sm:w-auto"
            >
              <span
                id="eval-status-pill"
                class="inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded bg-amber-100 text-amber-900 border border-amber-400"
              >
                Draft
              </span>
              <div
                id="rubric-progress-text"
                class="text-xs font-black text-[#B31D12] mt-0 sm:mt-1"
              >
                0 / 12 Scored
              </div>
            </div>
          </div>

          <!-- Lock Notification -->
          <div
            id="locked-notice"
            class="hidden p-4 bg-emerald-50 border-2 border-emerald-600 rounded-xl text-emerald-900 text-xs font-mono font-bold shadow-sm"
          >
            ✓ Evaluation is locked and finalized. Marks cannot be modified
            unless unlocked by the Festival Convener.
          </div>

          <!-- 12-Criterion Scoring Form -->
          <form id="rubric-form" class="space-y-4 font-mono text-xs">
            <div id="criteria-form-container" class="space-y-3">
              <!-- Dynamically populated via JS -->
            </div>
            <div
              class="bg-zinc-50 border-2 border-black rounded-xl p-4 space-y-2 shadow-sm"
            >
              <label class="block text-xs font-black uppercase text-[#18181B]">
                General Juror Remarks / Recommendations
              </label>
              <textarea
                name="general_feedback"
                rows="4"
                placeholder="Enter remarks, critiques, or specific award citations..."
                class="w-full bg-white border-2 border-black rounded-lg p-3 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12] font-sans"
              ></textarea>
            </div>
            <!-- Submit & Lock CTA Trigger -->
            <div id="submit-block" class="pt-4 space-y-2">
              <button
                type="button"
                id="open-confirm-modal-btn"
                class="w-full py-4 bg-[#B31D12] hover:bg-black text-white font-black uppercase tracking-widest text-xs sm:text-sm border-2 border-black rounded-xl transition-colors cursor-pointer shadow-[4px_4px_0px_0px_#000000] disabled:opacity-50"
              >
                Submit &amp; Lock Scores (100 Marks) &rarr;
              </button>
              <p
                class="text-[10px] text-zinc-500 font-bold text-center uppercase tracking-wider pt-2"
              >
                Drafts are automatically saved as you score.
              </p>
            </div>
          </form>
        </div>
      </main>
    </div>

    <!-- 3. MOBILE-OPTIMIZED IN-APP CONFIRMATION MODAL -->
    <div
      id="custom-confirm-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-xs flex items-center justify-center p-4"
    >
      <div
        class="w-full max-w-sm bg-[#FDFCF7] border-2 border-black rounded-2xl p-6 space-y-5 shadow-[8px_8px_0px_0px_#000000] font-mono text-center text-[#18181B]"
      >
        <div
          class="w-12 h-12 bg-amber-100 text-amber-700 rounded-xl flex items-center justify-center mx-auto border-2 border-black text-xl font-bold shadow-sm"
        >
          🔒
        </div>
        <div class="space-y-1.5">
          <h3 class="text-base font-black uppercase">Lock Evaluation?</h3>
          <p
            id="confirm-modal-film-title"
            class="text-xs font-bold text-zinc-600 truncate"
          >
            Movie Title
          </p>
          <p class="text-xs text-[#18181B] pt-2">
            Total Marks Awarded: <br /><strong
              id="confirm-modal-score"
              class="text-2xl font-black text-[#B31D12]">0/100</strong
            >
          </p>
          <p
            class="text-[10px] text-zinc-500 pt-2 font-sans font-bold leading-relaxed border-t-2 border-black/10 mt-2 pt-3"
          >
            Once submitted, your marks are official and locked. You cannot
            modify them further without admin assistance.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 pt-2">
          <button
            type="button"
            id="cancel-confirm-modal-btn"
            class="py-3 bg-zinc-200 hover:bg-zinc-300 border-2 border-black text-[#18181B] text-xs font-black uppercase rounded-xl transition-colors cursor-pointer shadow-sm"
          >
            Cancel
          </button>
          <button
            type="button"
            id="confirm-lock-btn"
            class="py-3 bg-[#B31D12] hover:bg-black text-white text-xs font-black uppercase border-2 border-black rounded-xl transition-colors cursor-pointer shadow-[3px_3px_0px_0px_#000000]"
          >
            Confirm
          </button>
        </div>
      </div>
    </div>

    <!-- 4. IN-APP TOAST NOTIFICATION -->
    <div
      id="toast-notification"
      class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[#18181B] border-2 border-black text-white px-5 py-3 rounded-xl shadow-[4px_4px_0px_0px_#B31D12] text-xs font-mono font-bold flex items-center gap-2"
    >
      <span id="toast-icon">✓</span>
      <span id="toast-message">Action completed</span>
    </div>
  </div>
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const CRITERIA = [
    {
      key: "score_concept",
      label: "1. Concept / Premise",
      max: 10,
      desc: "Clarity, premise strength, and originality",
    },
    {
      key: "score_originality",
      label: "2. Originality",
      max: 10,
      desc: "Fresh cinematic voice and perspective",
    },
    {
      key: "score_screenplay",
      label: "3. Screenplay / Structure",
      max: 15,
      desc: "Narrative pacing, scene dynamics",
    },
    {
      key: "score_direction",
      label: "4. Direction",
      max: 15,
      desc: "Directorial control and visual vision",
    },
    {
      key: "score_characterization",
      label: "5. Characterization & Acting",
      max: 10,
      desc: "Performances, emotional authenticity",
    },
    {
      key: "score_cinematography",
      label: "6. Cinematography",
      max: 10,
      desc: "Framing, lighting, camera aesthetic",
    },
    {
      key: "score_editing",
      label: "7. Editing & Pacing",
      max: 10,
      desc: "Rhythm, transitions, narrative economy",
    },
    {
      key: "score_sound",
      label: "8. Sound Design & Foley",
      max: 8,
      desc: "Clarity of audio, mixing",
    },
    {
      key: "score_production_design",
      label: "9. Production Design",
      max: 4,
      desc: "Locations, sets, art direction",
    },
    {
      key: "score_music",
      label: "10. Music & Score",
      max: 3,
      desc: "Atmosphere and original score",
    },
    {
      key: "score_thematic_depth",
      label: "11. Thematic Depth",
      max: 5,
      desc: "Human insight, social relevance",
    },
    {
      key: "score_impact",
      label: "12. Overall Impact",
      max: 10,
      desc: "Lasting emotional resonance",
    },
  ];

  let currentJuror: any = null;
  let competitionFilms: any[] = [];
  let jurorEvaluations: any[] = [];
  let currentMovie: any = null;
  let currentEvaluation: any = null;
  let activeFilter: string = "ALL";
  let autosaveTimer: any = null;

  const authGuard = document.getElementById("auth-guard");
  const workspace = document.getElementById("jury-workspace");
  const homeView = document.getElementById("home-view");
  const playerView = document.getElementById("player-view");
  const loginForm = document.getElementById(
    "jury-login-form",
  ) as HTMLFormElement;
  const authErr = document.getElementById("auth-err");
  const navHomeBtn = document.getElementById("nav-home-btn");
  const playerBackBtn = document.getElementById("player-back-btn");
  const rubricForm = document.getElementById("rubric-form") as HTMLFormElement;
  const openConfirmModalBtn = document.getElementById(
    "open-confirm-modal-btn",
  ) as HTMLButtonElement;
  const confirmLockBtn = document.getElementById(
    "confirm-lock-btn",
  ) as HTMLButtonElement;
  const cancelConfirmModalBtn = document.getElementById(
    "cancel-confirm-modal-btn",
  );
  const customConfirmModal = document.getElementById("custom-confirm-modal");
  const lockedNotice = document.getElementById("locked-notice");
  const submitBlock = document.getElementById("submit-block");

  // Accordion details toggle elements
  const toggleDetailsBtn = document.getElementById("toggle-details-btn");
  const collapsibleDetails = document.getElementById(
    "collapsible-film-details",
  );
  const detailsBtnLabel = document.getElementById("details-btn-label");
  const detailsBtnArrow = document.getElementById("details-btn-arrow");
  let isDetailsExpanded = false;

  toggleDetailsBtn?.addEventListener("click", () => {
    isDetailsExpanded = !isDetailsExpanded;
    if (isDetailsExpanded) {
      collapsibleDetails?.classList.remove("hidden");
      if (detailsBtnLabel) detailsBtnLabel.innerText = "Hide Film Info";
      if (detailsBtnArrow) detailsBtnArrow.classList.add("rotate-180");
    } else {
      collapsibleDetails?.classList.add("hidden");
      if (detailsBtnLabel) detailsBtnLabel.innerText = "Show Film Info";
      if (detailsBtnArrow) detailsBtnArrow.classList.remove("rotate-180");
    }
  });

  // In-App Toast Messenger
  const showToast = (message: string, isError = false) => {
    const toast = document.getElementById("toast-notification");
    const icon = document.getElementById("toast-icon");
    const text = document.getElementById("toast-message");
    if (!toast || !text || !icon) return;
    icon.innerText = isError ? "✕" : "✓";
    icon.className = isError
      ? "text-red-400 font-bold"
      : "text-emerald-400 font-bold";
    text.innerText = message;
    toast.classList.remove("hidden");
    setTimeout(() => {
      toast.classList.add("hidden");
    }, 3200);
  };

  // Render 12 Criteria input rows (Admin Brutalist Theme)
  const container = document.getElementById("criteria-form-container");
  if (container) {
    container.innerHTML = CRITERIA.map(
      (c) => `
      <div class="bg-white border-2 border-black rounded-xl p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
        <div>
          <h4 class="text-xs font-black uppercase text-[#18181B]">${c.label}</h4>
          <span class="text-[10px] text-zinc-500 font-sans font-bold block">${c.desc}</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0 self-end sm:self-auto">
          <input type="number" name="${c.key}" min="0" max="${c.max}" placeholder="—" class="rubric-input w-16 bg-zinc-50 border-2 border-black rounded-lg p-2 text-center text-sm font-black text-[#18181B] focus:border-[#B31D12] focus:outline-none transition-colors" />
          <span class="text-xs text-zinc-400 font-black">/ ${c.max}</span>
        </div>
      </div>
    `,
    ).join("");
  }

  // Session Authentication Check
  const checkSession = async () => {
    const {
      data: { session },
    } = await supabase.auth.getSession();

    if (session) {
      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", session.user.id)
        .single();

      if (profile && profile.is_active) {
        currentJuror = profile;
        document.getElementById("juror-name-badge")!.innerText =
          profile.full_name;
        authGuard?.classList.add("hidden");
        workspace?.classList.remove("hidden");
        showHomeView();
        await loadAcceptedFilms();
      } else {
        await supabase.auth.signOut();
        showError("Account is inactive or restricted.");
      }
    } else {
      authGuard?.classList.remove("hidden");
      workspace?.classList.add("hidden");
    }
  };

  const showError = (msg: string) => {
    if (authErr) {
      authErr.innerText = msg;
      authErr.classList.remove("hidden");
    }
  };

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    authErr?.classList.add("hidden");

    const email = (
      document.getElementById("jury-email") as HTMLInputElement
    ).value.trim();
    const password = (document.getElementById("jury-pwd") as HTMLInputElement)
      .value;
    const btn = document.getElementById("jury-auth-btn") as HTMLButtonElement;

    btn.disabled = true;
    btn.innerText = "Authenticating...";

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      showError(error.message);
      btn.disabled = false;
      btn.innerText = "Enter Screening Room →";
    } else {
      await checkSession();
      btn.disabled = false;
      btn.innerText = "Enter Screening Room →";
    }
  });

  document
    .getElementById("jury-signout-btn")
    ?.addEventListener("click", async () => {
      await supabase.auth.signOut();
      location.reload();
    });

  const showHomeView = () => {
    homeView?.classList.remove("hidden");
    playerView?.classList.add("hidden");
    const videoFrame = document.getElementById(
      "video-frame",
    ) as HTMLIFrameElement;
    if (videoFrame) videoFrame.src = "";
  };

  const showPlayerView = () => {
    homeView?.classList.add("hidden");
    playerView?.classList.remove("hidden");
    window.scrollTo({ top: 0, behavior: "smooth" });
  };

  navHomeBtn?.addEventListener("click", showHomeView);
  playerBackBtn?.addEventListener("click", showHomeView);

  // Load Data
  const loadAcceptedFilms = async () => {
    const [filmsRes, evalsRes] = await Promise.all([
      supabase
        .from("submissions")
        .select("*")
        .eq("status", "Accepted")
        .order("created_at", { ascending: true }),
      supabase.from("evaluations").select("*").eq("jury_id", currentJuror.id),
    ]);

    competitionFilms = filmsRes.data || [];
    jurorEvaluations = evalsRes.data || [];

    updateMetrics();
    renderHomeMovies();
  };

  const updateMetrics = () => {
    const total = competitionFilms.length;
    const completed = jurorEvaluations.filter((e) => e.is_submitted).length;
    const pending = total - completed;

    document.getElementById("stat-total-assigned")!.innerText =
      total.toString();
    document.getElementById("stat-completed")!.innerText = completed.toString();
    document.getElementById("stat-pending")!.innerText = pending.toString();
  };

  const renderHomeMovies = () => {
    const tbody = document.getElementById("home-movies-tbody");
    if (!tbody) return;

    const query =
      (document.getElementById("top-search-bar") as HTMLInputElement)?.value
        .toLowerCase()
        .trim() || "";
    const evalMap = new Map(jurorEvaluations.map((e) => [e.submission_id, e]));

    const filtered = competitionFilms.filter((film) => {
      const evaluation = evalMap.get(film.id);
      const isCompleted = evaluation?.is_submitted;
      const isInProgress =
        evaluation && !isCompleted && evaluation.status === "In Progress";

      let statusStr = "Pending";
      if (isCompleted) statusStr = "Completed";
      else if (isInProgress) statusStr = "In Progress";

      const matchesFilter =
        activeFilter === "ALL" || statusStr === activeFilter;
      const matchesSearch =
        !query ||
        film.film_title?.toLowerCase().includes(query) ||
        film.director_full_name?.toLowerCase().includes(query) ||
        film.genre?.toLowerCase().includes(query) ||
        film.entry_number?.toLowerCase().includes(query);

      return matchesFilter && matchesSearch;
    });

    document.getElementById("results-count")!.innerText =
      `${filtered.length} Films`;

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-zinc-500 font-bold">No competition films found.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered
      .map((movie) => {
        const evaluation = evalMap.get(movie.id);
        const isCompleted = evaluation?.is_submitted;
        const isInProgress =
          evaluation && !isCompleted && evaluation.status === "In Progress";

        let statusBadge = `<span class="px-2.5 py-1 rounded bg-zinc-200 text-zinc-600 border border-zinc-300 text-[9px] font-black uppercase">Yet to Start</span>`;
        if (isCompleted) {
          statusBadge = `<span class="px-2.5 py-1 rounded bg-emerald-100 text-emerald-900 border border-emerald-400 text-[9px] font-black uppercase">✓ Completed</span>`;
        } else if (isInProgress) {
          statusBadge = `<span class="px-2.5 py-1 rounded bg-amber-100 text-amber-900 border border-amber-400 text-[9px] font-black uppercase">In Progress</span>`;
        }

        let displayScore = "—";
        if (isCompleted && evaluation) {
          let computed = 0;
          CRITERIA.forEach((c) => {
            computed += Number(evaluation[c.key] || 0);
          });
          displayScore = `${computed} / 100`;
        }

        return `
          <tr class="hover:bg-zinc-50 transition-colors text-xs text-[#18181B]">
            <td class="p-3 sm:p-3.5 border-r border-zinc-200 font-bold text-[#B31D12] select-all">${movie.entry_number}</td>
            <td class="p-3 sm:p-3.5 border-r border-zinc-200">
              <div class="font-black text-[#18181B] text-sm truncate max-w-[180px] sm:max-w-[260px] uppercase">${movie.film_title}</div>
              <span class="text-[10px] text-zinc-500 font-normal font-sans">${movie.genre || "Short Film"} &bull; ${movie.film_language}</span>
            </td>
            <td class="p-3 sm:p-3.5 border-r border-zinc-200 font-bold hidden sm:table-cell">${movie.director_full_name}</td>
            <td class="p-3 sm:p-3.5 border-r border-zinc-200 hidden md:table-cell font-sans">${movie.duration_minutes} Mins</td>
            <td class="p-3 sm:p-3.5 border-r border-zinc-200 text-center">${statusBadge}</td>
            <td class="p-3 sm:p-3.5 border-r border-zinc-200 text-center font-black ${isCompleted ? "text-emerald-700" : "text-zinc-400"}">
              ${displayScore}
            </td>
            <td class="p-3 sm:p-3.5 text-center">
              <button type="button" data-id="${movie.id}" class="play-movie-btn px-3 py-1.5 rounded-lg border-2 border-black ${isCompleted ? "bg-zinc-200 text-[#18181B] hover:bg-zinc-300" : "bg-[#B31D12] text-white hover:bg-black"} font-black text-[10px] uppercase transition-colors cursor-pointer inline-flex items-center gap-1 shadow-[2px_2px_0px_0px_#000000]">
                <span>▶</span> ${isCompleted ? "Review" : "Watch"}
              </button>
            </td>
          </tr>
        `;
      })
      .join("");

    document.querySelectorAll(".play-movie-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = parseInt(
          (e.currentTarget as HTMLElement).getAttribute("data-id") || "0",
          10,
        );
        openPlayerScreen(id);
      });
    });
  };

  document.querySelectorAll(".filter-chip").forEach((chip) => {
    chip.addEventListener("click", (e) => {
      activeFilter =
        (e.currentTarget as HTMLElement).getAttribute("data-filter") || "ALL";
      document.querySelectorAll(".filter-chip").forEach((c) => {
        c.className =
          "filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] hover:bg-zinc-300 border-2 border-transparent rounded-md shrink-0 transition-colors";
      });
      (e.currentTarget as HTMLElement).className =
        "filter-chip px-3 py-1.5 font-black uppercase bg-[#B31D12] text-white border-2 border-black rounded-md shadow-[2px_2px_0px_0px_#000000] shrink-0 transition-colors";
      renderHomeMovies();
    });
  });

  document
    .getElementById("top-search-bar")
    ?.addEventListener("input", renderHomeMovies);

  const openPlayerScreen = async (submissionId: number) => {
    currentMovie = competitionFilms.find((m) => m.id === submissionId);
    if (!currentMovie) return;

    showPlayerView();

    isDetailsExpanded = false;
    collapsibleDetails?.classList.add("hidden");
    if (detailsBtnLabel) detailsBtnLabel.innerText = "Show Film Info";
    if (detailsBtnArrow) detailsBtnArrow.classList.remove("rotate-180");

    document.getElementById("screen-entry-id")!.innerText =
      currentMovie.entry_number;
    document.getElementById("screen-film-title")!.innerText =
      currentMovie.film_title;
    document.getElementById("screen-film-language-runtime")!.innerText =
      `${currentMovie.film_language} • ${currentMovie.duration_minutes} Mins • ${currentMovie.year_of_production || 2026}`;

    document.getElementById("screen-director")!.innerText =
      currentMovie.director_full_name || "—";
    document.getElementById("screen-producer")!.innerText =
      currentMovie.producer_name || currentMovie.production_company || "—";
    document.getElementById("screen-dop")!.innerText =
      currentMovie.dop_full_name || "—";
    document.getElementById("screen-genre")!.innerText =
      currentMovie.genre || "Short Film";
    document.getElementById("screen-synopsis")!.innerText =
      currentMovie.synopsis || "No synopsis recorded.";

    const pwdBox = document.getElementById("screen-pwd-box");
    if (
      currentMovie.screener_password &&
      currentMovie.screener_password !== "None"
    ) {
      document.getElementById("screen-pwd")!.innerText =
        currentMovie.screener_password;
      pwdBox?.classList.remove("hidden");
    } else {
      pwdBox?.classList.add("hidden");
    }

    const videoFrame = document.getElementById(
      "video-frame",
    ) as HTMLIFrameElement;
    const playerPlaceholder = document.getElementById("player-placeholder");
    const screenerUrl = currentMovie.screener_url || "";

    if (screenerUrl) {
      let embedUrl = screenerUrl;

      // Convert URL into Embeddable format including Google Drive Preview Fix
      if (screenerUrl.includes("vimeo.com")) {
        const idMatch = screenerUrl.match(/vimeo\.com\/(\d+)/);
        if (idMatch)
          embedUrl = `https://player.vimeo.com/video/${idMatch[1]}?autoplay=0`;
      } else if (
        screenerUrl.includes("youtube.com") ||
        screenerUrl.includes("youtu.be")
      ) {
        const ytMatch = screenerUrl.match(
          /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/,
        );
        if (ytMatch) embedUrl = `https://www.youtube.com/embed/${ytMatch[1]}`;
      } else if (screenerUrl.includes("drive.google.com")) {
        // Extract file ID from various Google Drive URL formats
        const driveIdMatch =
          screenerUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) ||
          screenerUrl.match(/[?&]id=([a-zA-Z0-9_-]+)/);

        if (driveIdMatch && driveIdMatch[1]) {
          const fileId = driveIdMatch[1];
          // Use the /preview endpoint which allows iframe embedding for public files
          embedUrl = `https://drive.google.com/file/d/${fileId}/preview`;
        } else {
          // Fallback: try the original replace method
          embedUrl = screenerUrl.replace(/\/view.*$/, "/preview");
        }
      }

      videoFrame.src = embedUrl;
      videoFrame.classList.remove("hidden");
      playerPlaceholder?.classList.add("hidden");
    } else {
      videoFrame.src = "";
      videoFrame.classList.add("hidden");
      playerPlaceholder?.classList.remove("hidden");
      const txt = playerPlaceholder?.querySelector("p");
      if (txt) txt.innerText = "No screener link provided.";
    }

    await loadEvaluation(currentMovie.id);
  };

  const loadEvaluation = async (submissionId: number) => {
    let { data: evalData } = await supabase
      .from("evaluations")
      .select("*")
      .eq("submission_id", submissionId)
      .eq("jury_id", currentJuror.id)
      .maybeSingle();

    if (!evalData) {
      const { data: newEval } = await supabase
        .from("evaluations")
        .insert([
          {
            submission_id: submissionId,
            jury_id: currentJuror.id,
            status: "In Progress",
            started_at: new Date().toISOString(),
          },
        ])
        .select()
        .single();

      evalData = newEval;
    }

    currentEvaluation = evalData;
    populateRubricForm(currentEvaluation);
  };

  const populateRubricForm = (evaluation: any) => {
    rubricForm.reset();
    const isLocked = evaluation.is_submitted;
    const statusPill = document.getElementById("eval-status-pill")!;

    if (isLocked) {
      statusPill.innerText = "Locked 🔒";
      statusPill.className =
        "inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded bg-emerald-100 text-emerald-900 border border-emerald-400";
      lockedNotice?.classList.remove("hidden");
      submitBlock?.classList.add("hidden");
    } else {
      statusPill.innerText = "Draft";
      statusPill.className =
        "inline-block px-2.5 py-1 text-[10px] font-black uppercase rounded bg-amber-100 text-amber-900 border border-amber-400";
      lockedNotice?.classList.add("hidden");
      submitBlock?.classList.remove("hidden");
    }

    CRITERIA.forEach(({ key }) => {
      const val = evaluation[key];
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      if (input) {
        input.value = val !== null && val !== undefined ? val.toString() : "";
        input.disabled = isLocked;
        input.className = isLocked
          ? "rubric-input w-16 bg-zinc-200 border-2 border-black rounded-lg p-2 text-center text-sm font-black text-zinc-500 cursor-not-allowed"
          : "rubric-input w-16 bg-zinc-50 border-2 border-black rounded-lg p-2 text-center text-sm font-black text-[#18181B] focus:border-[#B31D12] focus:outline-none transition-colors";
      }
    });

    const generalFeedback = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    if (generalFeedback) {
      generalFeedback.value = evaluation.general_feedback || "";
      generalFeedback.disabled = isLocked;
      generalFeedback.className = isLocked
        ? "w-full bg-zinc-200 border-2 border-black rounded-lg p-3 text-xs text-zinc-600 font-sans cursor-not-allowed"
        : "w-full bg-white border-2 border-black rounded-lg p-3 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12] font-sans";
    }

    recalcScores();
  };

  const recalcScores = () => {
    let total = 0;
    let scoredCount = 0;

    CRITERIA.forEach(({ key, max }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();
      if (rawVal !== "" && rawVal !== undefined) {
        let num = parseInt(rawVal, 10);
        if (isNaN(num)) num = 0;
        if (num > max) {
          num = max;
          input.value = max.toString();
        }
        if (num < 0) {
          num = 0;
          input.value = "0";
        }
        total += num;
        scoredCount++;
      }
    });

    document.getElementById("live-total-score")!.innerText = total.toString();
    document.getElementById("rubric-progress-text")!.innerText =
      `${scoredCount} / 12 Scored`;

    return { total, scoredCount };
  };

  const triggerAutosave = () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(async () => {
      await saveDraft();
    }, 1200);
  };

  const saveDraft = async () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;

    const payload: any = {
      last_saved_at: new Date().toISOString(),
      status: "In Progress",
    };

    CRITERIA.forEach(({ key }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();
      payload[key] =
        rawVal === "" || rawVal === undefined ? null : parseInt(rawVal, 10);
    });

    const generalFeedback = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    payload.general_feedback = generalFeedback
      ? generalFeedback.value.trim()
      : null;

    const { error } = await supabase
      .from("evaluations")
      .update(payload)
      .eq("id", currentEvaluation.id);

    if (!error) showToast("Draft autosaved");
  };

  rubricForm?.addEventListener("input", () => {
    recalcScores();
    triggerAutosave();
  });

  openConfirmModalBtn?.addEventListener("click", () => {
    const { total, scoredCount } = recalcScores();
    if (scoredCount < 12) {
      showToast(`Please score all 12 criteria (${scoredCount}/12 done)`, true);
      return;
    }

    document.getElementById("confirm-modal-film-title")!.innerText =
      currentMovie.film_title;
    document.getElementById("confirm-modal-score")!.innerText =
      `${total} / 100`;
    customConfirmModal?.classList.remove("hidden");
  });

  cancelConfirmModalBtn?.addEventListener("click", () =>
    customConfirmModal?.classList.add("hidden"),
  );

  confirmLockBtn?.addEventListener("click", async () => {
    confirmLockBtn.disabled = true;
    confirmLockBtn.innerText = "Locking...";

    await saveDraft();

    const { error } = await supabase
      .from("evaluations")
      .update({
        is_submitted: true,
        status: "Completed",
        submitted_at: new Date().toISOString(),
      })
      .eq("id", currentEvaluation.id);

    confirmLockBtn.disabled = false;
    confirmLockBtn.innerText = "Confirm";
    customConfirmModal?.classList.add("hidden");

    if (error) {
      showToast(`Error locking: ${error.message}`, true);
    } else {
      currentEvaluation.is_submitted = true;
      populateRubricForm(currentEvaluation);
      await loadAcceptedFilms();
      showToast("Scores submitted and locked!");
    }
  });

  checkSession();
</script>
