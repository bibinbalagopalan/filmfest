---
// src/pages/juries.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Jury Screening Room | PSFF Season 03">
  <style is:global>
    header:not(#jury-top-bar),
    nav,
    footer {
      display: none !important;
    }

    html,
    body {
      overscroll-behavior-y: none;
      -webkit-tap-highlight-color: transparent;
      background: #b31d12;
      height: 100%;
    }

    /* Thin scrollbars */
    ::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #18181b;
      border-radius: 4px;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    button,
    .tap {
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }

    .safe-bottom {
      padding-bottom: max(env(safe-area-inset-bottom, 0px), 8px);
    }
    .safe-top {
      padding-top: env(safe-area-inset-top, 0px);
    }

    @keyframes slideUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
    .sheet-enter {
      animation: slideUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    .fade-enter {
      animation: fadeIn 0.2s ease-out;
    }

    .rubric-input {
      font-variant-numeric: tabular-nums;
    }
    .rubric-input::-webkit-outer-spin-button,
    .rubric-input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    .rubric-input[type="number"] {
      -moz-appearance: textfield;
    }

    /* ---------- DESKTOP: constrain to mobile-like column at ~60vw ---------- */
    .app-shell {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 768px) {
      .app-shell {
        /* ~60% of viewport, capped between 640px and 1100px */
        max-width: clamp(640px, 62vw, 1100px);
        box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.15);
      }
    }

    /* Video shell — never exceed available width */
    .video-shell {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
    }
    .video-shell iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* Touch-friendly stepper buttons */
    .step-btn {
      min-width: 40px;
      min-height: 40px;
    }
    .step-btn:active {
      transform: scale(0.92);
    }

    /* Line clamp utility */
    .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  </style>

  <!-- ============================================================ -->
  <!-- APP SHELL (mobile-first, capped at ~60vw on desktop)         -->
  <!-- ============================================================ -->
  <div
    class="app-shell relative bg-[#B31D12] text-[#FDFCF7] font-mono selection:bg-[#FDB813] selection:text-[#B31D12] overflow-x-hidden"
  >
    <!-- Background accents (inside shell) -->
    <div
      class="fixed inset-0 pointer-events-none opacity-10 overflow-hidden z-0"
    >
      <div
        class="absolute top-0 left-0 right-0 h-3 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 14px 14px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-3 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 14px 14px;"
      >
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 1. LOGIN                                                     -->
    <!-- ============================================================ -->
    <div
      id="auth-guard"
      class="min-h-[100dvh] flex items-center justify-center p-4 relative z-10"
    >
      <div
        class="w-full max-w-sm bg-[#FDFCF7] text-[#18181B] border-2 border-black p-6 rounded-2xl shadow-[6px_6px_0px_0px_#000000] space-y-5"
      >
        <div
          class="border-b-2 border-black/10 pb-4 flex items-center justify-between gap-3"
        >
          <div>
            <span
              class="text-[10px] font-black uppercase text-[#B31D12] tracking-widest block"
              >PSFF Season 03</span
            >
            <h1 class="text-lg font-black uppercase tracking-tight mt-0.5">
              Jury Portal
            </h1>
            <p class="text-[11px] text-zinc-600 font-sans mt-0.5">
              Sign in with authorized credentials.
            </p>
          </div>
          <div
            class="h-11 w-11 bg-[#B31D12] border-2 border-black rounded-xl p-1 flex items-center justify-center shrink-0"
          >
            <img
              src="https://i.ibb.co/0R0xXBmN/logo-2.png"
              alt="PSFF"
              class="h-full w-auto object-contain"
            />
          </div>
        </div>

        <form id="jury-login-form" class="space-y-4">
          <div class="space-y-1.5">
            <label
              class="block font-bold uppercase tracking-wider text-[#18181B] text-[11px]"
              >Email</label
            >
            <input
              type="email"
              id="jury-email"
              required
              autocomplete="email"
              inputmode="email"
              class="w-full bg-white border-2 border-black rounded-lg p-3 text-sm text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              placeholder="jury@psff.in"
            />
          </div>
          <div class="space-y-1.5">
            <label
              class="block font-bold uppercase tracking-wider text-[#18181B] text-[11px]"
              >Password</label
            >
            <input
              type="password"
              id="jury-pwd"
              required
              autocomplete="current-password"
              class="w-full bg-white border-2 border-black rounded-lg p-3 text-sm text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              placeholder="••••••••"
            />
          </div>
          <div
            id="auth-err"
            class="hidden p-3 bg-red-100 border border-[#B31D12] text-[#B31D12] font-bold text-[11px] rounded-lg"
          >
          </div>
          <button
            type="submit"
            id="jury-auth-btn"
            class="w-full py-3.5 font-black uppercase tracking-widest text-[#FDFCF7] bg-[#B31D12] border-2 border-black rounded-xl hover:bg-black transition-colors cursor-pointer shadow-[3px_3px_0px_0px_#000000] text-xs"
          >
            Enter Screening Room &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 2. WORKSPACE                                                 -->
    <!-- ============================================================ -->
    <div
      id="jury-workspace"
      class="hidden flex-1 relative z-10 flex flex-col w-full"
    >
      <!-- ------------- TOP APP BAR ------------- -->
      <header
        id="jury-top-bar"
        class="sticky top-0 z-40 bg-[#FDFCF7] text-[#18181B] border-b-2 border-black shadow-sm safe-top"
      >
        <div class="flex items-center justify-between gap-2 px-3 py-2.5">
          <button
            type="button"
            id="nav-home-btn"
            class="flex items-center gap-2 min-w-0 text-left focus:outline-none"
          >
            <div
              class="h-8 w-8 bg-[#B31D12] border-2 border-black rounded-lg p-0.5 flex items-center justify-center shrink-0"
            >
              <img
                src="https://i.ibb.co/0R0xXBmN/logo-2.png"
                alt="PSFF"
                class="h-full w-auto object-contain"
              />
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <span
                  class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                <span
                  class="text-[9px] font-bold uppercase text-[#B31D12] tracking-widest"
                  >Screening</span
                >
              </div>
              <span
                class="text-sm font-black uppercase tracking-tight truncate block leading-tight"
                >Jury Dashboard</span
              >
            </div>
          </button>

          <div class="flex items-center gap-2 shrink-0">
            <span
              id="juror-name-badge"
              class="hidden sm:block font-black text-[#18181B] truncate max-w-[100px] uppercase text-[10px] bg-zinc-100 px-2 py-1 rounded-md border-2 border-black"
              >Juror</span
            >
            <button
              type="button"
              id="jury-signout-btn"
              aria-label="Sign out"
              class="h-8 w-8 bg-[#B31D12] text-white border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000] flex items-center justify-center"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                ></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Search (hidden on player view) -->
        <div id="mobile-search-wrap" class="px-3 pb-2.5">
          <div class="relative w-full">
            <input
              type="search"
              id="top-search-bar"
              placeholder="Search films, directors..."
              inputmode="search"
              class="w-full bg-white border-2 border-black rounded-xl py-2 pl-9 pr-3 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12] placeholder:text-zinc-500"
            />
            <svg
              class="w-3.5 h-3.5 text-zinc-500 absolute left-3 top-1/2 -translate-y-1/2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </header>

      <!-- ------------- VIEW 1: HOME ------------- -->
      <main id="home-view" class="flex-1 w-full px-3 py-3 space-y-3 pb-8">
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-2">
          <div
            class="bg-[#FDFCF7] border-2 border-black p-2.5 rounded-xl shadow-[3px_3px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span class="text-[9px] text-zinc-600 uppercase font-bold block"
              >Assigned</span
            >
            <span
              id="stat-total-assigned"
              class="text-base font-black mt-0.5 block">0</span
            >
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-2.5 rounded-xl shadow-[3px_3px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span class="text-[9px] text-emerald-700 uppercase font-bold block"
              >Done</span
            >
            <span
              id="stat-completed"
              class="text-base font-black text-emerald-700 mt-0.5 block">0</span
            >
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-2.5 rounded-xl shadow-[3px_3px_0px_0px_#000000] text-[#18181B] text-center"
          >
            <span class="text-[9px] text-[#B31D12] uppercase font-bold block"
              >Pending</span
            >
            <span
              id="stat-pending"
              class="text-base font-black text-[#B31D12] mt-0.5 block">0</span
            >
          </div>
        </div>

        <!-- Filters -->
        <div
          class="flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar -mx-3 px-3"
        >
          <button
            type="button"
            data-filter="ALL"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-[#B31D12] text-white border-2 border-black rounded-full shadow-[2px_2px_0px_0px_#000000] shrink-0 transition-colors text-[10px]"
            >All</button
          >
          <button
            type="button"
            data-filter="Pending"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] border-2 border-transparent rounded-full shrink-0 transition-colors text-[10px]"
            >Yet to Start</button
          >
          <button
            type="button"
            data-filter="In Progress"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] border-2 border-transparent rounded-full shrink-0 transition-colors text-[10px]"
            >In Progress</button
          >
          <button
            type="button"
            data-filter="Completed"
            class="filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] border-2 border-transparent rounded-full shrink-0 transition-colors text-[10px]"
            >Completed 🔒</button
          >
        </div>

        <div class="flex items-center justify-between">
          <h2
            class="text-xs font-black uppercase tracking-wider text-[#FDFCF7]"
          >
            Competition Queue
          </h2>
          <span
            id="results-count"
            class="text-[10px] text-[#FDFCF7]/80 font-bold">0 Films</span
          >
        </div>

        <!-- Film cards -->
        <div id="home-movies-list" class="space-y-2.5">
          <div
            class="bg-[#FDFCF7] border-2 border-black rounded-2xl p-6 text-center text-zinc-500 font-bold text-xs shadow-[4px_4px_0px_0px_#000000]"
          >
            Loading competition films...
          </div>
        </div>
      </main>

      <!-- ------------- VIEW 2: PLAYER ------------- -->
      <main id="player-view" class="hidden flex-1 w-full pb-24">
        <!-- Sticky video -->
        <div id="player-shell" class="sticky top-0 z-30 bg-black">
          <div class="video-shell">
            <div
              id="player-placeholder"
              class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 space-y-2"
            >
              <span class="text-zinc-600 text-4xl block">▶</span>
              <p
                class="text-[11px] text-zinc-400 font-mono font-bold uppercase tracking-widest"
              >
                Loading Film Stream
              </p>
            </div>
            <iframe
              id="video-frame"
              class="hidden"
              allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
              allowfullscreen
              referrerpolicy="no-referrer"></iframe>

            <button
              type="button"
              id="player-back-btn"
              aria-label="Back"
              class="absolute top-2.5 left-2.5 z-20 h-8 w-8 rounded-full bg-black/70 backdrop-blur border border-white/20 text-white flex items-center justify-center hover:bg-black transition-colors"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
            </button>

            <div
              id="screen-entry-id"
              class="absolute top-2.5 right-2.5 z-20 px-2 py-0.5 rounded-md bg-black/70 backdrop-blur border border-white/20 text-white text-[9px] font-black uppercase tracking-widest"
            >
              PSFF26-XXXX
            </div>
          </div>
        </div>

        <!-- Scrollable content -->
        <div class="bg-[#FDFCF7] text-[#18181B]">
          <!-- Title block -->
          <div class="px-3.5 pt-3.5 pb-3 border-b-2 border-black/10">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0 flex-1">
                <h1
                  id="screen-film-title"
                  class="text-base font-black uppercase tracking-tight leading-tight line-clamp-2"
                >
                  Film Title
                </h1>
                <div
                  class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 mt-1 text-[10px] font-mono font-bold text-zinc-600"
                >
                  <span id="screen-film-language-runtime"
                    >Malayalam • 15 Mins</span
                  >
                  <span class="text-zinc-400">•</span>
                  <span id="screen-genre-inline">Short Film</span>
                </div>
              </div>
              <button
                type="button"
                id="toggle-details-btn"
                aria-label="Toggle info"
                class="shrink-0 h-8 w-8 rounded-full bg-zinc-100 border-2 border-black flex items-center justify-center shadow-[2px_2px_0px_0px_#000000]"
              >
                <span
                  id="details-btn-arrow"
                  class="transition-transform duration-200 font-sans text-xs"
                  >&darr;</span
                >
              </button>
            </div>

            <!-- Status row -->
            <div class="flex items-center gap-2 mt-2.5 flex-wrap">
              <span
                id="eval-status-pill"
                class="inline-block px-2 py-0.5 text-[9px] font-black uppercase rounded-full bg-amber-100 text-amber-900 border border-amber-400"
                >Draft</span
              >
              <span
                id="rubric-progress-text"
                class="text-[10px] font-black text-[#B31D12] uppercase tracking-wider"
                >0 / 12 Scored</span
              >
              <span class="ml-auto inline-flex items-baseline gap-1">
                <span
                  id="live-total-score"
                  class="text-base font-black text-[#B31D12] leading-none"
                  >0</span
                >
                <span class="text-[9px] font-bold text-zinc-500">/ 100</span>
              </span>
            </div>
          </div>

          <!-- Collapsible info -->
          <div
            id="collapsible-film-details"
            class="hidden px-3.5 py-3 border-b-2 border-black/10 space-y-2.5 fade-enter"
          >
            <div class="grid grid-cols-2 gap-2 text-[11px]">
              <div class="bg-white p-2 rounded-lg border-2 border-black">
                <span class="text-[8px] text-zinc-500 uppercase block font-bold"
                  >Director</span
                >
                <strong
                  id="screen-director"
                  class="text-[10px] block truncate mt-0.5">—</strong
                >
              </div>
              <div class="bg-white p-2 rounded-lg border-2 border-black">
                <span class="text-[8px] text-zinc-500 uppercase block font-bold"
                  >Producer</span
                >
                <strong
                  id="screen-producer"
                  class="text-[10px] block truncate mt-0.5">—</strong
                >
              </div>
              <div class="bg-white p-2 rounded-lg border-2 border-black">
                <span class="text-[8px] text-zinc-500 uppercase block font-bold"
                  >DoP</span
                >
                <strong
                  id="screen-dop"
                  class="text-[10px] block truncate mt-0.5">—</strong
                >
              </div>
              <div class="bg-white p-2 rounded-lg border-2 border-black">
                <span class="text-[8px] text-zinc-500 uppercase block font-bold"
                  >Genre</span
                >
                <strong
                  id="screen-genre"
                  class="text-[10px] block truncate mt-0.5">—</strong
                >
              </div>
            </div>
            <div
              id="screen-pwd-box"
              class="hidden bg-amber-100 p-2 rounded-lg border-2 border-amber-400"
            >
              <span class="text-[8px] text-amber-800 uppercase block font-bold"
                >Screener Password</span
              >
              <strong
                id="screen-pwd"
                class="text-[11px] block font-mono select-all mt-0.5"
                >None</strong
              >
            </div>
            <div
              class="bg-zinc-50 p-2.5 rounded-lg border-2 border-black space-y-1"
            >
              <span
                class="text-[9px] font-black text-[#B31D12] uppercase block tracking-wider"
                >Synopsis</span
              >
              <p id="screen-synopsis" class="leading-relaxed font-sans text-xs">
                No synopsis provided.
              </p>
            </div>
          </div>

          <!-- Rubric -->
          <form id="rubric-form" class="px-3.5 py-3.5 space-y-2.5">
            <div class="flex items-center justify-between mb-1">
              <h2 class="text-xs font-black uppercase text-[#18181B]">
                Jury Evaluation Rubric
              </h2>
              <span class="text-[9px] text-zinc-500 font-bold uppercase"
                >12 Criteria</span
              >
            </div>

            <div id="criteria-form-container" class="space-y-2"></div>

            <div
              class="bg-zinc-50 border-2 border-black rounded-xl p-3 space-y-1.5"
            >
              <label
                class="block text-[10px] font-black uppercase text-[#18181B]"
                >General Remarks</label
              >
              <textarea
                name="general_feedback"
                rows="3"
                placeholder="Enter remarks, critiques..."
                class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12] font-sans"
              ></textarea>
            </div>

            <div id="submit-block" class="pt-2 space-y-1.5">
              <button
                type="button"
                id="open-confirm-modal-btn"
                class="w-full py-3.5 bg-[#B31D12] hover:bg-black text-white font-black uppercase tracking-widest text-[11px] border-2 border-black rounded-xl transition-colors cursor-pointer shadow-[4px_4px_0px_0px_#000000] disabled:opacity-50"
              >
                Submit &amp; Lock Scores &rarr;
              </button>
              <p
                class="text-[9px] text-zinc-500 font-bold text-center uppercase tracking-wider"
              >
                Drafts autosave as you score
              </p>
            </div>
          </form>

          <div
            id="locked-notice"
            class="hidden mx-3.5 mb-4 p-3 bg-emerald-50 border-2 border-emerald-600 rounded-xl text-emerald-900 text-[11px] font-mono font-bold"
          >
            ✓ Evaluation locked. Marks cannot be modified without admin
            assistance.
          </div>
        </div>
      </main>

      <!-- Sticky bottom bar (player only) -->
      <div
        id="player-bottom-bar"
        class="hidden fixed bottom-0 left-1/2 -translate-x-1/2 w-full md:max-w-[clamp(640px,62vw,1100px)] z-40 bg-[#18181B] border-t-2 border-black safe-bottom"
      >
        <div class="flex items-center justify-between gap-2 px-3 py-2">
          <div class="text-white">
            <div
              class="text-[8px] uppercase tracking-widest text-zinc-400 font-bold"
            >
              Total
            </div>
            <div class="flex items-baseline gap-1">
              <span
                id="bottom-live-score"
                class="text-lg font-black leading-none">0</span
              >
              <span class="text-[9px] text-zinc-400 font-bold">/ 100</span>
            </div>
          </div>
          <button
            type="button"
            id="open-confirm-modal-btn-2"
            class="flex-1 max-w-[200px] py-2.5 bg-[#B31D12] hover:bg-black text-white font-black uppercase tracking-wider text-[10px] border-2 border-white/20 rounded-xl transition-colors cursor-pointer shadow-[3px_3px_0px_0px_#000000]"
          >
            Submit &amp; Lock →
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 3. CONFIRM MODAL                                             -->
    <!-- ============================================================ -->
    <div
      id="custom-confirm-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center"
    >
      <div
        class="w-full md:max-w-sm bg-[#FDFCF7] border-2 border-black rounded-t-3xl sm:rounded-2xl p-5 space-y-4 font-mono text-center text-[#18181B] sheet-enter safe-bottom sm:shadow-[8px_8px_0px_0px_#000000]"
      >
        <div
          class="w-11 h-11 bg-amber-100 text-amber-700 rounded-xl flex items-center justify-center mx-auto border-2 border-black text-lg font-bold"
        >
          🔒
        </div>
        <div class="space-y-1">
          <h3 class="text-sm font-black uppercase">Lock Evaluation?</h3>
          <p
            id="confirm-modal-film-title"
            class="text-[11px] font-bold text-zinc-600 truncate"
          >
            Movie Title
          </p>
          <p class="text-[11px] text-[#18181B] pt-1.5">
            Total Marks:<br /><strong
              id="confirm-modal-score"
              class="text-xl font-black text-[#B31D12]">0/100</strong>
          </p>
          <p
            class="text-[10px] text-zinc-500 pt-2 font-sans font-bold leading-relaxed border-t-2 border-black/10 mt-2 pt-2.5"
          >
            Once submitted, marks are official and locked.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <button
            type="button"
            id="cancel-confirm-modal-btn"
            class="py-3 bg-zinc-200 border-2 border-black text-[#18181B] text-[11px] font-black uppercase rounded-xl cursor-pointer"
            >Cancel</button
          >
          <button
            type="button"
            id="confirm-lock-btn"
            class="py-3 bg-[#B31D12] text-white text-[11px] font-black uppercase border-2 border-black rounded-xl cursor-pointer shadow-[3px_3px_0px_0px_#000000]"
            >Confirm</button
          >
        </div>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- 4. TOAST                                                     -->
    <!-- ============================================================ -->
    <div
      id="toast-notification"
      class="hidden fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-[#18181B] border-2 border-black text-white px-4 py-2.5 rounded-xl shadow-[4px_4px_0px_0px_#B31D12] text-[11px] font-mono font-bold flex items-center gap-2 max-w-[85vw]"
    >
      <span id="toast-icon">✓</span>
      <span id="toast-message">Action completed</span>
    </div>
  </div>
</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const CRITERIA = [
    {
      key: "score_concept",
      label: "1. Concept / Premise",
      max: 10,
      desc: "Clarity, premise strength, originality",
    },
    {
      key: "score_originality",
      label: "2. Originality",
      max: 10,
      desc: "Fresh cinematic voice",
    },
    {
      key: "score_screenplay",
      label: "3. Screenplay / Structure",
      max: 15,
      desc: "Pacing, scene dynamics",
    },
    {
      key: "score_direction",
      label: "4. Direction",
      max: 15,
      desc: "Directorial control",
    },
    {
      key: "score_characterization",
      label: "5. Characterization & Acting",
      max: 10,
      desc: "Performances, authenticity",
    },
    {
      key: "score_cinematography",
      label: "6. Cinematography",
      max: 10,
      desc: "Framing, lighting",
    },
    {
      key: "score_editing",
      label: "7. Editing & Pacing",
      max: 10,
      desc: "Rhythm, transitions",
    },
    {
      key: "score_sound",
      label: "8. Sound Design & Foley",
      max: 8,
      desc: "Audio clarity, mixing",
    },
    {
      key: "score_production_design",
      label: "9. Production Design",
      max: 4,
      desc: "Locations, art direction",
    },
    {
      key: "score_music",
      label: "10. Music & Score",
      max: 3,
      desc: "Atmosphere, score",
    },
    {
      key: "score_thematic_depth",
      label: "11. Thematic Depth",
      max: 5,
      desc: "Insight, relevance",
    },
    {
      key: "score_impact",
      label: "12. Overall Impact",
      max: 10,
      desc: "Emotional resonance",
    },
  ];

  let currentJuror: any = null;
  let competitionFilms: any[] = [];
  let jurorEvaluations: any[] = [];
  let currentMovie: any = null;
  let currentEvaluation: any = null;
  let activeFilter: string = "ALL";
  let autosaveTimer: any = null;
  let isDetailsExpanded = false;

  const $ = (id: string) => document.getElementById(id);

  const authGuard = $("auth-guard");
  const workspace = $("jury-workspace");
  const homeView = $("home-view");
  const playerView = $("player-view");
  const loginForm = $("jury-login-form") as HTMLFormElement;
  const authErr = $("auth-err");
  const navHomeBtn = $("nav-home-btn");
  const playerBackBtn = $("player-back-btn");
  const rubricForm = $("rubric-form") as HTMLFormElement;
  const openConfirmModalBtn = $("open-confirm-modal-btn") as HTMLButtonElement;
  const openConfirmModalBtn2 = $(
    "open-confirm-modal-btn-2",
  ) as HTMLButtonElement;
  const confirmLockBtn = $("confirm-lock-btn") as HTMLButtonElement;
  const cancelConfirmModalBtn = $("cancel-confirm-modal-btn");
  const customConfirmModal = $("custom-confirm-modal");
  const lockedNotice = $("locked-notice");
  const submitBlock = $("submit-block");
  const playerBottomBar = $("player-bottom-bar");
  const mobileSearchWrap = $("mobile-search-wrap");
  const toggleDetailsBtn = $("toggle-details-btn");
  const collapsibleDetails = $("collapsible-film-details");
  const detailsBtnArrow = $("details-btn-arrow");

  // ---------- Toast ----------
  const showToast = (message: string, isError = false) => {
    const toast = $("toast-notification");
    const icon = $("toast-icon");
    const text = $("toast-message");
    if (!toast || !text || !icon) return;
    icon.innerText = isError ? "✕" : "✓";
    icon.className = isError
      ? "text-red-400 font-bold"
      : "text-emerald-400 font-bold";
    text.innerText = message;
    toast.classList.remove("hidden");
    setTimeout(() => toast.classList.add("hidden"), 3200);
  };

  // ---------- Details ----------
  toggleDetailsBtn?.addEventListener("click", () => {
    isDetailsExpanded = !isDetailsExpanded;
    collapsibleDetails?.classList.toggle("hidden", !isDetailsExpanded);
    detailsBtnArrow?.classList.toggle("rotate-180", isDetailsExpanded);
  });

  // ---------- Criteria render ----------
  const container = $("criteria-form-container");
  if (container) {
    container.innerHTML = CRITERIA.map(
      (c) => `
      <div class="bg-white border-2 border-black rounded-xl p-2.5 shadow-sm">
        <div class="flex items-start gap-2">
          <div class="min-w-0 flex-1">
            <h4 class="text-[11px] font-black uppercase text-[#18181B] leading-tight">${c.label}</h4>
            <span class="text-[9px] text-zinc-500 font-sans font-bold block mt-0.5 leading-snug">${c.desc}</span>
          </div>
          <span class="text-[9px] text-zinc-400 font-black shrink-0 pt-1">/${c.max}</span>
        </div>
        <div class="flex items-center gap-1.5 mt-2">
          <button type="button" data-step="-1" data-target="${c.key}"
            class="step-btn h-10 w-10 rounded-lg bg-zinc-100 border-2 border-black font-black text-[#18181B] text-base flex items-center justify-center shadow-[2px_2px_0px_0px_#000000]">−</button>
          <input type="number" name="${c.key}" min="0" max="${c.max}" placeholder="—" inputmode="numeric"
            class="rubric-input flex-1 h-10 bg-zinc-50 border-2 border-black rounded-lg p-0 text-center text-sm font-black text-[#18181B] focus:border-[#B31D12] focus:outline-none transition-colors" />
          <button type="button" data-step="1" data-target="${c.key}"
            class="step-btn h-10 w-10 rounded-lg bg-zinc-100 border-2 border-black font-black text-[#18181B] text-base flex items-center justify-center shadow-[2px_2px_0px_0px_#000000]">+</button>
        </div>
      </div>
    `,
    ).join("");

    container
      .querySelectorAll<HTMLButtonElement>(".step-btn")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-target");
          const step = parseInt(btn.getAttribute("data-step") || "0", 10);
          if (!target) return;
          const input = rubricForm.elements.namedItem(
            target,
          ) as HTMLInputElement;
          if (!input || input.disabled) return;
          const max = parseInt(input.getAttribute("max") || "100", 10);
          const cur = parseInt(input.value || "0", 10) || 0;
          let next = cur + step;
          if (next < 0) next = 0;
          if (next > max) next = max;
          input.value = String(next);
          recalcScores();
          triggerAutosave();
        });
      });
  }

  // ---------- Session ----------
  const checkSession = async () => {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (session) {
      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", session.user.id)
        .single();
      if (profile && profile.is_active) {
        currentJuror = profile;
        ($("juror-name-badge") as HTMLElement).innerText = profile.full_name;
        authGuard?.classList.add("hidden");
        workspace?.classList.remove("hidden");
        showHomeView();
        await loadAcceptedFilms();
      } else {
        await supabase.auth.signOut();
        showError("Account is inactive or restricted.");
      }
    } else {
      authGuard?.classList.remove("hidden");
      workspace?.classList.add("hidden");
    }
  };

  const showError = (msg: string) => {
    if (authErr) {
      authErr.innerText = msg;
      authErr.classList.remove("hidden");
    }
  };

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    authErr?.classList.add("hidden");
    const email = ($("jury-email") as HTMLInputElement).value.trim();
    const password = ($("jury-pwd") as HTMLInputElement).value;
    const btn = $("jury-auth-btn") as HTMLButtonElement;
    btn.disabled = true;
    btn.innerText = "Authenticating...";
    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });
    if (error) {
      showError(error.message);
      btn.disabled = false;
      btn.innerText = "Enter Screening Room →";
    } else {
      await checkSession();
      btn.disabled = false;
      btn.innerText = "Enter Screening Room →";
    }
  });

  $("jury-signout-btn")?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    location.reload();
  });

  const showHomeView = () => {
    homeView?.classList.remove("hidden");
    playerView?.classList.add("hidden");
    playerBottomBar?.classList.add("hidden");
    mobileSearchWrap?.classList.remove("hidden");
    const videoFrame = $("video-frame") as HTMLIFrameElement;
    if (videoFrame) videoFrame.src = "";
    window.scrollTo({ top: 0 });
  };

  const showPlayerView = () => {
    homeView?.classList.add("hidden");
    playerView?.classList.remove("hidden");
    playerBottomBar?.classList.remove("hidden");
    mobileSearchWrap?.classList.add("hidden");
    window.scrollTo({ top: 0 });
  };

  navHomeBtn?.addEventListener("click", showHomeView);
  playerBackBtn?.addEventListener("click", showHomeView);

  // ---------- Data ----------
  const loadAcceptedFilms = async () => {
    const [filmsRes, evalsRes] = await Promise.all([
      supabase
        .from("submissions")
        .select("*")
        .eq("status", "Accepted")
        .order("created_at", { ascending: true }),
      supabase.from("evaluations").select("*").eq("jury_id", currentJuror.id),
    ]);
    competitionFilms = filmsRes.data || [];
    jurorEvaluations = evalsRes.data || [];
    updateMetrics();
    renderHomeMovies();
  };

  const updateMetrics = () => {
    const total = competitionFilms.length;
    const completed = jurorEvaluations.filter((e) => e.is_submitted).length;
    ($("stat-total-assigned") as HTMLElement).innerText = total.toString();
    ($("stat-completed") as HTMLElement).innerText = completed.toString();
    ($("stat-pending") as HTMLElement).innerText = (
      total - completed
    ).toString();
  };

  const renderHomeMovies = () => {
    const list = $("home-movies-list");
    if (!list) return;
    const query =
      ($("top-search-bar") as HTMLInputElement)?.value.toLowerCase().trim() ||
      "";
    const evalMap = new Map(jurorEvaluations.map((e) => [e.submission_id, e]));

    const filtered = competitionFilms.filter((film) => {
      const ev = evalMap.get(film.id);
      const isCompleted = ev?.is_submitted;
      const isInProgress = ev && !isCompleted && ev.status === "In Progress";
      let statusStr = "Pending";
      if (isCompleted) statusStr = "Completed";
      else if (isInProgress) statusStr = "In Progress";
      const matchesFilter =
        activeFilter === "ALL" || statusStr === activeFilter;
      const matchesSearch =
        !query ||
        film.film_title?.toLowerCase().includes(query) ||
        film.director_full_name?.toLowerCase().includes(query) ||
        film.genre?.toLowerCase().includes(query) ||
        film.entry_number?.toLowerCase().includes(query);
      return matchesFilter && matchesSearch;
    });

    ($("results-count") as HTMLElement).innerText = `${filtered.length} Films`;

    if (filtered.length === 0) {
      list.innerHTML = `<div class="bg-[#FDFCF7] border-2 border-black rounded-2xl p-6 text-center text-zinc-500 font-bold text-xs shadow-[4px_4px_0px_0px_#000000]">No films found.</div>`;
      return;
    }

    list.innerHTML = filtered
      .map((movie) => {
        const ev = evalMap.get(movie.id);
        const isCompleted = ev?.is_submitted;
        const isInProgress = ev && !isCompleted && ev.status === "In Progress";

        let statusBadge = `<span class="px-1.5 py-0.5 rounded-full bg-zinc-200 text-zinc-600 border border-zinc-300 text-[8px] font-black uppercase">Yet to Start</span>`;
        if (isCompleted)
          statusBadge = `<span class="px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-900 border border-emerald-400 text-[8px] font-black uppercase">✓ Done</span>`;
        else if (isInProgress)
          statusBadge = `<span class="px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-400 text-[8px] font-black uppercase">In Progress</span>`;

        let scoreLabel = isCompleted
          ? "Review"
          : isInProgress
            ? "Resume"
            : "Watch";
        if (isCompleted && ev) {
          let computed = 0;
          CRITERIA.forEach((c) => {
            computed += Number(ev[c.key] || 0);
          });
          scoreLabel = `${computed}/100`;
        }

        return `
        <button type="button" data-id="${movie.id}"
          class="play-movie-btn w-full text-left bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-2.5 shadow-[4px_4px_0px_0px_#000000] flex gap-2.5 items-stretch hover:bg-white transition-colors">
          <div class="w-16 h-16 rounded-xl border-2 border-black bg-[#B31D12] flex items-center justify-center shrink-0">
            <img src="https://i.ibb.co/0R0xXBmN/logo-2.png" alt="" class="h-8 w-auto opacity-90" />
          </div>
          <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
            <div>
              <div class="flex items-center gap-1.5 mb-0.5 flex-wrap">
                <span class="text-[9px] font-black text-[#B31D12] uppercase tracking-widest">${movie.entry_number}</span>
                ${statusBadge}
              </div>
              <div class="font-black text-[#18181B] text-[12px] leading-tight line-clamp-2 uppercase">${movie.film_title}</div>
              <div class="text-[10px] text-zinc-500 font-sans mt-0.5 truncate">${movie.director_full_name || "—"}</div>
            </div>
            <div class="flex items-center justify-between mt-1">
              <span class="text-[9px] text-zinc-500 font-bold font-sans">${movie.duration_minutes || "—"} Mins</span>
              <span class="inline-flex items-center gap-1 text-[10px] font-black uppercase text-[#B31D12]">
                ${scoreLabel} <span>›</span>
              </span>
            </div>
          </div>
        </button>
      `;
      })
      .join("");

    document.querySelectorAll(".play-movie-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = parseInt(
          (e.currentTarget as HTMLElement).getAttribute("data-id") || "0",
          10,
        );
        openPlayerScreen(id);
      });
    });
  };

  // ---------- Filters ----------
  document.querySelectorAll(".filter-chip").forEach((chip) => {
    chip.addEventListener("click", (e) => {
      activeFilter =
        (e.currentTarget as HTMLElement).getAttribute("data-filter") || "ALL";
      document.querySelectorAll(".filter-chip").forEach((c) => {
        c.className =
          "filter-chip px-3 py-1.5 font-black uppercase bg-zinc-200 text-[#18181B] border-2 border-transparent rounded-full shrink-0 transition-colors text-[10px]";
      });
      (e.currentTarget as HTMLElement).className =
        "filter-chip px-3 py-1.5 font-black uppercase bg-[#B31D12] text-white border-2 border-black rounded-full shadow-[2px_2px_0px_0px_#000000] shrink-0 transition-colors text-[10px]";
      renderHomeMovies();
    });
  });

  $("top-search-bar")?.addEventListener("input", renderHomeMovies);

  // ---------- Open player ----------
  const openPlayerScreen = async (submissionId: number) => {
    currentMovie = competitionFilms.find((m) => m.id === submissionId);
    if (!currentMovie) return;

    showPlayerView();

    isDetailsExpanded = false;
    collapsibleDetails?.classList.add("hidden");
    detailsBtnArrow?.classList.remove("rotate-180");

    ($("screen-entry-id") as HTMLElement).innerText = currentMovie.entry_number;
    ($("screen-film-title") as HTMLElement).innerText = currentMovie.film_title;
    ($("screen-film-language-runtime") as HTMLElement).innerText =
      `${currentMovie.film_language || ""} • ${currentMovie.duration_minutes || "—"} Mins • ${currentMovie.year_of_production || 2026}`;
    ($("screen-genre-inline") as HTMLElement).innerText =
      currentMovie.genre || "Short Film";
    ($("screen-director") as HTMLElement).innerText =
      currentMovie.director_full_name || "—";
    ($("screen-producer") as HTMLElement).innerText =
      currentMovie.producer_name || currentMovie.production_company || "—";
    ($("screen-dop") as HTMLElement).innerText =
      currentMovie.dop_full_name || "—";
    ($("screen-genre") as HTMLElement).innerText =
      currentMovie.genre || "Short Film";
    ($("screen-synopsis") as HTMLElement).innerText =
      currentMovie.synopsis || "No synopsis recorded.";

    const pwdBox = $("screen-pwd-box");
    if (
      currentMovie.screener_password &&
      currentMovie.screener_password !== "None"
    ) {
      ($("screen-pwd") as HTMLElement).innerText =
        currentMovie.screener_password;
      pwdBox?.classList.remove("hidden");
    } else {
      pwdBox?.classList.add("hidden");
    }

    const videoFrame = $("video-frame") as HTMLIFrameElement;
    const playerPlaceholder = $("player-placeholder");
    const screenerUrl = currentMovie.screener_url || "";

    if (screenerUrl) {
      let embedUrl = screenerUrl;
      if (screenerUrl.includes("vimeo.com")) {
        const m = screenerUrl.match(/vimeo\.com\/(\d+)/);
        if (m) embedUrl = `https://player.vimeo.com/video/${m[1]}?autoplay=0`;
      } else if (
        screenerUrl.includes("youtube.com") ||
        screenerUrl.includes("youtu.be")
      ) {
        const m = screenerUrl.match(
          /(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/,
        );
        if (m)
          embedUrl = `https://www.youtube.com/embed/${m[1]}?rel=0&modestbranding=1&playsinline=1`;
      } else if (screenerUrl.includes("drive.google.com")) {
        const m =
          screenerUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) ||
          screenerUrl.match(/[?&]id=([a-zA-Z0-9_-]+)/);
        if (m && m[1])
          embedUrl = `https://drive.google.com/file/d/${m[1]}/preview`;
        else embedUrl = screenerUrl.replace(/\/view.*$/, "/preview");
      }
      videoFrame.src = embedUrl;
      videoFrame.classList.remove("hidden");
      playerPlaceholder?.classList.add("hidden");
    } else {
      videoFrame.src = "";
      videoFrame.classList.add("hidden");
      playerPlaceholder?.classList.remove("hidden");
      const txt = playerPlaceholder?.querySelector("p");
      if (txt) txt.innerText = "No screener link provided.";
    }

    await loadEvaluation(currentMovie.id);
  };

  const loadEvaluation = async (submissionId: number) => {
    let { data: evalData } = await supabase
      .from("evaluations")
      .select("*")
      .eq("submission_id", submissionId)
      .eq("jury_id", currentJuror.id)
      .maybeSingle();

    if (!evalData) {
      const { data: newEval } = await supabase
        .from("evaluations")
        .insert([
          {
            submission_id: submissionId,
            jury_id: currentJuror.id,
            status: "In Progress",
            started_at: new Date().toISOString(),
          },
        ])
        .select()
        .single();
      evalData = newEval;
    }
    currentEvaluation = evalData;
    populateRubricForm(currentEvaluation);
  };

  const populateRubricForm = (evaluation: any) => {
    rubricForm.reset();
    const isLocked = evaluation.is_submitted;
    const statusPill = $("eval-status-pill")!;

    if (isLocked) {
      statusPill.innerText = "Locked 🔒";
      statusPill.className =
        "inline-block px-2 py-0.5 text-[9px] font-black uppercase rounded-full bg-emerald-100 text-emerald-900 border border-emerald-400";
      lockedNotice?.classList.remove("hidden");
      submitBlock?.classList.add("hidden");
      playerBottomBar?.classList.add("hidden");
    } else {
      statusPill.innerText = "Draft";
      statusPill.className =
        "inline-block px-2 py-0.5 text-[9px] font-black uppercase rounded-full bg-amber-100 text-amber-900 border border-amber-400";
      lockedNotice?.classList.add("hidden");
      submitBlock?.classList.remove("hidden");
      playerBottomBar?.classList.remove("hidden");
    }

    CRITERIA.forEach(({ key }) => {
      const val = evaluation[key];
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      if (input) {
        input.value = val !== null && val !== undefined ? val.toString() : "";
        input.disabled = isLocked;
      }
    });

    document.querySelectorAll<HTMLButtonElement>(".step-btn").forEach((b) => {
      b.disabled = isLocked;
      b.classList.toggle("opacity-40", isLocked);
      b.classList.toggle("cursor-not-allowed", isLocked);
    });

    const gf = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    if (gf) {
      gf.value = evaluation.general_feedback || "";
      gf.disabled = isLocked;
    }

    recalcScores();
  };

  const recalcScores = () => {
    let total = 0,
      scoredCount = 0;
    CRITERIA.forEach(({ key, max }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();
      if (rawVal !== "" && rawVal !== undefined) {
        let num = parseInt(rawVal, 10);
        if (isNaN(num)) num = 0;
        if (num > max) {
          num = max;
          input.value = max.toString();
        }
        if (num < 0) {
          num = 0;
          input.value = "0";
        }
        total += num;
        scoredCount++;
      }
    });
    const live = $("live-total-score");
    const bottomLive = $("bottom-live-score");
    if (live) live.innerText = total.toString();
    if (bottomLive) bottomLive.innerText = total.toString();
    ($("rubric-progress-text") as HTMLElement).innerText =
      `${scoredCount} / 12 Scored`;
    return { total, scoredCount };
  };

  const triggerAutosave = () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;
    clearTimeout(autosaveTimer);
    autosaveTimer = setTimeout(async () => {
      await saveDraft();
    }, 1200);
  };

  const saveDraft = async () => {
    if (!currentEvaluation || currentEvaluation.is_submitted) return;
    const payload: any = {
      last_saved_at: new Date().toISOString(),
      status: "In Progress",
    };
    CRITERIA.forEach(({ key }) => {
      const input = rubricForm.elements.namedItem(key) as HTMLInputElement;
      const rawVal = input?.value?.trim();
      payload[key] =
        rawVal === "" || rawVal === undefined ? null : parseInt(rawVal, 10);
    });
    const gf = rubricForm.elements.namedItem(
      "general_feedback",
    ) as HTMLTextAreaElement;
    payload.general_feedback = gf ? gf.value.trim() : null;
    const { error } = await supabase
      .from("evaluations")
      .update(payload)
      .eq("id", currentEvaluation.id);
    if (!error) showToast("Draft autosaved");
  };

  rubricForm?.addEventListener("input", () => {
    recalcScores();
    triggerAutosave();
  });

  // ---------- Confirm & Lock ----------
  const openConfirm = () => {
    const { total, scoredCount } = recalcScores();
    if (scoredCount < 12) {
      showToast(`Score all 12 criteria (${scoredCount}/12 done)`, true);
      return;
    }
    ($("confirm-modal-film-title") as HTMLElement).innerText =
      currentMovie.film_title;
    ($("confirm-modal-score") as HTMLElement).innerText = `${total} / 100`;
    customConfirmModal?.classList.remove("hidden");
  };

  openConfirmModalBtn?.addEventListener("click", openConfirm);
  openConfirmModalBtn2?.addEventListener("click", openConfirm);
  cancelConfirmModalBtn?.addEventListener("click", () =>
    customConfirmModal?.classList.add("hidden"),
  );

  confirmLockBtn?.addEventListener("click", async () => {
    confirmLockBtn.disabled = true;
    confirmLockBtn.innerText = "Locking...";
    await saveDraft();
    const { error } = await supabase
      .from("evaluations")
      .update({
        is_submitted: true,
        status: "Completed",
        submitted_at: new Date().toISOString(),
      })
      .eq("id", currentEvaluation.id);
    confirmLockBtn.disabled = false;
    confirmLockBtn.innerText = "Confirm";
    customConfirmModal?.classList.add("hidden");
    if (error) {
      showToast(`Error: ${error.message}`, true);
    } else {
      currentEvaluation.is_submitted = true;
      populateRubricForm(currentEvaluation);
      await loadAcceptedFilms();
      showToast("Scores locked!");
    }
  });

  checkSession();
</script>
