---
// src/pages/jury.astro
import Layout from "../layouts/Layout.astro";

const mainJuries = [
  {
    slug: "sherry-govindan",
    name: "Sherry Govindan",
    role: "Chief Jury",
    designation: "Filmmaker",
    image: "https://i.ibb.co/j9nP0PKK/director-1311202512-56-01.jpg",
    isPlaceholder: false,
    highlights: [
      "National Film Award (2011) — Special Mention for Best Director",
      "Kerala State Film Award (2011) — Best Debut Director",
      "Jury Member — International Film Festival of Kerala (IFFK)",
      "Selection Jury Member — 49th Kerala State Film Awards",
      "Former Executive Member — Kerala State Chalachitra Academy",
    ],
    bio: "Sherry Govindan is an Indian filmmaker whose works have received prominent state and national honours. Known for his independent cinematic practice, he leads the evaluation committee for Season 03.",
  },
  {
    slug: "arjun-k",
    name: "Arjun K",
    role: "Jury Member",
    designation: "Filmmaker & Film Critic",
    image: "https://i.ibb.co/mrhXq0PB/0e8b1e52-f84a-476e-8204-badc6373b8ef.jpg",
    isPlaceholder: false,
    highlights: [
      "Director — K-Pop (2025)",
      "Director — Dialogues on Emancipation (2023)",
      "Festival Programmer — Independent & Experimental Film Festival of Kerala",
      "Film History Faculty — New Wave Film School",
      "Published Critic — Chalachitra Sameeksha & Drishyathalam",
    ],
    bio: "Arjun K is a filmmaker and writer working across fiction, documentary, and experimental forms. He contributes regularly to contemporary film theory and programming in Kerala.",
  },
  {
    slug: "sanath-pc",
    name: "Sanath PC",
    role: "Festival Patron",
    designation: "Visual Effects Designer, Coordinator and Supervisor",
    image: "https://i.ibb.co/HDbc53tc/28-BGMSANATH2.jpg",
    isPlaceholder: false,
    highlights: [
      "Distinguished industry professional",
      "Evaluation committee member for official selections",
      "Co-Founder of the Visual effects company Firefly Creative Studio",
      "Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category (Oscars)",
      "National Film Award for Best Special Effects (2004)",
      "VFX Supervisor of Kalki, Bahubali, Malik, Pulimurugan, Robot etc.,",
    ],
    bio: "Sanath Pilleri Chelleri professionally credited as P. C. Sanath is an Indian visual effects designer, coordinator and supervisor known for his works primarily in Telugu, Tamil and Malayalam cinema. Sanath is Co-Founder of the Visual effects company Firefly Creative Studio. Sanath is the Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category.",
  },
];

const screeningPanel = [
  "Sunith KP",
  "Arun EV",
  "A. Ajayakumar",
  "Dr. Mridulal",
  "Vinodkumar SJ",
  "Bibin Balagopal",
  "Thomas Sevior",
  "Latheesh Prabhakar",
  "Sooraj H",
  "Rajesh Kambatty",
  "Rajeesh",
  "Vishnu K",
];
---

<Layout title="Jury & Screening Panel | PSFF Season 03">
  <div class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-4 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden">
    
    <!-- Background Frame Accents -->
    <div class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden">
      <div 
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>
      <div 
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      ></div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      ></div>
      <svg class="absolute -left-20 top-20 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8" />
      </svg>
      <svg class="absolute -right-24 bottom-24 w-[480px] h-[480px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6" />
      </svg>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Page Header -->
      <header class="border-b border-[#FDB813]/30 pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-200">
          <a href="/" class="hover:text-[#FDB813] transition-colors">&larr; Home</a>
          <span>&bull;</span>
          <span class="text-[#FDB813] font-bold">Adjudication</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white font-mono leading-none drop-shadow-sm">
          Jury &amp; Screening Panel 
        </h1>
        <p class="font-mono text-sm sm:text-base text-zinc-200 max-w-3xl leading-relaxed">
          The official selection committee responsible for shortlisting submissions and the main jury evaluating competitive festival awards .
        </p>
      </header>

      <!-- Section 1: Main Award Jury (High-Contrast Cards) -->
      <section class="space-y-8">
        <div class="border-b border-[#FDB813]/30 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono">
            Main Jury Panel 
          </h2>
          <span class="font-mono text-xs uppercase text-[#FDB813] font-bold">
            Awards Evaluation Committee 
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch font-mono">
          {mainJuries.map((jury) => (
            <article class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl shadow-[6px_6px_0px_0px_#000000] p-6 flex flex-col justify-between h-full group hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_#FDB813] transition-all">
              
              <div class="space-y-5">
                <!-- Portrait Frame -->
                <a
                  href={`/jury/${jury.slug}`}
                  class="block relative border-2 border-black rounded-xl h-[320px] bg-[#18181B] p-2 overflow-hidden shadow-inner"
                >
                  <img
                    src={jury.image}
                    alt={jury.name}
                    class="w-full h-full object-contain filter grayscale contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-300"
                    loading="lazy"
                  />
                  <div class="absolute bottom-3 left-3 bg-[#B31D12] text-white font-mono text-[10px] font-black px-2.5 py-1 uppercase tracking-wider rounded border border-[#FDB813]/60 shadow-md">
                    {jury.role} 
                  </div>
                </a>

                <!-- Details -->
                <div class="space-y-3">
                  <div class="border-b-2 border-black/10 pb-3">
                    <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#18181B] font-mono group-hover:text-[#B31D12] transition-colors">
                      <a href={`/jury/${jury.slug}`}>
                        {jury.name} 
                      </a>
                    </h3>
                    <p class="font-mono text-xs uppercase tracking-wider text-[#B31D12] font-black mt-1">
                      {jury.designation} 
                    </p>
                  </div>

                  <p class="text-xs text-zinc-700 leading-relaxed font-sans line-clamp-3">
                    {jury.bio} 
                  </p>

                  <!-- Key Highlights -->
                  <div class="pt-2">
                    <span class="block font-mono text-[10px] uppercase tracking-widest text-zinc-500 font-bold mb-2">
                      Key Highlights 
                    </span>
                    <div class="border-l-2 border-[#B31D12] pl-3 py-0.5 space-y-1.5">
                      {jury.highlights.slice(0, 3).map((item) => (
                        <div class="text-xs font-mono leading-snug truncate text-zinc-800 font-medium">
                          &bull; {item} 
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Button Link -->
              <div class="pt-5 mt-4 border-t-2 border-black/10">
                <a
                  href={`/jury/${jury.slug}`}
                  class="inline-flex items-center justify-between w-full py-2.5 px-4 rounded-lg bg-[#B31D12] hover:bg-black text-[#FDFCF7] text-xs font-black uppercase tracking-wider transition-all"
                >
                  <span>Read Full Profile </span>
                  <span class="font-sans text-sm">&rarr;</span>
                </a>
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Section 2: Preliminary Screening Panel -->
      <section class="space-y-6 font-mono">
        <div class="border-b border-[#FDB813]/30 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#FDB813] block mb-1">
              Phase 01 Review 
            </span>
            <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono">
              Initial Screening Panel 
            </h2>
          </div>
          <span class="text-xs uppercase text-zinc-200 font-bold">
            Selection &amp; Shortlist Committee 
          </span>
        </div>

        <p class="text-xs sm:text-sm text-zinc-200 leading-relaxed max-w-3xl">
          All entries submitted online are reviewed and evaluated by the internal screening panel to determine the official selection screened at the festival venue .
        </p>

        <div class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000]">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-xs sm:text-sm">
            {screeningPanel.map((member, idx) => (
              <div class="flex items-center gap-3 border-l-4 border-[#B31D12] pl-3 py-2.5 bg-zinc-100 rounded-r-lg">
                <span class="font-bold text-[#B31D12]">
                  {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}. 
                </span>
                <span class="font-black text-[#18181B] uppercase tracking-tight font-mono">
                  {member} 
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Submission Info Callout -->
      <div class="border-2 border-black bg-[#8B140B] text-[#FDFCF7] p-8 sm:p-10 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-6 shadow-[6px_6px_0px_0px_#000000] font-mono">
        <div class="space-y-1">
          <h3 class="text-xl sm:text-2xl font-black uppercase text-white font-mono">
            Submit Your Film for Evaluation 
          </h3>
          <p class="text-xs text-zinc-200">
            Films under 30 minutes completed between Sep 2023 and Aug 2026 .
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3.5 text-xs font-black uppercase tracking-wider text-[#B31D12] bg-[#FDB813] hover:bg-white rounded-lg transition-all shadow-[2px_2px_0px_0px_#000000] hover:-translate-y-0.5 cursor-pointer"
        >
          Submit Film &rarr; 
        </a>
      </div>

    </div>
  </div>
</Layout>