---
// src/pages/jury.astro
import Layout from "../layouts/Layout.astro";

const mainJuries = [
  {
    name: "Sherry Govindan",
    role: "Chief Jury",
    designation: "Filmmaker",
    image: "https://i.ibb.co/j9nP0PKK/director-1311202512-56-01.jpg",
    isPlaceholder: false,
    highlights: [
      "National Film Award (2011) — Special Mention for Best Director",
      "Kerala State Film Award (2011) — Best Debut Director",
      "Jury Member — International Film Festival of Kerala (IFFK)",
      "Selection Jury Member — 49th Kerala State Film Awards",
      "Former Executive Member — Kerala State Chalachitra Academy",
    ],
    bio: "Sherry Govindan is an Indian filmmaker whose works have received prominent state and national honours. Known for his independent cinematic practice, he leads the evaluation committee for Season 03.",
  },
  {
    name: "Arjun K",
    role: "Jury Member",
    designation: "Filmmaker & Film Critic",
    image: "https://i.ibb.co/mrhXq0PB/0e8b1e52-f84a-476e-8204-badc6373b8ef.jpg",
    isPlaceholder: false,
    highlights: [
      "Director — K-Pop (2025)",
      "Director — Dialogues on Emancipation (2023)",
      "Festival Programmer — Independent & Experimental Film Festival of Kerala",
      "Film History Faculty — New Wave Film School",
      "Published Critic — Chalachitra Sameeksha & Drishyathalam",
    ],
    bio: "Arjun K is a filmmaker and writer working across fiction, documentary, and experimental forms. He contributes regularly to contemporary film theory and programming in Kerala.",
  },
  {
    name: "Sanath PC",
    role: "Festival Patron",
    designation: " Visual Effects Designer, Coordinator and Supervisor",
    image: "https://i.ibb.co/HDbc53tc/28-BGMSANATH2.jpg",
    isPlaceholder: false,
    highlights: [
      "Distinguished industry professional",
      "Evaluation committee member for official selections",
      "Co-Founder of the Visual effects company Firefly Creative Studio",
      "Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category.",
      " National Film Award for Best Special Effects (2004)"
    ],
    bio: "Sanath Pilleri Chelleri professionally credited as P. C. Sanath is an Indian visual effects designer, coordinator and supervisor known for his works primarily in Telugu, Tamil and Malayalam cinema. Sanath is Co-Founder of the Visual effects company Firefly Creative Studio. Sanath is the Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category.",
  },
];

const screeningPanel = [
  "Sunith KP",
  "Arun EV",
  "A. Ajayakumar",
  "Dr. Mridulal",
  "Vinodkumar SJ",
  "Bibin Balagopal",
  "Thomas Sevior",
  "Latheesh Prabhakar",
  "Sooraj H",
  "Rajesh Kambatty",
  "Rajeesh",
  "Vishnu K",
];
---

<Layout title="Jury & Screening Panel | PSFF Season 03">
  <div class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]">
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500">
          <a href="/" class="hover:text-[#D9381E] transition-colors">&larr; Home</a>
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Adjudication</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none">
          Jury &amp; Screening Panel
        </h1>
        <p class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed">
          The official selection committee responsible for shortlisting submissions and the main jury evaluating competitive festival awards.
        </p>
      </header>

      <!-- Section 1: Main Award Jury -->
      <section class="space-y-8">
        <div class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
            Main Jury Panel
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Awards Evaluation Committee
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 items-start">
          {mainJuries.map((jury) => (
            <article class="border-2 border-[#161616] bg-[#F6F4EE] p-6 shadow-[5px_5px_0px_0px_#161616] space-y-6 flex flex-col justify-between">
              
              <!-- Image / Placeholder -->
              <div class={`relative border-2 border-[#161616] h-[340px] bg-[#161616] p-1.5 flex items-center justify-center overflow-hidden ${jury.isPlaceholder ? 'border-dashed bg-zinc-100' : ''}`}>
                {jury.isPlaceholder ? (
                  <div class="flex flex-col items-center justify-center p-6 text-center font-mono text-zinc-400">
                    <span class="text-5xl font-light mb-2">?</span>
                    <span class="text-xs font-bold uppercase tracking-wider text-zinc-500">Announcement Pending</span>
                  </div>
                ) : (
                  <img
                    src={jury.image}
                    alt={jury.name}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                )}

                <div class="absolute bottom-3 left-3 bg-[#161616] text-[#F6F4EE] border border-zinc-700 font-mono text-[11px] font-bold px-2.5 py-1 uppercase tracking-wider">
                  {jury.role}
                </div>
              </div>

              <!-- Profile Details -->
              <div class="space-y-4">
                <div class="border-b border-zinc-300 pb-3">
                  <h3 class={`text-xl sm:text-2xl font-black uppercase tracking-tight ${jury.isPlaceholder ? 'text-zinc-500' : 'text-[#161616]'}`}>
                    {jury.name}
                  </h3>
                  <p class="font-mono text-xs uppercase tracking-wider text-[#D9381E] font-bold mt-1">
                    {jury.designation}
                  </p>
                </div>

                <p class="text-xs sm:text-sm text-zinc-700 leading-relaxed font-mono">
                  {jury.bio}
                </p>

                <!-- Key Highlights -->
                <div class="pt-2">
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-zinc-500 font-bold mb-2">
                    Key Highlights
                  </span>
                  <div class="border-l-2 border-[#161616] pl-3 py-0.5 space-y-1.5">
                    {jury.highlights.map((item) => (
                      <div class={`text-xs font-mono leading-snug ${jury.isPlaceholder ? 'text-zinc-500 italic' : 'text-zinc-900 font-medium'}`}>
                        &bull; {item}
                      </div>
                    ))}
                  </div>
                </div>
              </div>

            </article>
          ))}
        </div>
      </section>

      <!-- Section 2: Preliminary Screening Panel -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <div>
            <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E] block mb-1">
              Phase 01 Review
            </span>
            <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
              Initial Screening Panel
            </h2>
          </div>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Selection &amp; Shortlist Committee
          </span>
        </div>

        <p class="font-mono text-xs sm:text-sm text-zinc-700 leading-relaxed max-w-3xl">
          All entries submitted online are reviewed and evaluated by the internal screening panel to determine the official selection screened at the festival venue.
        </p>

        <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#161616]">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 font-mono text-xs sm:text-sm">
            {screeningPanel.map((member, idx) => (
              <div class="flex items-center gap-3 border-l-4 border-[#161616] pl-3 py-2 bg-white/60">
                <span class="font-bold text-[#D9381E]">
                  {idx + 1 < 10 ? `0${idx + 1}` : idx + 1}.
                </span>
                <span class="font-bold text-[#161616] uppercase tracking-tight">
                  {member}
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Submission Info Callout -->
      <div class="border-2 border-[#161616] bg-[#161616] text-[#F6F4EE] p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="text-xl sm:text-2xl font-black uppercase text-white">
            Submit Your Film for Evaluation
          </h3>
          <p class="font-mono text-xs text-zinc-400">
            
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3.5 text-xs font-mono font-black uppercase tracking-wider text-[#161616] bg-[#F6F4EE] hover:bg-[#D9381E] hover:text-white transition-all shadow-[3px_3px_0px_0px_#D9381E]"
        >
          Submit Film &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>