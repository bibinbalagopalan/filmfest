<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const copyBtn = document.getElementById("copy-upi-btn");
  const upiText = document.getElementById("upi-text")?.innerText.trim();

  copyBtn?.addEventListener("click", async () => {
    if (!upiText) return;
    try {
      await navigator.clipboard.writeText(upiText);
      copyBtn.innerText = "Copied!";
      setTimeout(() => {
        copyBtn.innerText = "Copy";
      }, 2000);
    } catch {}
  });

  const form = document.getElementById(
    "festival-submission-form",
  ) as HTMLFormElement;
  const statusBox = document.getElementById("submission-status");
  const submitBtn = document.getElementById(
    "submit-form-btn",
  ) as HTMLButtonElement;
  const receiptContainer = document.getElementById("receipt-container");
  const pageHeader = document.getElementById("submission-header");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!statusBox || !submitBtn || !receiptContainer) return;

    submitBtn.disabled = true;
    submitBtn.innerText = "Processing Submission & Uploading Receipt...";
    statusBox.classList.add("hidden");

    try {
      const formData = new FormData(form);
      const randomSuffix = Math.floor(1000 + Math.random() * 9000);
      const entry_number = `PSFF26-${randomSuffix}`;

      const filmTitle = formData.get("film_title")?.toString().trim() || "";
      const directorName =
        formData.get("director_full_name")?.toString().trim() || "";
      const directorEmail =
        formData.get("director_email")?.toString().trim() || "";
      const submissionDate = new Date().toLocaleDateString("en-GB", {
        day: "2-digit",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });

      // 1. Upload Payment Screenshot to Supabase Storage Bucket
      let paymentScreenshotUrl = "";
      const fileInput = document.getElementById(
        "payment_screenshot",
      ) as HTMLInputElement;

      if (fileInput?.files && fileInput.files[0]) {
        const file = fileInput.files[0];
        const fileExt = file.name.split(".").pop()?.toLowerCase() || "png";
        const cleanFileName = `${entry_number}_receipt.${fileExt}`.replace(
          /[^a-zA-Z0-9._-]/g,
          "_",
        );

        const { error: uploadError } = await supabase.storage
          .from("receipts")
          .upload(cleanFileName, file, {
            cacheControl: "3600",
            upsert: true,
            contentType: file.type || "image/png",
          });

        if (uploadError) {
          throw new Error(`Receipt upload failed: ${uploadError.message}`);
        }

        const { data: publicUrlData } = supabase.storage
          .from("receipts")
          .getPublicUrl(cleanFileName);

        paymentScreenshotUrl = publicUrlData.publicUrl;
      }

      // 2. Insert Film Record into Submissions Table
      const { error: insertError } = await supabase.from("submissions").insert([
        {
          entry_number,
          payment_ref: formData.get("payment_ref")?.toString().trim(),
          payment_screenshot_url: paymentScreenshotUrl,
          film_title: filmTitle,
          genre: formData.get("genre")?.toString().trim(),
          film_language: formData.get("film_language")?.toString().trim(),
          country_of_origin:
            formData.get("country_of_origin")?.toString().trim() || "India",
          duration_minutes: parseInt(
            formData.get("duration_minutes")?.toString() || "0",
            10,
          ),
          year_of_production: parseInt(
            formData.get("year_of_production")?.toString() || "2026",
            10,
          ),
          premiere_status:
            formData.get("premiere_status")?.toString().trim() || "None",
          poster_url: formData.get("poster_url")?.toString().trim(),
          synopsis: formData.get("synopsis")?.toString().trim(),
          screener_url: formData.get("screener_url")?.toString().trim(),
          screener_password:
            formData.get("screener_password")?.toString().trim() || "None",
          subtitles_available: formData
            .get("subtitles_available")
            ?.toString()
            .trim(),
          subtitle_language: formData
            .get("subtitle_language")
            ?.toString()
            .trim(),
          aspect_ratio: formData.get("aspect_ratio")?.toString().trim(),
          resolution_format: formData
            .get("resolution_format")
            ?.toString()
            .trim(),
          director_full_name: directorName,
          director_pro_name: formData
            .get("director_pro_name")
            ?.toString()
            .trim(),
          director_email: directorEmail,
          director_phone: formData.get("director_phone")?.toString().trim(),
          director_location: formData
            .get("director_location")
            ?.toString()
            .trim(),
          director_bio: formData.get("director_bio")?.toString().trim(),
          production_company: formData
            .get("production_company")
            ?.toString()
            .trim(),
          producer_name: formData.get("producer_name")?.toString().trim(),
          producer_email: formData.get("producer_email")?.toString().trim(),
          producer_phone: formData.get("producer_phone")?.toString().trim(),
          producer_country: formData.get("producer_country")?.toString().trim(),
          dop_full_name: formData.get("dop_full_name")?.toString().trim(),
          dop_pro_name: formData.get("dop_pro_name")?.toString().trim(),
          dop_email: formData.get("dop_email")?.toString().trim(),
          dop_phone: formData.get("dop_phone")?.toString().trim(),
          dop_location: formData.get("dop_location")?.toString().trim(),
          dop_bio: formData.get("dop_bio")?.toString().trim(),
          camera_specs: formData.get("camera_specs")?.toString().trim(),
          crew_writer: formData.get("crew_writer")?.toString().trim(),
          crew_editor: formData.get("crew_editor")?.toString().trim(),
          crew_composer: formData.get("crew_composer")?.toString().trim(),
          crew_sound: formData.get("crew_sound")?.toString().trim(),
          crew_art: formData.get("crew_art")?.toString().trim(),
          crew_costume: formData.get("crew_costume")?.toString().trim(),
          crew_cast: formData.get("crew_cast")?.toString().trim(),
          rights_holder_name: formData
            .get("rights_holder_name")
            ?.toString()
            .trim(),
          legal_confirmations: {
            accuracy: formData.get("legal_accuracy") === "on",
            rights: formData.get("legal_rights") === "on",
            music: formData.get("legal_music_footage") === "on",
            participants: formData.get("legal_participants") === "on",
            screening: formData.get("legal_screening") === "on",
            promo: formData.get("legal_promo") === "on",
            photos: formData.get("legal_photos") === "on",
            rules: formData.get("legal_rules") === "on",
            infringement: formData.get("legal_infringement") === "on",
          },
        },
      ]);

      if (insertError) {
        throw new Error(insertError.message);
      }

      // Hide the entry form and header
      form.classList.add("hidden");
      if (pageHeader) pageHeader.classList.add("hidden");

      // Render the Printable Acknowledgment Receipt
      receiptContainer.classList.remove("hidden");
      receiptContainer.innerHTML = `
        <div id="printable-receipt-section" class="border-2 border-black bg-[#FDFCF7] text-[#18181B] rounded-2xl p-8 sm:p-12 shadow-[8px_8px_0px_0px_#000000] space-y-8">
          
          <!-- Receipt Header -->
          <div class="border-b-2 border-black/15 pb-6 flex flex-col sm:flex-row sm:items-start justify-between gap-4">
            <div>
              <span class="font-mono text-xs font-black uppercase tracking-widest text-[#B31D12] block">
                Official Acknowledgement Receipt
              </span>
              <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#18181B] font-mono">
                3rd Pazhassi Short Film Festival
              </h2>
              <p class="font-mono text-xs text-zinc-600 mt-0.5">
                PSFF Season 03 &bull; Mananthavady, Wayanad
              </p>
            </div>
            
            <div class="font-mono text-xs text-left sm:text-right border-t sm:border-t-0 border-black/10 pt-3 sm:pt-0">
              <div class="text-zinc-500 uppercase text-[10px] font-bold">Issued On</div>
              <div class="font-bold text-[#18181B]">${submissionDate}</div>
            </div>
          </div>

          <!-- Reference Number Box -->
          <div class="border-2 border-black rounded-xl bg-[#FDB813] text-[#18181B] p-6 text-center space-y-2 shadow-sm">
            <span class="font-mono text-xs font-black uppercase tracking-wider text-black block">
              Reference Number
            </span>
            <div class="font-mono text-3xl sm:text-4xl font-black tracking-wider text-[#B31D12] select-all">
              ${entry_number}
            </div>
            <p class="font-mono text-[11px] text-zinc-900 font-bold">
              Please ensure that the above Reference Number is quoted in all future correspondence with the Festival in relation to this submission.
            </p>
          </div>

          <!-- Submission Metadata Summary -->
          <div class="border-2 border-black/10 rounded-xl bg-white p-4 font-mono text-xs grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><span class="text-zinc-500 uppercase font-bold">Film Title:</span> <strong class="text-[#18181B] uppercase">${filmTitle}</strong></div>
            <div><span class="text-zinc-500 uppercase font-bold">Director:</span> <strong class="text-[#18181B] uppercase">${directorName}</strong></div>
            <div class="sm:col-span-2"><span class="text-zinc-500 uppercase font-bold">Registered Email:</span> <strong class="text-[#18181B]">${directorEmail}</strong></div>
          </div>

          <!-- Official Legal Confirmation Body -->
          <div class="font-serif text-sm sm:text-base text-zinc-800 leading-relaxed space-y-4">
            <p class="font-bold text-[#18181B]">
              We hereby confirm that your submission has been successfully received and provisionally accepted.
            </p>
            <p>
              An official acknowledgment of receipt will be sent to you by email within 24 hours. In the event that you do not receive the acknowledgment email within the stipulated period, please contact our Festival Director, Mr. Bibin Balagopal, at <strong class="text-[#18181B] font-mono font-bold">+91 85902 04208</strong> for further assistance.
            </p>
            <p>
              Please note that this provisional acceptance does not constitute final acceptance or confirmation of participation. The submission remains subject to review and approval by the Screening Committee, as well as confirmation of the applicable payment requirements.
            </p>
            <p>
              The Festival reserves the right to request additional information, documentation, or clarification in connection with the submission, where deemed necessary. Should any further information be required, a member of the Festival team will contact you accordingly.
            </p>
            <p class="font-semibold text-[#18181B]">
              We thank you for your submission and appreciate your interest in the Festival.
            </p>
          </div>

          <!-- Sign-off & Institutional Footer -->
          <div class="border-t-2 border-black/10 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 font-mono text-xs text-zinc-600">
            <div>
              <div class="font-black uppercase text-[#18181B]">Festival Directorate</div>
              <div>Drishtidosham Chalachithravedi</div>
              <div>Pazhassi Raja Smaraka Granthalayam</div>
            </div>
            <div class="text-[10px] uppercase text-zinc-500 text-left sm:text-right font-bold">
              Official Electronic Receipt &bull; No Signature Required
            </div>
          </div>

          <!-- Action Buttons (Hidden when printing) -->
          <div class="no-print pt-4 border-t border-black/10 flex flex-wrap gap-4 items-center justify-between font-mono">
            <button
              type="button"
              onclick="window.print()"
              class="px-6 py-3 text-xs font-black uppercase tracking-widest text-[#FDFCF7] bg-[#B31D12] hover:bg-black rounded-lg transition-all shadow-[2px_2px_0px_0px_#000000] cursor-pointer"
            >
              Print / Save Receipt (PDF) &darr;
            </button>
            <a
              href="/"
              class="text-xs font-bold uppercase tracking-wider text-[#B31D12] hover:text-black underline underline-offset-4"
            >
              Return to Home &rarr;
            </a>
          </div>

        </div>
      `;

      receiptContainer.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err: any) {
      statusBox.classList.remove("hidden");
      statusBox.classList.add("bg-white", "border-[#B31D12]", "text-[#B31D12]");
      statusBox.innerHTML = `<div>✕ Submission Failed: ${err.message || "Please check your network and entry details."}</div>`;
      submitBtn.disabled = false;
      submitBtn.innerText = "Confirm & Submit Entry Form →";
    }
  });
</script>
