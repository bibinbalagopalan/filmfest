<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const copyBtn = document.getElementById("copy-upi-btn");
  const upiText = document.getElementById("upi-text")?.innerText.trim();

  copyBtn?.addEventListener("click", async () => {
    if (!upiText) return;
    try {
      await navigator.clipboard.writeText(upiText);
      copyBtn.innerText = "Copied!";
      setTimeout(() => {
        copyBtn.innerText = "Copy";
      }, 2000);
    } catch {}
  });

  const form = document.getElementById(
    "festival-submission-form",
  ) as HTMLFormElement;
  const statusBox = document.getElementById("submission-status");
  const submitBtn = document.getElementById(
    "submit-form-btn",
  ) as HTMLButtonElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!statusBox || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.innerText = "Processing Submission & Uploading Receipt...";
    statusBox.classList.add("hidden");
    statusBox.className = "p-6 font-mono text-xs font-bold border-2 space-y-3";

    try {
      const formData = new FormData(form);
      const randomSuffix = Math.floor(1000 + Math.random() * 9000);
      const entry_number = `PSFF26-${randomSuffix}`;

      // 1. Upload Payment Screenshot to Supabase Storage Bucket
      let paymentScreenshotUrl = "";
      const fileInput = document.getElementById(
        "payment_screenshot",
      ) as HTMLInputElement;

      if (fileInput?.files && fileInput.files[0]) {
        const file = fileInput.files[0];
        const fileExt = file.name.split(".").pop()?.toLowerCase() || "png";
        const cleanFileName = `${entry_number}_receipt.${fileExt}`.replace(
          /[^a-zA-Z0-9._-]/g,
          "_",
        );

        const { error: uploadError } = await supabase.storage
          .from("receipts")
          .upload(cleanFileName, file, {
            cacheControl: "3600",
            upsert: true,
            contentType: file.type || "image/png",
          });

        if (uploadError) {
          throw new Error(`Receipt upload failed: ${uploadError.message}`);
        }

        const { data: publicUrlData } = supabase.storage
          .from("receipts")
          .getPublicUrl(cleanFileName);

        paymentScreenshotUrl = publicUrlData.publicUrl;
      }

      // 2. Insert Film Record into Submissions Table
      const { error: insertError } = await supabase.from("submissions").insert([
        {
          entry_number,
          payment_ref: formData.get("payment_ref")?.toString().trim(),
          payment_screenshot_url: paymentScreenshotUrl,
          film_title: formData.get("film_title")?.toString().trim(),
          genre: formData.get("genre")?.toString().trim(),
          film_language: formData.get("film_language")?.toString().trim(),
          country_of_origin:
            formData.get("country_of_origin")?.toString().trim() || "India",
          duration_minutes: parseInt(
            formData.get("duration_minutes")?.toString() || "0",
            10,
          ),
          year_of_production: parseInt(
            formData.get("year_of_production")?.toString() || "2026",
            10,
          ),
          premiere_status:
            formData.get("premiere_status")?.toString().trim() || "None",
          poster_url: formData.get("poster_url")?.toString().trim(),
          synopsis: formData.get("synopsis")?.toString().trim(),
          screener_url: formData.get("screener_url")?.toString().trim(),
          screener_password:
            formData.get("screener_password")?.toString().trim() || "None",
          subtitles_available: formData
            .get("subtitles_available")
            ?.toString()
            .trim(),
          subtitle_language: formData
            .get("subtitle_language")
            ?.toString()
            .trim(),
          aspect_ratio: formData.get("aspect_ratio")?.toString().trim(),
          resolution_format: formData
            .get("resolution_format")
            ?.toString()
            .trim(),
          director_full_name: formData
            .get("director_full_name")
            ?.toString()
            .trim(),
          director_pro_name: formData
            .get("director_pro_name")
            ?.toString()
            .trim(),
          director_email: formData.get("director_email")?.toString().trim(),
          director_phone: formData.get("director_phone")?.toString().trim(),
          director_location: formData
            .get("director_location")
            ?.toString()
            .trim(),
          director_bio: formData.get("director_bio")?.toString().trim(),
          production_company: formData
            .get("production_company")
            ?.toString()
            .trim(),
          producer_name: formData.get("producer_name")?.toString().trim(),
          producer_email: formData.get("producer_email")?.toString().trim(),
          producer_phone: formData.get("producer_phone")?.toString().trim(),
          producer_country: formData.get("producer_country")?.toString().trim(),
          dop_full_name: formData.get("dop_full_name")?.toString().trim(),
          dop_pro_name: formData.get("dop_pro_name")?.toString().trim(),
          dop_email: formData.get("dop_email")?.toString().trim(),
          dop_phone: formData.get("dop_phone")?.toString().trim(),
          dop_location: formData.get("dop_location")?.toString().trim(),
          dop_bio: formData.get("dop_bio")?.toString().trim(),
          camera_specs: formData.get("camera_specs")?.toString().trim(),
          crew_writer: formData.get("crew_writer")?.toString().trim(),
          crew_editor: formData.get("crew_editor")?.toString().trim(),
          crew_composer: formData.get("crew_composer")?.toString().trim(),
          crew_sound: formData.get("crew_sound")?.toString().trim(),
          crew_art: formData.get("crew_art")?.toString().trim(),
          crew_costume: formData.get("crew_costume")?.toString().trim(),
          crew_cast: formData.get("crew_cast")?.toString().trim(),
          rights_holder_name: formData
            .get("rights_holder_name")
            ?.toString()
            .trim(),
          legal_confirmations: {
            accuracy: formData.get("legal_accuracy") === "on",
            rights: formData.get("legal_rights") === "on",
            music: formData.get("legal_music_footage") === "on",
            participants: formData.get("legal_participants") === "on",
            screening: formData.get("legal_screening") === "on",
            promo: formData.get("legal_promo") === "on",
            photos: formData.get("legal_photos") === "on",
            rules: formData.get("legal_rules") === "on",
            infringement: formData.get("legal_infringement") === "on",
          },
        },
      ]);

      if (insertError) {
        throw new Error(insertError.message);
      }

      statusBox.classList.remove("hidden");
      statusBox.classList.add(
        "bg-green-100",
        "border-green-800",
        "text-green-950",
      );
      statusBox.innerHTML = `
        <div class="text-sm sm:text-base font-black uppercase text-green-900">✓ Official Entry Successfully Received</div>
        <div class="text-xs">Your Tracking Reference: <span class="bg-[#161616] text-white px-2 py-0.5 font-bold tracking-wider">${entry_number}</span></div>
        <div class="font-normal pt-1 text-zinc-700 leading-relaxed">
          Thank you for submitting your film to the 3rd Pazhassi Short Film Festival. Our selection committee is reviewing your screening materials and will contact you via your registered email address regarding selection results.
        </div>
      `;
      form.reset();
      submitBtn.innerText = "Entry Submitted Successfully";
      statusBox.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch (err: any) {
      statusBox.classList.remove("hidden");
      statusBox.classList.add(
        "bg-red-100",
        "border-[#D9381E]",
        "text-[#D9381E]",
      );
      statusBox.innerHTML = `<div>✕ Submission Failed: ${err.message || "Please check your network and entry details."}</div>`;
      submitBtn.disabled = false;
      submitBtn.innerText = "Confirm & Submit Entry Form →";
    }
  });
</script>
