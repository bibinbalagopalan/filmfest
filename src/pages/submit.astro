---
// src/pages/submit.astro
import Layout from "../layouts/Layout.astro";

const paymentQrImage =
  "https://i.ibb.co/9ms08nnm/Screenshot-2026-08-27-041814.jpg";
const officialUpiId = "sbivan.MFBANK10001001000632@sbi";
---

<Layout title="Official Film Submission Portal | PSFF Season 03">
  <style is:global>
    @media print {
      body * {
        visibility: hidden;
      }
      #printable-receipt-section,
      #printable-receipt-section * {
        visibility: visible;
      }
      #printable-receipt-section {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        margin: 0;
        padding: 20px;
        background: white !important;
        color: black !important;
        border: none !important;
        box-shadow: none !important;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>

  <div
    class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-12 sm:py-20 px-4 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
  >
    <!-- Background Frame Accents -->
    <div
      class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto space-y-10">
      <!-- Page Header -->
      <header
        id="submission-header"
        class="border-b border-[#FDB813]/30 pb-6 space-y-4"
      >
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-wider text-zinc-200"
        >
          <a href="/" class="hover:text-[#FDB813] transition-colors"
            >&larr; Home</a
          > / Submissions
        </div>

        <div>
          <h1
            class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white font-mono drop-shadow-sm"
          >
            Submit Your Film
          </h1>
          <p class="font-mono text-xs sm:text-sm text-zinc-200 mt-1">
            Official Entry Portal for the 3rd Pazhassi Short Film Festival (PSFF
            Season 03).
          </p>
        </div>
      </header>

      <!-- Helplines & Assistance Callout -->
      <div
        class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-5 sm:p-6 shadow-[6px_6px_0px_0px_#000000] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono"
      >
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#B31D12]"></span>
            <span
              class="text-xs font-black uppercase tracking-wider text-[#B31D12]"
            >
              Submission Assistance Helpline
            </span>
          </div>
          <p class="text-xs text-zinc-700 font-sans">
            For any queries regarding the filling up of this form or screener
            uploads, contact Festival Convenor:
          </p>
        </div>

        <a
          href="tel:6235134455"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-[#B31D12] text-[#FDFCF7] hover:bg-black font-mono text-xs font-black uppercase tracking-wider transition-all shadow-sm shrink-0"
        >
          <span>Vishnu K: +91 62351 34455</span>
          <span class="font-sans text-sm">&rarr;</span>
        </a>
      </div>

      <!-- SUCCESS ACKNOWLEDGEMENT RECEIPT (Rendered on Successful Submission) -->
      <div id="receipt-container" class="hidden"></div>

      <form
        id="festival-submission-form"
        class="space-y-10 font-mono text-xs"
        enctype="multipart/form-data"
      >
        <!-- SECTION 1: ENTRY FEE PAYMENT & COMPACT QR SCAN -->
        <section
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-4"
        >
          <div
            class="border-b-2 border-black/10 pb-3 flex items-center justify-between"
          >
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-black text-[#B31D12]">STEP 01</span>
              <h2
                class="text-base sm:text-lg font-black uppercase text-[#18181B] font-mono"
              >
                Entry Fee Payment (₹1,000)
              </h2>
            </div>
            <span class="text-zinc-500 uppercase text-[10px] font-black">
              Non-Refundable
            </span>
          </div>

          <div
            class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pt-2"
          >
            <div
              class="w-[180px] shrink-0 border-2 border-black bg-white rounded-xl p-3 text-center space-y-2 shadow-[3px_3px_0px_0px_#000000]"
            >
              <span
                class="text-[9px] uppercase tracking-wider text-zinc-600 font-bold block"
              >
                Scan to Pay ₹1,000
              </span>

              <div
                class="w-[140px] h-[140px] mx-auto border border-zinc-900 rounded-lg p-1 bg-white flex items-center justify-center overflow-hidden"
              >
                <img
                  src={paymentQrImage}
                  alt="UPI QR Code"
                  style="width: 130px; height: 130px; max-width: 100%; max-height: 100%; object-fit: contain;"
                  loading="eager"
                />
              </div>

              <div class="space-y-1 pt-1 border-t border-zinc-200">
                <span class="text-[8px] text-zinc-500 font-bold uppercase block"
                  >Official UPI ID</span
                >
                <div
                  class="flex items-center justify-between gap-1 bg-zinc-100 p-1 rounded border border-zinc-300"
                >
                  <code
                    id="upi-text"
                    class="text-[9px] font-black text-[#18181B] truncate select-all"
                    title={officialUpiId}
                  >
                    {officialUpiId}
                  </code>
                  <button
                    type="button"
                    id="copy-upi-btn"
                    title="Copy UPI ID"
                    class="px-1.5 py-0.5 text-[9px] uppercase font-black bg-[#B31D12] text-white hover:bg-black rounded transition-colors cursor-pointer shrink-0"
                  >
                    Copy
                  </button>
                </div>
              </div>
            </div>

            <div class="flex-1 w-full space-y-4">
              <div class="space-y-1.5">
                <label
                  for="payment_ref"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  UPI Transaction ID / UTR Number *
                </label>
                <input
                  type="text"
                  id="payment_ref"
                  name="payment_ref"
                  required
                  placeholder="e.g. 423987123456"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
                <p class="text-[10px] text-zinc-600 font-sans">
                  Enter the 12-digit transaction number provided in your payment
                  receipt.
                </p>
              </div>

              <div class="space-y-1.5">
                <label
                  for="payment_screenshot"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Upload Payment Screenshot / Receipt (Image File) *
                </label>
                <div
                  class="border-2 border-dashed border-black rounded-xl bg-white p-4 text-center space-y-1"
                >
                  <input
                    type="file"
                    id="payment_screenshot"
                    name="payment_screenshot"
                    accept="image/png, image/jpeg, image/jpg, image/webp"
                    required
                    class="w-full text-xs font-mono text-zinc-700 file:mr-3 file:py-1.5 file:px-3 file:border-2 file:border-black file:rounded-md file:text-[11px] file:font-black file:uppercase file:bg-[#FDFCF7] file:text-[#18181B] hover:file:bg-[#B31D12] hover:file:text-white file:cursor-pointer cursor-pointer"
                  />
                  <p class="text-[9px] text-zinc-500 font-sans">
                    Accepts PNG, JPG, or WEBP (Max 5MB).
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 2: FILM INFORMATION -->
        <section
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-5"
        >
          <div
            class="border-b-2 border-black/10 pb-3 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#B31D12]">STEP 02</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#18181B] font-mono"
            >
              Film Information
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="film_title"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Film Title (Original Language) *
                </label>
                <input
                  type="text"
                  id="film_title"
                  name="film_title"
                  required
                  placeholder="Original Title"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="genre"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Genre *
                </label>
                <input
                  type="text"
                  id="genre"
                  name="genre"
                  required
                  placeholder="e.g. Drama, Thriller, Comedy"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div class="space-y-1.5">
                <label
                  for="film_language"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Film Language *
                </label>
                <input
                  type="text"
                  id="film_language"
                  name="film_language"
                  required
                  value="Malayalam"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="country_of_origin"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Country of Origin *
                </label>
                <input
                  type="text"
                  id="country_of_origin"
                  name="country_of_origin"
                  required
                  value="India"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="duration_minutes"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Exact Runtime (Minutes) *
                </label>
                <input
                  type="number"
                  id="duration_minutes"
                  name="duration_minutes"
                  min="1"
                  max="30"
                  required
                  placeholder="Max 30 mins"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="year_of_production"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Production Year *
                </label>
                <input
                  type="number"
                  id="year_of_production"
                  name="year_of_production"
                  min="2023"
                  max="2026"
                  required
                  value="2026"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="premiere_status"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Premiere Status (Optional)
                </label>
                <input
                  type="text"
                  id="premiere_status"
                  name="premiere_status"
                  placeholder="e.g. World Premiere, Kerala Premiere, None"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="poster_url"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  High-Res Poster Link (Drive / Dropbox) *
                </label>
                <input
                  type="url"
                  id="poster_url"
                  name="poster_url"
                  required
                  placeholder="https://drive.google.com/..."
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label
                for="synopsis"
                class="block font-bold uppercase tracking-wider text-[#18181B]"
              >
                Film Synopsis (50 - 150 Words) *
              </label>
              <textarea
                id="synopsis"
                name="synopsis"
                rows="4"
                required
                placeholder="Narrative summary and premise of the short film..."
                class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              ></textarea>
            </div>
          </div>
        </section>

        <!-- SECTION 3: SCREENER & TECHNICAL SPECIFICATIONS -->
        <section
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-5"
        >
          <div
            class="border-b-2 border-black/10 pb-3 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#B31D12]">STEP 03</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#18181B] font-mono"
            >
              Screening Links &amp; Technical Master
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="screener_url"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Private Screener Link (Vimeo / Google Drive) *
                </label>
                <input
                  type="url"
                  id="screener_url"
                  name="screener_url"
                  required
                  placeholder="https://..."
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="screener_password"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Screening Password (if protected)
                </label>
                <input
                  type="text"
                  id="screener_password"
                  name="screener_password"
                  placeholder="Leave empty if link is open"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div class="space-y-1.5">
                <label
                  for="subtitles_available"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Subtitles Available? *
                </label>
                <select
                  id="subtitles_available"
                  name="subtitles_available"
                  required
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                >
                  <option value="Yes - English">Yes - English Subtitles</option>
                  <option value="Yes - Embedded/Burned">Yes - Burned In</option>
                  <option value="No">No Subtitles</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label
                  for="subtitle_language"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Subtitle Language
                </label>
                <input
                  type="text"
                  id="subtitle_language"
                  name="subtitle_language"
                  value="English"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="aspect_ratio"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Aspect Ratio *
                </label>
                <input
                  type="text"
                  id="aspect_ratio"
                  name="aspect_ratio"
                  required
                  placeholder="e.g. 16:9, 2.39:1"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="resolution_format"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Resolution / Format *
                </label>
                <input
                  type="text"
                  id="resolution_format"
                  name="resolution_format"
                  required
                  placeholder="1080p MP4 (H.264)"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: DIRECTOR INFORMATION -->
        <section
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-5"
        >
          <div
            class="border-b-2 border-black/10 pb-3 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#B31D12]">STEP 04</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#18181B] font-mono"
            >
              Director Profile
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label
                  for="director_full_name"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Full Legal Name *
                </label>
                <input
                  type="text"
                  id="director_full_name"
                  name="director_full_name"
                  required
                  placeholder="Director Full Name"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_pro_name"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Professional Name (if different)
                </label>
                <input
                  type="text"
                  id="director_pro_name"
                  name="director_pro_name"
                  placeholder="Screen Name"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_location"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  City *
                </label>
                <input
                  type="text"
                  id="director_location"
                  name="director_location"
                  required
                  placeholder="City, State, Country"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="director_email"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Director's Email *
                </label>
                <input
                  type="email"
                  id="director_email"
                  name="director_email"
                  required
                  placeholder="director@example.com"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_phone"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Phone Number (WhatsApp Active) *
                </label>
                <input
                  type="tel"
                  id="director_phone"
                  name="director_phone"
                  required
                  placeholder="+91 00000 00000"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label
                for="director_bio"
                class="block font-bold uppercase tracking-wider text-[#18181B]"
              >
                Director's Biography *
              </label>
              <textarea
                id="director_bio"
                name="director_bio"
                rows="3"
                required
                placeholder="Short filmography, background, and previous projects..."
                class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
              ></textarea>
            </div>
          </div>
        </section>

        <!-- SECTION 5: PRODUCER & PRODUCTION HOUSE -->
        <section
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-5"
        >
          <div
            class="border-b-2 border-black/10 pb-3 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#B31D12]">STEP 05</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#18181B] font-mono"
            >
              Producer / Production House Information
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="production_company"
                  class="block font-bold uppercase tracking-wider text-[#18181B]"
                >
                  Production Banner / Studio (if any)
                </label>
                <input
                  type="text"
                  id="production_company"
                  name="production_company"
                  placeholder="Banner / Independent Production"
                  class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-xs text-[#18181B] focus:outline-none focus:border-[#B31D12]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="producer_name"
