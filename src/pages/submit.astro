---
// src/pages/submit.astro
import Layout from "../layouts/Layout.astro";

const paymentQrImage =
  "https://i.ibb.co/9ms08nnm/Screenshot-2026-08-27-041814.jpg";
const officialUpiId = "sbivan.MFBANK10001001000632@sbi";
---

<Layout title="Official Film Submission Portal | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-12 sm:py-20 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-5xl mx-auto space-y-12">
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-6 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-wider text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          > / Submissions
        </div>

        <div>
          <h1
            class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-[#161616]"
          >
            Submit Your Film
          </h1>
          <p class="font-mono text-xs sm:text-sm text-zinc-700 mt-1">
            Official Entry Portal for the 3rd Pazhassi Short Film Festival (PSFF
            Season 03).
          </p>
        </div>
      </header>

      <form
        id="festival-submission-form"
        class="space-y-10 font-mono text-xs"
        enctype="multipart/form-data"
      >
        <!-- SECTION 1: ENTRY FEE PAYMENT & COMPACT QR SCAN -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-5 sm:p-6 shadow-[5px_5px_0px_0px_#161616] space-y-4"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex items-center justify-between"
          >
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-black text-[#D9381E]">STEP 01</span>
              <h2
                class="text-base sm:text-lg font-black uppercase text-[#161616]"
              >
                Entry Fee Payment (₹1,000)
              </h2>
            </div>
            <span class="text-zinc-500 uppercase text-[10px] font-bold">
              Non-Refundable
            </span>
          </div>

          <!-- Compact Side-by-Side Flex Box -->
          <div
            class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pt-2"
          >
            <!-- Compact QR Card (Strictly 140px) -->
            <div
              class="w-[180px] shrink-0 border-2 border-[#161616] bg-white p-3 text-center space-y-2 shadow-[3px_3px_0px_0px_#161616]"
            >
              <span
                class="text-[9px] uppercase tracking-wider text-zinc-500 font-bold block"
              >
                Scan to Pay ₹1,000
              </span>

              <div
                class="w-[140px] h-[140px] mx-auto border border-zinc-900 p-1 bg-white flex items-center justify-center overflow-hidden"
              >
                <img
                  src={paymentQrImage}
                  alt="UPI QR Code"
                  style="width: 130px; height: 130px; max-width: 100%; max-height: 100%; object-fit: contain;"
                  loading="eager"
                />
              </div>

              <div class="space-y-1 pt-1 border-t border-zinc-200">
                <span class="text-[8px] text-zinc-500 font-bold uppercase block"
                  >Official UPI ID</span
                >
                <div
                  class="flex items-center justify-between gap-1 bg-zinc-100 p-1 border border-zinc-300"
                >
                  <code
                    id="upi-text"
                    class="text-[9px] font-black text-[#161616] truncate select-all"
                    title={officialUpiId}
                  >
                    {officialUpiId}
                  </code>
                  <button
                    type="button"
                    id="copy-upi-btn"
                    title="Copy UPI ID"
                    class="px-1.5 py-0.5 text-[9px] uppercase font-bold bg-[#161616] text-white hover:bg-[#D9381E] transition-colors cursor-pointer shrink-0"
                  >
                    Copy
                  </button>
                </div>
              </div>
            </div>

            <!-- Transaction Reference & Image Upload -->
            <div class="flex-1 w-full space-y-4">
              <div class="space-y-1">
                <label
                  for="payment_ref"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  UPI Transaction ID / UTR Number *
                </label>
                <input
                  type="text"
                  id="payment_ref"
                  name="payment_ref"
                  required
                  placeholder="e.g. 423987123456"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
                <p class="text-[10px] text-zinc-500">
                  Enter the 12-digit transaction number provided in your payment
                  receipt.
                </p>
              </div>

              <!-- Direct File Upload for Payment Screenshot -->
              <div class="space-y-1">
                <label
                  for="payment_screenshot"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Upload Payment Screenshot / Receipt (Image File) *
                </label>
                <div
                  class="border-2 border-dashed border-[#161616] bg-white p-3 text-center space-y-1"
                >
                  <input
                    type="file"
                    id="payment_screenshot"
                    name="payment_screenshot"
                    accept="image/png, image/jpeg, image/jpg, image/webp"
                    required
                    class="w-full text-xs font-mono text-zinc-700 file:mr-3 file:py-1.5 file:px-3 file:border-2 file:border-[#161616] file:text-[11px] file:font-black file:uppercase file:bg-[#F6F4EE] file:text-[#161616] hover:file:bg-[#D9381E] hover:file:text-white file:cursor-pointer cursor-pointer"
                  />
                  <p class="text-[9px] text-zinc-500">
                    Accepts PNG, JPG, or WEBP (Max 5MB).
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 2: FILM INFORMATION -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-5"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#D9381E]">STEP 02</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#161616]"
            >
              Film Information
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="film_title"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Film Title (Original Language) *
                </label>
                <input
                  type="text"
                  id="film_title"
                  name="film_title"
                  required
                  placeholder="Original Title"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="genre"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Genre *
                </label>
                <input
                  type="text"
                  id="genre"
                  name="genre"
                  required
                  placeholder="e.g. Drama, Thriller, Comedy"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div class="space-y-1.5">
                <label
                  for="film_language"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Film Language *
                </label>
                <input
                  type="text"
                  id="film_language"
                  name="film_language"
                  required
                  value="Malayalam"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="country_of_origin"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Country of Origin *
                </label>
                <input
                  type="text"
                  id="country_of_origin"
                  name="country_of_origin"
                  required
                  value="India"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="duration_minutes"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Exact Runtime (Minutes) *
                </label>
                <input
                  type="number"
                  id="duration_minutes"
                  name="duration_minutes"
                  min="1"
                  max="30"
                  required
                  placeholder="Max 30 mins"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="year_of_production"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Production Year *
                </label>
                <input
                  type="number"
                  id="year_of_production"
                  name="year_of_production"
                  min="2023"
                  max="2026"
                  required
                  value="2026"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="premiere_status"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Premiere Status (Optional)
                </label>
                <input
                  type="text"
                  id="premiere_status"
                  name="premiere_status"
                  placeholder="e.g. World Premiere, Kerala Premiere, None"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="poster_url"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  High-Res Poster Link (Drive / Dropbox) *
                </label>
                <input
                  type="url"
                  id="poster_url"
                  name="poster_url"
                  required
                  placeholder="https://drive.google.com/..."
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label
                for="synopsis"
                class="block font-bold uppercase tracking-wider text-[#161616]"
              >
                Film Synopsis (50 - 150 Words) *
              </label>
              <textarea
                id="synopsis"
                name="synopsis"
                rows="4"
                required
                placeholder="Narrative summary and premise of the short film..."
                class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
              ></textarea>
            </div>
          </div>
        </section>

        <!-- SECTION 3: SCREENER & TECHNICAL SPECIFICATIONS -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-5"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#D9381E]">STEP 03</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#161616]"
            >
              Screening Links &amp; Technical Master
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="screener_url"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Private Screener Link (Vimeo / Google Drive) *
                </label>
                <input
                  type="url"
                  id="screener_url"
                  name="screener_url"
                  required
                  placeholder="https://..."
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="screener_password"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Screening Password (if protected)
                </label>
                <input
                  type="text"
                  id="screener_password"
                  name="screener_password"
                  placeholder="Leave empty if link is open"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
              <div class="space-y-1.5">
                <label
                  for="subtitles_available"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Subtitles Available? *
                </label>
                <select
                  id="subtitles_available"
                  name="subtitles_available"
                  required
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                >
                  <option value="Yes - English">Yes - English Subtitles</option>
                  <option value="Yes - Embedded/Burned">Yes - Burned In</option>
                  <option value="No">No Subtitles</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label
                  for="subtitle_language"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Subtitle Language
                </label>
                <input
                  type="text"
                  id="subtitle_language"
                  name="subtitle_language"
                  value="English"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="aspect_ratio"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Aspect Ratio *
                </label>
                <input
                  type="text"
                  id="aspect_ratio"
                  name="aspect_ratio"
                  required
                  placeholder="e.g. 16:9, 2.39:1"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="resolution_format"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Resolution / Format *
                </label>
                <input
                  type="text"
                  id="resolution_format"
                  name="resolution_format"
                  required
                  placeholder="1080p MP4 (H.264)"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 4: DIRECTOR INFORMATION -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-5"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#D9381E]">STEP 04</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#161616]"
            >
              Director Profile
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label
                  for="director_full_name"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Full Legal Name *
                </label>
                <input
                  type="text"
                  id="director_full_name"
                  name="director_full_name"
                  required
                  placeholder="Director Full Name"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_pro_name"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Professional Name (if different)
                </label>
                <input
                  type="text"
                  id="director_pro_name"
                  name="director_pro_name"
                  placeholder="Screen Name"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_location"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  City*
                </label>
                <input
                  type="text"
                  id="director_location"
                  name="director_location"
                  required
                  placeholder="City, State, Country"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="director_email"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Director's Email *
                </label>
                <input
                  type="email"
                  id="director_email"
                  name="director_email"
                  required
                  placeholder="director@example.com"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="director_phone"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Phone Number (WhatsApp Active) *
                </label>
                <input
                  type="tel"
                  id="director_phone"
                  name="director_phone"
                  required
                  placeholder="+91 00000 00000"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label
                for="director_bio"
                class="block font-bold uppercase tracking-wider text-[#161616]"
              >
                Director's Biography *
              </label>
              <textarea
                id="director_bio"
                name="director_bio"
                rows="3"
                required
                placeholder="Short filmography, background, and previous projects..."
                class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
              ></textarea>
            </div>
          </div>
        </section>

        <!-- SECTION 5: PRODUCER & PRODUCTION HOUSE -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-5"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex items-center gap-2.5"
          >
            <span class="text-xs font-black text-[#D9381E]">STEP 05</span>
            <h2
              class="text-base sm:text-lg font-black uppercase text-[#161616]"
            >
              Producer / Production House Information
            </h2>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="production_company"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Production Banner / Studio (if any)
                </label>
                <input
                  type="text"
                  id="production_company"
                  name="production_company"
                  placeholder="Banner / Independent Production"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="producer_name"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Producer's Name *
                </label>
                <input
                  type="text"
                  id="producer_name"
                  name="producer_name"
                  required
                  placeholder="Producer Full Name"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label
                  for="producer_email"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Producer's Email *
                </label>
                <input
                  type="email"
                  id="producer_email"
                  name="producer_email"
                  required
                  placeholder="producer@example.com"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="producer_phone"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Producer's Phone *
                </label>
                <input
                  type="tel"
                  id="producer_phone"
                  name="producer_phone"
                  required
                  placeholder="+91 00000 00000"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="producer_country"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Production Country *
                </label>
                <input
                  type="text"
                  id="producer_country"
                  name="producer_country"
                  required
                  value="India"
                  class="w-full bg-white border-2 border-[#161616] p-2.5 text-xs focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 6: CINEMATOGRAPHER PROFILE -->
        <section
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-5"
        >
          <div
            class="border-b border-zinc-300 pb-2.5 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2"
          >
            <div class="flex items-center gap-2.5">
              <span class="text-xs font-black text-[#D9381E]">STEP 06</span>
              <h2
                class="text-base sm:text-lg font-black uppercase text-[#161616]"
              >
                Cinematographer Information
              </h2>
            </div>
            <span class="text-zinc-500 uppercase text-[10px] font-bold">
              Eligible for Best Cinematographer Award (₹10,000)
            </span>
          </div>

          <div class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label
                  for="dop_full_name"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Cinematographer (DoP) Name
                </label>
                <input
                  type="text"
