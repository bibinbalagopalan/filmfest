---
// src/pages/news/[slug].astro
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const newsFiles = import.meta.glob<{
    frontmatter: {
      title: string;
      publishDate: string;
      tag?: string;
      summary?: string;
      image?: string;
    };
    Content: any;
  }>("../../content/news/*.md", { eager: true });

  return Object.entries(newsFiles).map(([path, file]) => {
    const slug = path.split("/").pop()?.replace(".md", "") || "";
    return {
      params: { slug },
      props: {
        frontmatter: file.frontmatter,
        Content: file.Content,
      },
    };
  });
}

const { frontmatter, Content } = Astro.props;
---

<Layout title={`${frontmatter.title} | PSFF 2026`}>
  <main
    class="w-full bg-white text-zinc-950 border-b border-zinc-200 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#4338ca] selection:text-white"
  >
    <div class="max-w-4xl mx-auto space-y-10 sm:space-y-12">
      <!-- Back Button -->
      <div>
        <a
          href="/"
          class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-widest text-zinc-500 hover:text-zinc-950 transition-colors"
        >
          <span>&larr;</span>
          <span>Back to Overview</span>
        </a>
      </div>

      <!-- Headline & Meta -->
      <header class="border-b-2 border-zinc-950 pb-6 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs text-zinc-500 uppercase tracking-widest"
        >
          <span class="text-[#4338ca] font-bold"
            >{frontmatter.tag || "Dispatch"}</span
          >
          <span>&bull;</span>
          <span>{frontmatter.publishDate}</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-zinc-950 leading-[1.05]"
        >
          {frontmatter.title}
        </h1>
      </header>

      <!-- Featured Image Container -->
      {
        frontmatter.image && (
          <div class="relative border-2 border-zinc-950 aspect-[16/9] bg-zinc-100 overflow-hidden shadow-[6px_6px_0px_0px_#18181b]">
            <img
              src={frontmatter.image}
              alt={frontmatter.title}
              class="w-full h-full object-cover"
            />
          </div>
        )
      }

      <!-- Body Copy -->
      <article
        class="max-w-3xl space-y-6 text-base sm:text-lg text-zinc-800 leading-relaxed font-normal [&>p]:leading-relaxed [&>p]:mb-6 [&>strong]:text-zinc-950 [&>strong]:font-bold [&>h2]:text-2xl [&>h2]:font-black [&>h2]:uppercase [&>h2]:tracking-tight [&>h2]:text-zinc-950 [&>h2]:mt-10 [&>h2]:mb-4 [&>ul]:list-disc [&>ul]:pl-5 [&>ul]:space-y-2"
      >
        <Content />
      </article>

      <!-- Bottom Nav -->
      <div
        class="pt-10 border-t border-zinc-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
      >
        <span class="font-mono text-xs uppercase tracking-wider text-zinc-400">
          Pazhassi Short Film Festival &bull; Mananthavady
        </span>
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#4338ca] hover:text-zinc-950 underline underline-offset-4 transition-colors"
        >
          <span>Return to Homepage</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </main>
</Layout>
