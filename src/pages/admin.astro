</Layout>

<script>
  import { createClient } from "@supabase/supabase-js";

  const SUPABASE_URL = "https://hhsxninbpcnubcgfunjv.supabase.co";
  const SUPABASE_ANON_KEY =
    "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhoc3huaW5icGNudWJjZ2Z1bmp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4MjcxNDIsImV4cCI6MjEwMzQwMzE0Mn0.gsoHCXxlR-nDGzmKcOczs2mb0h2Bqcuqm-QvEiqNHbA";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const CRITERIA = [
    { key: "score_concept", label: "Concept", max: 10 },
    { key: "score_originality", label: "Originality", max: 10 },
    { key: "score_screenplay", label: "Screenplay", max: 15 },
    { key: "score_direction", label: "Direction", max: 15 },
    { key: "score_characterization", label: "Performances", max: 10 },
    { key: "score_cinematography", label: "Cinematography", max: 10 },
    { key: "score_editing", label: "Editing", max: 10 },
    { key: "score_sound", label: "Sound", max: 8 },
    { key: "score_production_design", label: "Production Design", max: 4 },
    { key: "score_music", label: "Music", max: 3 },
    { key: "score_thematic_depth", label: "Thematic Depth", max: 5 },
    { key: "score_impact", label: "Impact", max: 10 },
  ];

  let currentSubmissions: any[] = [];
  let currentJuryMembers: any[] = [];
  let currentEvaluations: any[] = [];
  let activeSelectedFilm: any = null;

  const loginView = document.getElementById("login-view");
  const dashboardView = document.getElementById("dashboard-view");
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const loginError = document.getElementById("login-error");
  const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
  const logoutBtn = document.getElementById("logout-btn");

  // Tab navigation
  document.querySelectorAll(".admin-tab-btn").forEach((btn) => {
    btn.addEventListener("click", (e) => {
      const targetTab = (e.currentTarget as HTMLElement).getAttribute(
        "data-tab",
      );
      document.querySelectorAll(".admin-tab-btn").forEach((b) => {
        b.className =
          "admin-tab-btn px-3 py-1.5 text-xs font-black uppercase text-[#18181B] hover:bg-zinc-200 rounded-md";
      });
      (e.currentTarget as HTMLElement).className =
        "admin-tab-btn px-3 py-1.5 text-xs font-black uppercase bg-[#B31D12] text-white rounded-md";
      document
        .querySelectorAll(".tab-pane")
        .forEach((pane) => pane.classList.add("hidden"));
      document.getElementById(targetTab!)?.classList.remove("hidden");
    });
  });

  const checkAdminSession = async () => {
    const {
      data: { session },
    } = await supabase.auth.getSession();
    if (session) {
      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", session.user.id)
        .single();

      if (
        profile &&
        (profile.role === "admin" || session.user.email === "convener@psff.in")
      ) {
        loginView?.classList.add("hidden");
        dashboardView?.classList.remove("hidden");
        await fetchAllData();
      } else {
        await supabase.auth.signOut();
        loginView?.classList.remove("hidden");
        dashboardView?.classList.add("hidden");
        if (loginError) {
          loginError.innerText =
            "Restricted: Only convener@psff.in can access this portal.";
          loginError.classList.remove("hidden");
        }
      }
    } else {
      loginView?.classList.remove("hidden");
      dashboardView?.classList.add("hidden");
    }
  };

  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    loginBtn.disabled = true;
    loginBtn.innerText = "Authenticating...";
    loginError?.classList.add("hidden");

    const email = (
      document.getElementById("admin-email") as HTMLInputElement
    ).value.trim();
    const password = (
      document.getElementById("admin-password") as HTMLInputElement
    ).value;

    const { error } = await supabase.auth.signInWithPassword({
      email,
      password,
    });

    if (error) {
      loginError!.innerText = error.message;
      loginError!.classList.remove("hidden");
      loginBtn.disabled = false;
      loginBtn.innerText = "Authenticate →";
    } else {
      await checkAdminSession();
      loginBtn.disabled = false;
      loginBtn.innerText = "Authenticate →";
    }
  });

  logoutBtn?.addEventListener("click", async () => {
    await supabase.auth.signOut();
    location.reload();
  });

  const fetchAllData = async () => {
    const [subsRes, juryRes, evalsRes] = await Promise.all([
      supabase
        .from("submissions")
        .select("*")
        .order("created_at", { ascending: false }),
      supabase.from("profiles").select("*").eq("role", "jury"),
      supabase.from("evaluations").select("*"),
    ]);

    currentSubmissions = subsRes.data || [];
    currentJuryMembers = juryRes.data || [];
    currentEvaluations = evalsRes.data || [];

    updateMetrics();
    renderSubmissionsTable();
    renderJuryRoster();
    renderSingleGlanceProgressGrid();
    renderScoreMatrix();
    renderLeaderboard();
  };

  const updateMetrics = () => {
    document.getElementById("stat-total")!.innerText =
      currentSubmissions.length.toString();
    document.getElementById("stat-pending")!.innerText = currentSubmissions
      .filter((s) => (s.status || "Pending") === "Pending")
      .length.toString();
    document.getElementById("stat-accepted")!.innerText = currentSubmissions
      .filter((s) => s.status === "Accepted")
      .length.toString();
    document.getElementById("stat-rejected")!.innerText = currentSubmissions
      .filter((s) => s.status === "Rejected")
      .length.toString();
  };

  // DELETE SUBMISSION HANDLER
  const deleteSubmission = async (
    filmId: string,
    entryNumber: string,
    filmTitle: string,
  ) => {
    const confirmation = prompt(
      `⚠️ WARNING: Deleting this entry will permanently remove the submission and any corresponding jury evaluations from the database.\n\nType "${entryNumber}" to confirm deletion of:\n"${filmTitle}"`,
    );

    if (confirmation !== entryNumber) {
      if (confirmation !== null)
        alert("Deletion cancelled: Entry ID did not match.");
      return;
    }

    // 1. Delete associated evaluations first
    await supabase.from("evaluations").delete().eq("submission_id", filmId);

    // 2. Delete the submission
    const { error } = await supabase
      .from("submissions")
      .delete()
      .eq("id", filmId);

    if (error) {
      alert(`Failed to delete submission: ${error.message}`);
    } else {
      alert(`Submission ${entryNumber} has been permanently deleted.`);
      document.getElementById("detail-modal")?.classList.add("hidden");
      await fetchAllData();
    }
  };

  // TAB 1: SUBMISSIONS REVIEW TABLE (ALL DETAILS EXPOSED DIRECTLY IN DASHBOARD)
  const renderSubmissionsTable = () => {
    const tbody = document.getElementById("submissions-tbody");
    if (!tbody) return;

    const query =
      (document.getElementById("submission-search") as HTMLInputElement)?.value
        .toLowerCase()
        .trim() || "";
    const filter =
      (document.getElementById("submission-filter") as HTMLSelectElement)
        ?.value || "ALL";

    const filtered = currentSubmissions.filter((item) => {
      const matchStatus =
        filter === "ALL" || (item.status || "Pending") === filter;

      const searchFields = [
        item.entry_number,
        item.film_title,
        item.genre,
        item.film_language,
        item.country_of_origin,
        item.director_full_name,
        item.director_pro_name,
        item.director_email,
        item.director_phone,
        item.director_location,
        item.producer_name,
        item.producer_email,
        item.producer_phone,
        item.production_company,
        item.dop_full_name,
        item.dop_email,
        item.dop_phone,
        item.camera_specs,
        item.crew_writer,
        item.crew_editor,
        item.crew_composer,
        item.crew_sound,
        item.crew_art,
        item.crew_costume,
        item.crew_cast,
        item.rights_holder_name,
        item.payment_ref,
        item.synopsis,
      ]
        .filter(Boolean)
        .join(" ")
        .toLowerCase();

      const matchSearch = !query || searchFields.includes(query);
      return matchStatus && matchSearch;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = `<tr><td colspan="30" class="p-8 text-center text-zinc-500 font-bold">No submissions match the filter criteria.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtered
      .map((item) => {
        const status = item.status || "Pending";
        let badge = "bg-amber-100 text-amber-900 border border-amber-300";
        if (status === "Accepted")
          badge = "bg-emerald-100 text-emerald-900 border border-emerald-300";
        if (status === "Rejected")
          badge = "bg-red-100 text-red-900 border border-red-300";

        return `
        <tr class="hover:bg-zinc-50 transition-colors text-xs">
          <!-- Sticky Actions / Quick Status Toggle & Delete Controls -->
          <td class="p-2.5 border-r border-zinc-200 sticky left-0 bg-white shadow-xs z-10">
            <div class="flex items-center gap-1.5">
              <span class="px-2 py-0.5 text-[9px] font-black uppercase ${badge}">${status}</span>
              <select data-entry-id="${item.id}" class="quick-status-change bg-[#FDFCF7] border border-zinc-400 text-[10px] font-bold p-1 rounded cursor-pointer">
                <option value="" disabled selected>Change</option>
                <option value="Accepted">Accept</option>
                <option value="Rejected">Reject</option>
                <option value="Pending">Pending</option>
              </select>
              <button type="button" data-entry="${item.entry_number}" class="open-sub-btn px-2 py-1 bg-[#18181B] text-white hover:bg-[#B31D12] rounded font-bold text-[9px] uppercase transition-colors cursor-pointer">
                Modal
              </button>
              <button type="button" data-id="${item.id}" data-entry="${item.entry_number}" data-title="${(item.film_title || "").replace(/"/g, "&quot;")}" class="delete-sub-btn px-2 py-1 bg-red-100 text-red-900 hover:bg-red-800 hover:text-white rounded font-bold text-[9px] uppercase transition-colors cursor-pointer border border-red-300" title="Delete entry permanently">
                ✕
              </button>
            </div>
          </td>

          <!-- 1. Entry ID -->
          <td class="p-2.5 font-bold border-r border-zinc-200 select-all text-[#B31D12]">${item.entry_number}</td>

          <!-- 2. Film Title -->
          <td class="p-2.5 font-black text-[#18181B] border-r border-zinc-200">
            <div class="font-bold max-w-[200px] truncate" title="${item.film_title}">${item.film_title}</div>
          </td>

          <!-- 3. Genre -->
          <td class="p-2.5 border-r border-zinc-200">${item.genre || "—"}</td>

          <!-- 4. Language -->
          <td class="p-2.5 border-r border-zinc-200">${item.film_language || "—"}</td>

          <!-- 5. Duration -->
          <td class="p-2.5 border-r border-zinc-200 font-bold">${item.duration_minutes} Mins</td>

          <!-- 6. Year / Country -->
          <td class="p-2.5 border-r border-zinc-200">${item.year_of_production || 2026} / ${item.country_of_origin || "India"}</td>

          <!-- 7. Premiere Status -->
          <td class="p-2.5 border-r border-zinc-200">${item.premiere_status || "None"}</td>

          <!-- 8. Screener Link -->
          <td class="p-2.5 border-r border-zinc-200">
            ${item.screener_url ? `<a href="${item.screener_url}" target="_blank" class="px-2 py-1 bg-[#18181B] text-white font-bold text-[10px] uppercase hover:bg-[#B31D12] rounded inline-flex items-center gap-1">Open Screener &rarr;</a>` : `<span class="text-zinc-400">None</span>`}
          </td>

          <!-- 9. Screener Password -->
          <td class="p-2.5 border-r border-zinc-200 font-mono font-bold select-all">${item.screener_password || "None"}</td>

          <!-- 10. Subtitles -->
          <td class="p-2.5 border-r border-zinc-200">${item.subtitles_available || "No"} (${item.subtitle_language || "N/A"})</td>

          <!-- 11. Aspect Ratio / Format -->
          <td class="p-2.5 border-r border-zinc-200">${item.aspect_ratio || "—"} | ${item.resolution_format || "—"}</td>

          <!-- 12. Director -->
          <td class="p-2.5 border-r border-zinc-200 font-black text-[#18181B]">
            ${item.director_full_name}
            ${item.director_pro_name ? `<span class="text-[10px] text-zinc-500 font-normal block">(${item.director_pro_name})</span>` : ""}
          </td>

          <!-- 13. Director Contact -->
          <td class="p-2.5 border-r border-zinc-200">
            <div><a href="mailto:${item.director_email}" class="text-blue-700 hover:underline">${item.director_email}</a></div>
            <div class="text-zinc-600 font-mono">${item.director_phone}</div>
          </td>

          <!-- 14. Director Location -->
          <td class="p-2.5 border-r border-zinc-200">${item.director_location || "—"}</td>

          <!-- 15. Producer / Banner -->
          <td class="p-2.5 border-r border-zinc-200">
            <div class="font-bold">${item.producer_name || "—"}</div>
            <div class="text-[10px] text-zinc-500">${item.production_company || "Independent"}</div>
          </td>

          <!-- 16. Producer Contact -->
          <td class="p-2.5 border-r border-zinc-200">
            <div>${item.producer_email || "—"}</div>
            <div class="text-zinc-600 font-mono">${item.producer_phone || "—"}</div>
          </td>

          <!-- 17. Cinematographer (DoP) -->
          <td class="p-2.5 border-r border-zinc-200 font-bold">
            ${item.dop_full_name || "—"}
            ${item.dop_pro_name ? `<span class="text-[10px] text-zinc-500 font-normal block">(${item.dop_pro_name})</span>` : ""}
          </td>

          <!-- 18. DoP Contact -->
          <td class="p-2.5 border-r border-zinc-200">
            <div>${item.dop_email || "—"}</div>
            <div class="text-zinc-600 font-mono">${item.dop_phone || "—"}</div>
          </td>

          <!-- 19. Camera & Lighting Specs -->
          <td class="p-2.5 border-r border-zinc-200 max-w-[200px] truncate" title="${item.camera_specs || "—"}">
            ${item.camera_specs || "—"}
          </td>

          <!-- 20. Screenplay / Writer -->
          <td class="p-2.5 border-r border-zinc-200">${item.crew_writer || "—"}</td>

          <!-- 21. Editor -->
          <td class="p-2.5 border-r border-zinc-200">${item.crew_editor || "—"}</td>

          <!-- 22. Sound & Music -->
          <td class="p-2.5 border-r border-zinc-200">
            <div><strong>Score:</strong> ${item.crew_composer || "—"}</div>
            <div><strong>Sound:</strong> ${item.crew_sound || "—"}</div>
          </td>

          <!-- 23. Art & Costume -->
          <td class="p-2.5 border-r border-zinc-200">
            <div><strong>Art:</strong> ${item.crew_art || "—"}</div>
            <div><strong>Costume:</strong> ${item.crew_costume || "—"}</div>
          </td>

          <!-- 24. Lead Cast -->
          <td class="p-2.5 border-r border-zinc-200 max-w-[200px] truncate" title="${item.crew_cast || "—"}">
            ${item.crew_cast || "—"}
          </td>

          <!-- 25. Rights Holder -->
          <td class="p-2.5 border-r border-zinc-200 font-bold">${item.rights_holder_name || item.director_full_name}</td>

          <!-- 26. UTR Reference -->
          <td class="p-2.5 border-r border-zinc-200 font-mono font-bold select-all bg-zinc-50">${item.payment_ref}</td>

          <!-- 27. Payment Receipt Link -->
          <td class="p-2.5 border-r border-zinc-200 text-center">
            ${item.payment_screenshot_url ? `<a href="${item.payment_screenshot_url}" target="_blank" class="px-2 py-1 bg-emerald-700 text-white hover:bg-black rounded font-bold text-[10px] uppercase inline-block">Inspect Image</a>` : `<span class="text-zinc-400">None</span>`}
          </td>

          <!-- 28. Poster Link -->
          <td class="p-2.5 border-r border-zinc-200 text-center">
            ${item.poster_url ? `<a href="${item.poster_url}" target="_blank" class="px-2 py-1 bg-zinc-200 hover:bg-black hover:text-white rounded font-bold text-[10px] uppercase inline-block">View Poster</a>` : `<span class="text-zinc-400">None</span>`}
          </td>

          <!-- 29. Synopsis -->
          <td class="p-2.5 max-w-[260px] truncate text-zinc-600" title="${item.synopsis || "N/A"}">
            ${item.synopsis || "N/A"}
          </td>
        </tr>
      `;
      })
      .join("");

    // Quick Status Change directly from the table
    document.querySelectorAll(".quick-status-change").forEach((select) => {
      select.addEventListener("change", async (e) => {
        const selectEl = e.currentTarget as HTMLSelectElement;
        const entryId = selectEl.getAttribute("data-entry-id");
        const newStatus = selectEl.value;
        if (!entryId || !newStatus) return;

        const { error } = await supabase
          .from("submissions")
          .update({ status: newStatus })
          .eq("id", entryId);

        if (!error) {
          await fetchAllData();
        } else {
          alert(`Status update failed: ${error.message}`);
        }
      });
    });

    // Row Delete Button Handler
    document.querySelectorAll(".delete-sub-btn").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
        const entryNumber = (e.currentTarget as HTMLElement).getAttribute(
          "data-entry",
        );
        const title = (e.currentTarget as HTMLElement).getAttribute(
          "data-title",
        );
        if (id && entryNumber) {
          await deleteSubmission(id, entryNumber, title || "Untitled Film");
        }
      });
    });

    document.querySelectorAll(".open-sub-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const id = (e.currentTarget as HTMLElement).getAttribute("data-entry");
        const film = currentSubmissions.find((s) => s.entry_number === id);
        if (film) openSubmissionModal(film);
      });
    });
  };

  const openSubmissionModal = (film: any) => {
    activeSelectedFilm = film;
    document.getElementById("modal-entry-id")!.innerText = film.entry_number;
    document.getElementById("modal-title")!.innerText = film.film_title;
    document.getElementById("modal-current-status")!.innerText =
      film.status || "Pending";

    document.getElementById("modal-body")!.innerHTML = `
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="space-y-4">
          <div class="border-2 border-black rounded-xl bg-white p-2">
            <span class="text-[9px] uppercase font-bold text-zinc-500 block mb-1">Official Poster</span>
            <img src="${film.poster_url}" alt="Poster" class="w-full aspect-2/3 object-cover border rounded" onerror="this.src=''"/>
          </div>
          <div class="border-2 border-black rounded-xl bg-white p-3 space-y-1 text-xs">
            <strong>UTR:</strong> <code class="select-all font-bold">${film.payment_ref}</code>
            ${film.payment_screenshot_url ? `<a href="${film.payment_screenshot_url}" target="_blank" class="block text-center py-1 bg-zinc-200 hover:bg-black hover:text-white font-bold uppercase text-[10px] mt-2 rounded">Inspect Receipt Image</a>` : ""}
          </div>
        </div>
        <div class="md:col-span-2 space-y-4">
          <div class="bg-white border-2 border-black rounded-xl p-4 space-y-2 text-xs">
            <h4 class="font-black uppercase text-[#B31D12] border-b pb-1">Synopsis & Screener</h4>
            <p class="leading-relaxed bg-zinc-50 p-2.5 border rounded">${film.synopsis || "N/A"}</p>
            <div class="pt-2">
              <a href="${film.screener_url}" target="_blank" class="inline-block px-3 py-1.5 bg-[#18181B] text-white font-black uppercase text-xs hover:bg-[#B31D12] rounded">Open Screener Link &rarr;</a>
              ${film.screener_password ? `<span class="ml-2 font-bold">Password: <code>${film.screener_password}</code></span>` : ""}
            </div>
          </div>
          <div class="bg-white border-2 border-black rounded-xl p-4 text-xs space-y-1">
            <h4 class="font-black uppercase text-[#B31D12] border-b pb-1">Director / Producer Details</h4>
            <div><strong>Director:</strong> ${film.director_full_name} (${film.director_email} | ${film.director_phone})</div>
            <div><strong>Producer:</strong> ${film.producer_name} (${film.producer_email})</div>
          </div>
        </div>
      </div>
    `;

    document.getElementById("detail-modal")?.classList.remove("hidden");
  };

  // Modal Delete Action Handler
  document
    .getElementById("modal-delete-btn")
    ?.addEventListener("click", async () => {
      if (!activeSelectedFilm) return;
      await deleteSubmission(
        activeSelectedFilm.id,
        activeSelectedFilm.entry_number,
        activeSelectedFilm.film_title,
      );
    });

  const updateSubmissionStatus = async (newStatus: "Accepted" | "Rejected") => {
    if (!activeSelectedFilm) return;
    const { error } = await supabase
      .from("submissions")
      .update({ status: newStatus })
      .eq("id", activeSelectedFilm.id);
    if (!error) {
      activeSelectedFilm.status = newStatus;
      document.getElementById("detail-modal")?.classList.add("hidden");
      await fetchAllData();
    }
  };

  document
    .getElementById("modal-accept-btn")
    ?.addEventListener("click", () => updateSubmissionStatus("Accepted"));
  document
    .getElementById("modal-reject-btn")
    ?.addEventListener("click", () => updateSubmissionStatus("Rejected"));
  document
    .getElementById("close-modal-btn")
    ?.addEventListener("click", () =>
      document.getElementById("detail-modal")?.classList.add("hidden"),
    );

  // TAB 2: JURY ROSTER
  const renderJuryRoster = () => {
    const container = document.getElementById("jury-cards-container");
    if (!container) return;

