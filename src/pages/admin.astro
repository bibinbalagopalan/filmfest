---
// src/pages/admin.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Control Panel | PSFF Season 03">
  <!-- Scoped CSS to hide public navbar & footer -->
  <style is:global>
    header:not(#dashboard-view header),
    nav,
    footer {
      display: none !important;
    }
  </style>

  <div
    class="relative w-full min-h-screen bg-[#B31D12] text-[#FDFCF7] font-mono p-4 sm:p-8 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
  >
    <!-- Background Frame Accents & Swirl Patterns -->
    <div
      class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
    </div>

    <!-- 1. LOGIN SCREEN -->
    <div
      id="login-view"
      class="relative z-10 max-w-md mx-auto my-16 bg-[#FDFCF7] text-[#18181B] border-2 border-black p-6 sm:p-8 rounded-2xl shadow-[6px_6px_0px_0px_#000000] space-y-6"
    >
      <div
        class="border-b-2 border-black/10 pb-4 flex items-center justify-between gap-4"
      >
        <div>
          <span
            class="text-[10px] font-black uppercase text-[#B31D12] tracking-widest block"
            >PSFF Season 03</span
          >
          <h1
            class="text-2xl font-black uppercase tracking-tight text-[#18181B] mt-0.5"
          >
            Control Panel
          </h1>
          <p class="text-xs text-zinc-600 font-sans mt-0.5">
            Sign in with convener credentials.
          </p>
        </div>
        <!-- High-Contrast Crimson Shield Badge for White Logo Visibility -->
        <div
          class="h-12 w-12 bg-[#B31D12] border-2 border-black rounded-xl p-1 flex items-center justify-center shadow-sm shrink-0"
        >
          <img
            src="https://i.ibb.co/0R0xXBmN/logo-2.png"
            alt="PSFF Logo"
            class="h-full w-auto object-contain"
          />
        </div>
      </div>

      <form id="login-form" class="space-y-4 text-xs">
        <div class="space-y-1.5">
          <label
            for="admin-email"
            class="block font-bold uppercase tracking-wider text-[#18181B]"
            >Email Address
          </label>
          <input
            type="email"
            id="admin-email"
            required
            autocomplete="email"
            class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-[#18181B] focus:outline-none focus:border-[#B31D12]"
          />
        </div>
        <div class="space-y-1.5">
          <label
            for="admin-password"
            class="block font-bold uppercase tracking-wider text-[#18181B]"
            >Password
          </label>
          <input
            type="password"
            id="admin-password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full bg-white border-2 border-black rounded-lg p-2.5 text-[#18181B] focus:outline-none focus:border-[#B31D12]"
          />
        </div>
        <div
          id="login-error"
          class="hidden p-3 bg-red-100 border border-[#B31D12] text-[#B31D12] font-bold text-[11px] rounded-lg"
        >
        </div>
        <button
          type="submit"
          id="login-btn"
          class="w-full py-3 font-black uppercase tracking-widest text-[#FDFCF7] bg-[#B31D12] border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[3px_3px_0px_0px_#000000]"
        >
          Authenticate &rarr;
        </button>
      </form>
    </div>

    <!-- 2. CONVENER MASTER DASHBOARD -->
    <div
      id="dashboard-view"
      class="relative z-10 hidden max-w-full mx-auto space-y-6"
    >
      <!-- Top Navigation Header -->
      <header
        class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-2 border-black rounded-2xl pb-4 bg-[#FDFCF7] text-[#18181B] p-4 sm:p-6 shadow-[6px_6px_0px_0px_#000000]"
      >
        <div class="flex items-center gap-4">
          <!-- High-Contrast Crimson Shield Badge for White Logo Visibility -->
          <div
            class="h-12 w-12 bg-[#B31D12] border-2 border-black rounded-xl p-1 flex items-center justify-center shadow-sm shrink-0"
          >
            <img
              src="https://i.ibb.co/0R0xXBmN/logo-2.png"
              alt="PSFF Logo"
              class="h-full w-auto object-contain"
            />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span
                class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"
              ></span>
              <span class="text-[10px] font-bold uppercase text-[#B31D12]"
                >PSFF Season 03</span
              >
            </div>
            <h1
              class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#18181B] mt-0.5"
            >
              Control Panel
            </h1>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <!-- Primary Module Tabs -->
          <div
            class="flex border-2 border-black p-0.5 bg-zinc-100 rounded-lg overflow-x-auto"
          >
            <button
              type="button"
              data-tab="tab-submissions"
              class="admin-tab-btn px-3 py-1.5 text-xs font-black uppercase bg-[#B31D12] text-white rounded-md"
              >1. Submissions
            </button>
            <button
              type="button"
              data-tab="tab-jury"
              class="admin-tab-btn px-3 py-1.5 text-xs font-black uppercase text-[#18181B] hover:bg-zinc-200 rounded-md"
              >2. Jury Roster
            </button>
            <button
              type="button"
              data-tab="tab-progress"
              class="admin-tab-btn px-3 py-1.5 text-xs font-black uppercase text-[#18181B] hover:bg-zinc-200 rounded-md"
              >3. Progress Grid
            </button>
            <button
              type="button"
              data-tab="tab-matrix"
              class="admin-tab-btn px-3 py-1.5 text-xs font-black uppercase text-[#18181B] hover:bg-zinc-200 rounded-md"
              >4. Score Matrix
            </button>
            <button
              type="button"
              data-tab="tab-leaderboard"
              class="admin-tab-btn px-3 py-1.5 text-xs font-black uppercase text-[#18181B] hover:bg-zinc-200 rounded-md bg-[#FDB813]/40"
              >5. Shortlist
            </button>
          </div>
          <button
            type="button"
            id="logout-btn"
            class="px-3 py-2 text-[11px] font-black uppercase tracking-wider bg-[#B31D12] text-white border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000]"
          >
            Sign Out
          </button>
        </div>
      </header>

      <!-- TAB 1: SUBMISSIONS & COMPREHENSIVE DOSSIER TABLE -->
      <section id="tab-submissions" class="tab-pane space-y-6">
        <!-- Metrics Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B]"
          >
            <span class="text-[10px] uppercase font-bold text-zinc-600"
              >Total Registered
            </span>
            <div
              id="stat-total"
              class="text-2xl sm:text-3xl font-black text-[#18181B] mt-1"
            >
              0
            </div>
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B]"
          >
            <span class="text-[10px] uppercase font-bold text-amber-600"
              >Pending Review
            </span>
            <div
              id="stat-pending"
              class="text-2xl sm:text-3xl font-black text-amber-600 mt-1"
            >
              0
            </div>
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B]"
          >
            <span class="text-[10px] uppercase font-bold text-emerald-600"
              >Accepted (To Jury)
            </span>
            <div
              id="stat-accepted"
              class="text-2xl sm:text-3xl font-black text-emerald-600 mt-1"
            >
              0
            </div>
          </div>
          <div
            class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl shadow-[4px_4px_0px_0px_#000000] text-[#18181B]"
          >
            <span class="text-[10px] uppercase font-bold text-[#B31D12]"
              >Rejected
            </span>
            <div
              id="stat-rejected"
              class="text-2xl sm:text-3xl font-black text-[#B31D12] mt-1"
            >
              0
            </div>
          </div>
        </div>

        <!-- Search Toolbar & Import/Export Actions -->
        <div
          class="bg-[#FDFCF7] border-2 border-black p-4 rounded-xl flex flex-col lg:flex-row gap-3 items-stretch lg:items-center justify-between shadow-[4px_4px_0px_0px_#000000] text-[#18181B]"
        >
          <input
            type="text"
            id="submission-search"
            placeholder="Search across all fields: Title, Director, DoP, Producer, Writer, Cast, UTR, City..."
            class="w-full lg:w-[480px] bg-white border-2 border-black rounded-lg p-2.5 text-xs focus:outline-none focus:border-[#B31D12]"
          />
          <div class="flex flex-wrap items-center gap-2">
            <select
              id="submission-filter"
              class="bg-white border-2 border-black rounded-lg p-2.5 text-xs font-bold uppercase focus:outline-none focus:border-[#B31D12]"
            >
              <option value="ALL">All Statuses </option>
              <option value="Pending">Pending </option>
              <option value="Accepted">Accepted </option>
              <option value="Rejected">Rejected </option>
            </select>

            <!-- Import CSV / JSON Trigger -->
            <label
              for="import-submissions-file"
              class="px-3 py-2.5 bg-zinc-200 text-[#18181B] border-2 border-black rounded-lg text-xs font-bold uppercase hover:bg-zinc-300 transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000] flex items-center gap-1.5"
            >
              <span>📥</span> Import (CSV/JSON)
            </label>
            <input
              type="file"
              id="import-submissions-file"
              accept=".csv, .json"
              class="hidden"
            />

            <!-- Complete Export CSV -->
            <button
              type="button"
              id="export-submissions-csv"
              class="px-3 py-2.5 bg-[#B31D12] text-white text-xs font-bold uppercase hover:bg-black transition-colors cursor-pointer border-2 border-black rounded-lg shadow-[2px_2px_0px_0px_#000000] flex items-center gap-1.5"
            >
              <span>📤</span> Export Full Dossier CSV
            </button>
          </div>
        </div>

        <!-- Complete Submissions Table with All Columns & Delete Action -->
        <div
          class="bg-[#FDFCF7] border-2 border-black rounded-2xl shadow-[6px_6px_0px_0px_#000000] overflow-x-auto max-h-[75vh]"
        >
          <table
            class="w-full text-left text-[11px] border-collapse whitespace-nowrap text-[#18181B]"
          >
            <thead class="sticky top-0 z-20">
              <tr
                class="bg-[#18181B] text-[#FDFCF7] uppercase tracking-wider text-[10px]"
              >
                <th
                  class="p-3 border-r border-zinc-700 sticky left-0 bg-[#18181B] z-30"
                  >Status / Controls
                </th>
                <th class="p-3 border-r border-zinc-700">Entry ID </th>
                <th class="p-3 border-r border-zinc-700">Film Title </th>
                <th class="p-3 border-r border-zinc-700">Genre </th>
                <th class="p-3 border-r border-zinc-700">Language </th>
                <th class="p-3 border-r border-zinc-700">Duration </th>
                <th class="p-3 border-r border-zinc-700">Year / Origin </th>
                <th class="p-3 border-r border-zinc-700">Premiere </th>
                <th class="p-3 border-r border-zinc-700">Screener Link </th>
                <th class="p-3 border-r border-zinc-700">Screener Pwd </th>
                <th class="p-3 border-r border-zinc-700">Subtitles </th>
                <th class="p-3 border-r border-zinc-700">Aspect / Format </th>
                <th class="p-3 border-r border-zinc-700">Director </th>
                <th class="p-3 border-r border-zinc-700">Director Contact </th>
                <th class="p-3 border-r border-zinc-700">Director Location </th>
                <th class="p-3 border-r border-zinc-700">Producer / Banner </th>
                <th class="p-3 border-r border-zinc-700">Producer Contact </th>
                <th class="p-3 border-r border-zinc-700"
                  >Cinematographer (DoP)
                </th>
                <th class="p-3 border-r border-zinc-700">DoP Contact </th>
                <th class="p-3 border-r border-zinc-700"
                  >Camera / Lighting Specs
                </th>
                <th class="p-3 border-r border-zinc-700">Writer(s) </th>
                <th class="p-3 border-r border-zinc-700">Editor </th>
                <th class="p-3 border-r border-zinc-700">Sound / Music </th>
                <th class="p-3 border-r border-zinc-700">Art / Costume </th>
                <th class="p-3 border-r border-zinc-700">Lead Cast </th>
                <th class="p-3 border-r border-zinc-700">Rights Holder </th>
                <th class="p-3 border-r border-zinc-700">UTR / Ref </th>
                <th class="p-3 border-r border-zinc-700">Payment Receipt </th>
                <th class="p-3 border-r border-zinc-700">Poster </th>
                <th class="p-3">Synopsis </th>
              </tr>
            </thead>
            <tbody id="submissions-tbody" class="divide-y divide-zinc-200">
              <tr
                ><td
                  colspan="30"
                  class="p-8 text-center text-zinc-500 font-bold"
                  >Loading complete registrations data...
                </td></tr
              >
            </tbody>
          </table>
        </div>
      </section>

      <!-- TAB 2: JURY ROSTER -->
      <section id="tab-jury" class="tab-pane hidden space-y-6">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#FDFCF7] text-[#18181B] p-4 rounded-xl border-2 border-black shadow-[4px_4px_0px_0px_#000000]"
        >
          <div>
            <h3 class="text-base font-black uppercase text-[#18181B]">
              Active Jury Members
            </h3>
            <p class="text-xs text-zinc-600 font-sans">
              Every active jury member evaluates every accepted short film.
            </p>
          </div>
          <button
            type="button"
            id="open-add-jury-btn"
            class="px-4 py-2.5 bg-[#B31D12] text-white text-xs font-black uppercase border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000]"
          >
            + Add New Jury Member
          </button>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-6"
          id="jury-cards-container"
        >
        </div>
      </section>

      <!-- TAB 3: SINGLE-GLANCE JURY VS MOVIE PROGRESS GRID -->
      <section id="tab-progress" class="tab-pane hidden space-y-6">
        <div
          class="bg-[#FDFCF7] text-[#18181B] p-4 rounded-xl border-2 border-black shadow-[4px_4px_0px_0px_#000000] space-y-1"
        >
          <h3 class="text-base font-black uppercase text-[#18181B]">
            Jury Evaluation Progress Grid
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed font-sans">
            Single-glance view of each jury member against all competition short
            films. Incomplete evaluations are highlighted in red/amber.
          </p>
        </div>

        <div
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl shadow-[6px_6px_0px_0px_#000000] overflow-x-auto"
        >
          <table class="w-full text-left text-xs border-collapse">
            <thead id="progress-grid-thead"></thead>
            <tbody id="progress-grid-tbody" class="divide-y divide-zinc-200">
              <tr
                ><td class="p-8 text-center text-zinc-500 font-bold"
                  >Aggregating progress grid...
                </td></tr
              >
            </tbody>
          </table>
        </div>
      </section>

      <!-- TAB 4: CROSS-JURY SCORE MATRIX & TOTALS CSV EXPORT -->
      <section id="tab-matrix" class="tab-pane hidden space-y-6">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#FDFCF7] text-[#18181B] p-4 rounded-xl border-2 border-black shadow-[4px_4px_0px_0px_#000000]"
        >
          <div>
            <h3 class="text-base font-black uppercase text-[#18181B]">
              Cross-Jury Score Matrix
            </h3>
            <p class="text-xs text-zinc-600 font-sans">
              Detailed criterion breakdown per movie. Use the CSV button to
              export jury totals and averages.
            </p>
          </div>
          <button
            type="button"
            id="export-matrix-csv"
            class="px-4 py-2.5 bg-[#B31D12] text-white text-xs font-black uppercase border-2 border-black rounded-lg hover:bg-black transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#000000] flex items-center gap-2"
          >
            <span>📥</span> Export Score Summary CSV
          </button>
        </div>

        <div id="matrix-container" class="space-y-6"></div>
      </section>

      <!-- TAB 5: SHORTLIST LEADERBOARD (RANKED BY AVERAGE SCORE) -->
      <section id="tab-leaderboard" class="tab-pane hidden space-y-6">
        <div
          class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-[#FDFCF7] text-[#18181B] p-4 rounded-xl border-2 border-black shadow-[4px_4px_0px_0px_#000000]"
        >
          <div>
            <h3 class="text-base font-black uppercase text-[#18181B]">
              Official Competition Shortlist &amp; Ranks
            </h3>
            <p class="text-xs text-zinc-600 font-sans">
              Films ranked automatically in descending order based on average
              jury marks.
            </p>
          </div>
          <button
            type="button"
            id="export-leaderboard-csv"
            class="px-4 py-2.5 bg-[#B31D12] text-white text-xs font-black uppercase hover:bg-black transition-colors cursor-pointer border-2 border-black rounded-lg shadow-[2px_2px_0px_0px_#000000]"
          >
            Export Shortlist CSV
          </button>
        </div>

        <div
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl shadow-[6px_6px_0px_0px_#000000] overflow-x-auto"
        >
          <table class="w-full text-left text-xs border-collapse">
            <thead>
              <tr
                class="bg-[#18181B] text-[#FDFCF7] uppercase tracking-wider text-[10px]"
              >
                <th class="p-3 border-r border-zinc-700 text-center w-16"
                  >Rank
                </th>
                <th class="p-3 border-r border-zinc-700">Entry ID </th>
                <th class="p-3 border-r border-zinc-700">Film Title </th>
                <th class="p-3 border-r border-zinc-700">Director </th>
                <th class="p-3 border-r border-zinc-700">Language / Min </th>
                <th class="p-3 border-r border-zinc-700 text-center"
                  >Completed Juries
                </th>
                <th
                  class="p-3 border-r border-zinc-700 text-center bg-[#B31D12] text-white font-black"
                  >Average Score
                </th>
                <th class="p-3 text-center">Verdict </th>
              </tr>
            </thead>
            <tbody id="leaderboard-tbody" class="divide-y divide-zinc-200">
              <tr
                ><td colspan="8" class="p-8 text-center text-zinc-500 font-bold"
                  >Computing leaderboard ranks...
                </td></tr
              >
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <!-- ADD JURY MODAL -->
    <div
      id="add-jury-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 backdrop-blur-xs"
    >
      <div
        class="bg-[#FDFCF7] text-[#18181B] border-2 border-black w-full max-w-sm p-6 rounded-2xl shadow-[8px_8px_0px_0px_#000000] space-y-4 font-mono text-xs"
      >
        <div
          class="flex items-center justify-between border-b-2 border-black/10 pb-2"
        >
          <h3 class="font-black uppercase text-sm text-[#18181B]">
            Add Jury Member
          </h3>
          <button
            type="button"
            id="close-add-jury-modal"
            class="text-lg font-black cursor-pointer hover:text-[#B31D12]"
            >✕
          </button>
        </div>
        <form id="add-jury-form" class="space-y-3">
          <div class="space-y-1">
            <label class="block font-bold uppercase">Full Name </label>
            <input
              type="text"
              id="new-jury-name"
              required
              placeholder="e.g. Priyadarshan"
              class="w-full bg-white border-2 border-black rounded-lg p-2 focus:outline-none focus:border-[#B31D12]"
            />
          </div>
          <div class="space-y-1">
            <label class="block font-bold uppercase">Email Address </label>
            <input
              type="email"
              id="new-jury-email"
              required
              placeholder="jury1@psff.in"
              class="w-full bg-white border-2 border-black rounded-lg p-2 focus:outline-none focus:border-[#B31D12]"
            />
          </div>
          <div class="space-y-1">
            <label class="block font-bold uppercase">Temporary Password </label>
            <input
              type="password"
              id="new-jury-pwd"
              required
              minlength="6"
              placeholder="At least 6 chars"
              class="w-full bg-white border-2 border-black rounded-lg p-2 focus:outline-none focus:border-[#B31D12]"
            />
          </div>
          <div
            id="add-jury-msg"
            class="hidden p-2 text-[11px] font-bold border rounded-lg"
          >
          </div>
          <button
            type="submit"
            id="create-jury-submit-btn"
            class="w-full py-2.5 font-black uppercase bg-[#B31D12] text-white rounded-lg hover:bg-black transition-colors cursor-pointer"
          >
            Create Jury Account
          </button>
        </form>
      </div>
    </div>

    <!-- SUBMISSION DOSSIER MODAL WITH DELETE OPTION -->
    <div
      id="detail-modal"
      class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4 backdrop-blur-xs"
    >
      <div
        class="bg-[#FDFCF7] border-2 border-black rounded-2xl w-full max-w-4xl max-h-[90vh] flex flex-col shadow-[8px_8px_0px_0px_#000000] text-xs font-mono text-[#18181B] overflow-hidden"
      >
        <div
          class="p-4 bg-[#18181B] text-white flex items-center justify-between border-b-2 border-black"
        >
          <div class="flex items-center gap-3">
            <span
              id="modal-entry-id"
