        `"${s.duration_minutes || ""}"`,
        `"${s.year_of_production || ""}"`,
        `"${s.country_of_origin || ""}"`,
        `"${s.premiere_status || ""}"`,
        `"${s.screener_url || ""}"`,
        `"${s.screener_password || ""}"`,
        `"${s.subtitles_available || ""}"`,
        `"${s.subtitle_language || ""}"`,
        `"${s.aspect_ratio || ""}"`,
        `"${s.resolution_format || ""}"`,
        `"${(s.director_full_name || "").replace(/"/g, '""')}"`,
        `"${(s.director_pro_name || "").replace(/"/g, '""')}"`,
        `"${s.director_email || ""}"`,
        `"${s.director_phone || ""}"`,
        `"${(s.director_location || "").replace(/"/g, '""')}"`,
        `"${(s.director_bio || "").replace(/"/g, '""')}"`,
        `"${(s.producer_name || "").replace(/"/g, '""')}"`,
        `"${(s.production_company || "").replace(/"/g, '""')}"`,
        `"${s.producer_email || ""}"`,
        `"${s.producer_phone || ""}"`,
        `"${s.producer_country || ""}"`,
        `"${(s.dop_full_name || "").replace(/"/g, '""')}"`,
        `"${(s.dop_pro_name || "").replace(/"/g, '""')}"`,
        `"${s.dop_email || ""}"`,
        `"${s.dop_phone || ""}"`,
        `"${(s.dop_location || "").replace(/"/g, '""')}"`,
        `"${(s.camera_specs || "").replace(/"/g, '""')}"`,
        `"${(s.crew_writer || "").replace(/"/g, '""')}"`,
        `"${(s.crew_editor || "").replace(/"/g, '""')}"`,
        `"${(s.crew_composer || "").replace(/"/g, '""')}"`,
        `"${(s.crew_sound || "").replace(/"/g, '""')}"`,
        `"${(s.crew_art || "").replace(/"/g, '""')}"`,
        `"${(s.crew_costume || "").replace(/"/g, '""')}"`,
        `"${(s.crew_cast || "").replace(/"/g, '""')}"`,
        `"${(s.rights_holder_name || "").replace(/"/g, '""')}"`,
        `"${s.payment_ref || ""}"`,
        `"${s.payment_screenshot_url || ""}"`,
        `"${s.poster_url || ""}"`,
        `"${(s.synopsis || "").replace(/"/g, '""')}"`,
        `"${s.created_at || ""}"`,
      ]);

      const csvContent =
        "data:text/csv;charset=utf-8," +
        [headers.join(","), ...rows.map((e) => e.join(","))].join("\n");
      const link = document.createElement("a");
      link.href = encodeURI(csvContent);
      link.download = `PSFF2026_Complete_Submissions_Dossier_${new Date().toISOString().slice(0, 10)}.csv`;
      link.click();
    });

  // IMPORT SUBMISSIONS (CSV / JSON)
  const importFileInput = document.getElementById(
    "import-submissions-file",
  ) as HTMLInputElement;
  importFileInput?.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = async (event) => {
      try {
        const text = event.target?.result as string;
        let recordsToInsert: any[] = [];

        if (file.name.endsWith(".json")) {
          recordsToInsert = JSON.parse(text);
        } else if (file.name.endsWith(".csv")) {
          const lines = text.split(/\r?\n/).filter((l) => l.trim().length > 0);
          if (lines.length < 2) throw new Error("CSV file has no data rows.");

          const parseCSVLine = (line: string) => {
            const result = [];
            let start = 0;
            let inQuotes = false;
            for (let i = 0; i < line.length; i++) {
              if (line[i] === '"') inQuotes = !inQuotes;
              else if (line[i] === "," && !inQuotes) {
                let cell = line.substring(start, i).trim();
                if (cell.startsWith('"') && cell.endsWith('"'))
                  cell = cell.slice(1, -1).replace(/""/g, '"');
                result.push(cell);
                start = i + 1;
              }
            }
            let lastCell = line.substring(start).trim();
            if (lastCell.startsWith('"') && lastCell.endsWith('"'))
              lastCell = lastCell.slice(1, -1).replace(/""/g, '"');
            result.push(lastCell);
            return result;
          };

          const headers = parseCSVLine(lines[0]).map((h) =>
            h.toLowerCase().replace(/[^a-z0-9_]/g, "_"),
          );

          for (let i = 1; i < lines.length; i++) {
            const values = parseCSVLine(lines[i]);
            const rowObj: any = {};
            headers.forEach((h, idx) => {
              rowObj[h] = values[idx] || null;
            });

            recordsToInsert.push({
              entry_number:
                rowObj.entry_id ||
                rowObj.entry_number ||
                `PSFF26-${Math.floor(1000 + Math.random() * 9000)}`,
              film_title: rowObj.film_title || rowObj.title || "Untitled Film",
              genre: rowObj.genre || "Drama",
              film_language:
                rowObj.language || rowObj.film_language || "Malayalam",
              duration_minutes: parseInt(
                rowObj.duration_minutes || rowObj.duration || "15",
                10,
              ),
              year_of_production: parseInt(
                rowObj.year_of_production || rowObj.year || "2026",
                10,
              ),
              country_of_origin: rowObj.country_of_origin || "India",
              premiere_status: rowObj.premiere_status || "None",
              screener_url: rowObj.screener_url || rowObj.screener || "",
              screener_password:
                rowObj.screener_password || rowObj.password || "None",
              subtitles_available:
                rowObj.subtitles_available || "Yes - English",
              subtitle_language: rowObj.subtitle_language || "English",
              aspect_ratio: rowObj.aspect_ratio || "16:9",
              resolution_format: rowObj.resolution_format || "1080p MP4",
              director_full_name:
                rowObj.director_full_name || rowObj.director || "Director Name",
              director_pro_name: rowObj.director_pro_name || null,
              director_email: rowObj.director_email || rowObj.email || "",
              director_phone: rowObj.director_phone || rowObj.phone || "",
              director_location:
                rowObj.director_location || rowObj.location || "",
              director_bio: rowObj.director_bio || rowObj.bio || "",
              producer_name: rowObj.producer_name || rowObj.producer || "",
              production_company:
                rowObj.production_company || rowObj.banner || "Independent",
              producer_email: rowObj.producer_email || "",
              producer_phone: rowObj.producer_phone || "",
              producer_country: rowObj.producer_country || "India",
              dop_full_name:
                rowObj.dop_full_name ||
                rowObj.dop ||
                rowObj.cinematographer ||
                "",
              dop_pro_name: rowObj.dop_pro_name || null,
              dop_email: rowObj.dop_email || "",
              dop_phone: rowObj.dop_phone || "",
              dop_location: rowObj.dop_location || "",
              camera_specs: rowObj.camera_specs || "",
              crew_writer: rowObj.crew_writer || rowObj.writer || "",
              crew_editor: rowObj.crew_editor || rowObj.editor || "",
              crew_composer: rowObj.crew_composer || rowObj.composer || "",
              crew_sound: rowObj.crew_sound || rowObj.sound || "",
              crew_art: rowObj.crew_art || rowObj.art || "",
              crew_costume: rowObj.crew_costume || rowObj.costume || "",
              crew_cast: rowObj.crew_cast || rowObj.cast || "",
              rights_holder_name:
                rowObj.rights_holder_name || rowObj.director_full_name || "",
              payment_ref: rowObj.payment_ref || rowObj.utr || "OFFLINE_REF",
              payment_screenshot_url: rowObj.payment_screenshot_url || "",
              poster_url: rowObj.poster_url || "",
              synopsis: rowObj.synopsis || "N/A",
              status: rowObj.status || "Pending",
            });
          }
        }

        if (recordsToInsert.length === 0) {
          return alert("No valid rows detected in the import file.");
        }

        const confirmImport = confirm(
          `Ready to import ${recordsToInsert.length} submissions into Supabase. Proceed?`,
        );
        if (!confirmImport) return;

        const { error } = await supabase
          .from("submissions")
          .insert(recordsToInsert);
        if (error) {
          alert(`Import failed: ${error.message}`);
        } else {
          alert(`Successfully imported ${recordsToInsert.length} submissions!`);
          importFileInput.value = "";
          await fetchAllData();
        }
      } catch (err: any) {
        alert(`Failed to parse file: ${err.message}`);
      }
    };
    reader.readAsText(file);
  });

  // Search & Filter Listeners for Tab 1
  document
    .getElementById("submission-search")
    ?.addEventListener("input", renderSubmissionsTable);
  document
    .getElementById("submission-filter")
    ?.addEventListener("change", renderSubmissionsTable);

  checkAdminSession();
</script>
