  // TAB 5: LEADERBOARD & SHORTLISTING RANKS
  const renderLeaderboard = () => {
    const tbody = document.getElementById("leaderboard-tbody");
    if (!tbody) return;

    const acceptedFilms = currentSubmissions.filter(
      (s) => s.status === "Accepted",
    );

    if (acceptedFilms.length === 0) {
      tbody.innerHTML = `<tr><td colspan="8" class="p-8 text-center text-zinc-500 font-bold">No accepted competition films to rank.</td></tr>`;
      return;
    }

    const evalMap = new Map(
      currentEvaluations.map((e) => [`${e.submission_id}_${e.jury_id}`, e]),
    );

    // Compute average score per film
    const rankedFilms = acceptedFilms.map((film) => {
      const filmEvals = currentEvaluations.filter(
        (e) => e.submission_id === film.id && e.is_submitted,
      );
      let avg = 0;
      if (filmEvals.length > 0) {
        const sum = filmEvals.reduce(
          (acc, curr) => acc + (curr.total_score || 0),
          0,
        );
        avg = sum / filmEvals.length;
      }
      return {
        ...film,
        evalCount: filmEvals.length,
        averageScore: avg,
      };
    });

    // Sort descending by average score
    rankedFilms.sort((a, b) => b.averageScore - a.averageScore);

    tbody.innerHTML = rankedFilms
      .map((film, index) => {
        const rank = index + 1;
        let rankBadge = `<span class="font-black text-sm text-zinc-700">${rank}</span>`;

        if (rank === 1)
          rankBadge = `<span class="px-2 py-0.5 bg-[#FDB813] text-black font-black text-xs rounded shadow-xs">🥇 1st</span>`;
        else if (rank === 2)
          rankBadge = `<span class="px-2 py-0.5 bg-zinc-300 text-black font-black text-xs rounded shadow-xs">🥈 2nd</span>`;
        else if (rank === 3)
          rankBadge = `<span class="px-2 py-0.5 bg-amber-700 text-white font-black text-xs rounded shadow-xs">🥉 3rd</span>`;

        return `
        <tr class="hover:bg-zinc-50 transition-colors ${rank <= 3 ? "bg-amber-50/30" : ""}">
          <td class="p-3 border-r border-zinc-200 text-center font-black">${rankBadge}</td>
          <td class="p-3 border-r border-zinc-200 font-bold select-all text-[#B31D12]">${film.entry_number}</td>
