---
// src/pages/venue.astro
import Layout from "../layouts/Layout.astro";

const venueHighlights = [
  {
    title: "Main Screening Hall",
    location: "Veena - Varna Theatre, Mananthavady",
    desc: "Primary indoor screening auditorium for official competition entries, open forum discussions, and the grand finale awards ceremony.",
  },
  {
    title: "Outdoor LED Arena",
    location: "Theatre Courtyard & Public Square",
    desc: "High-resolution outdoor LED wall setup outside the theatre to accommodate large audiences and festival attendees.",
  },
  {
    title: "Admission & Access",
    location: "Free Entry (Mandatory Registration)",
    desc: "Admission to all screening sessions is completely free. Prior registration is required to receive festival delegate passes.",
  },
];

const venuePhotos = [
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWk2MknLWIqh0cH_T_5SS4ZCOdQ6m98hAcivf5327pxGbv8fUboHDcGpPJvXS2pp5KtSpx5SOrcdXIMm9CvRB5LnRjq8bGdIyN9oG_bDxkXMZbA1L8D_nNsTYjbPlSHgPnRHS_8=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Mananthavady Exterior View",
    caption: "Veena - Varna Theatre, Mananthavady",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmnOolYFfIMXhp8ibmV3IqqwWSCYQt2kwCrvX37xAtsv8p9qm7lTU7cUVbaOxt3dCAiav200w2xxFjq38NOIPtMm30yBQa_oasvMUoGwP_zD0RgfnTkGioJP4_GMyiMoROLv7r-=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Complex Front View",
    caption: "Theatre Entrance & Screening Complex",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkasxHpu9cB217yC4O9nTsEV1K8cxwBROCnw5TcGY9B063__2-MNIaCodsp4nqVN0cJgEfLw6x2VAYnXv7bRfNgtFH-8KRyiQEr_m8MevPCmtBguqr_q9g-6nTzENAHd5QjPfkU=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Arena View",
    caption: "Auditorium & Arena View",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkMawIDzrhLFrPCx4vY08os953QAkom87-dK1OhNaKlzoNTix8-2QUsSq7yQK-5eUu_jVyQ-HiL7bF6K5JML8E07IVJinHhlCJnBb2BLPKmYTOuEBb3Gmn5gTBFNPBCk9EW7zXUFg=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Screening Complex",
    caption: "Venue Surroundings & Compound",
  },
];

const travelInfo = [
  {
    mode: "By Bus",
    detail:
      "Mananthavady KSRTC Bus Station is just 1 km from the theatre. Direct buses operate from Kozhikode, Kannur, Sultan Bathery, and Kalpetta.",
  },
  {
    mode: "By Train",
    detail:
      "Nearest railway stations are Thalassery (approx. 80 km) and Kozhikode (approx. 105 km), connected by frequent road transport.",
  },
  {
    mode: "By Air",
    detail:
      "Kannur International Airport (CNN) is the nearest airport, located approximately 70 km from Mananthavady.",
  },
];
---

<Layout title="Venue & Access | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          >
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Location</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none"
        >
          Festival Venue
        </h1>
        <p
          class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed"
        >
          Veena - Varna Theatre, Mananthavady, Wayanad. Featuring the indoor
          cinema auditorium and an open-air outdoor LED arena.
        </p>
      </header>

      <!-- Key Highlights Grid -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {
          venueHighlights.map((item, idx) => (
            <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 shadow-[5px_5px_0px_0px_#161616] space-y-3 flex flex-col justify-between">
              <div class="space-y-2">
                <span class="font-mono text-xs font-bold text-[#D9381E] block">
                  0{idx + 1}.
                </span>
                <h2 class="text-xl font-black uppercase text-[#161616] tracking-tight">
                  {item.title}
                </h2>
                <p class="font-mono text-xs font-bold text-zinc-900">
                  {item.location}
                </p>
              </div>
              <p class="font-mono text-xs text-zinc-700 leading-relaxed pt-2 border-t border-zinc-300">
                {item.desc}
              </p>
            </div>
          ))
        }
      </section>

      <!-- Venue Photography Grid -->
      <section class="space-y-6">
        <div
          class="border-b-2 border-[#161616] pb-3 flex items-baseline justify-between"
        >
          <h2
            class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#161616]"
          >
            Venue &amp; Atmosphere
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500">
            Mananthavady, Wayanad
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            venuePhotos.map((photo) => (
              <div class="border-2 border-[#161616] bg-[#F6F4EE] shadow-[5px_5px_0px_0px_#161616] p-4 space-y-3">
                <div class="border-2 border-[#161616] h-[280px] sm:h-[340px] bg-[#161616] p-1.5 flex items-center justify-center overflow-hidden">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                </div>
                <p class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-800 text-center">
                  {photo.caption}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Location Map & Directions Section -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3">
          <h2
            class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#161616]"
          >
            How to Reach
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            travelInfo.map((item, idx) => (
              <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 shadow-[4px_4px_0px_0px_#161616] space-y-2">
                <div class="flex items-center gap-2 font-mono text-xs font-bold text-[#D9381E]">
                  <span>0{idx + 1}.</span>
                  <h3 class="uppercase text-[#161616] text-sm font-black">
                    {item.mode}
                  </h3>
                </div>
                <p class="font-mono text-xs text-zinc-700 leading-relaxed">
                  {item.detail}
                </p>
              </div>
            ))
          }
        </div>

        <!-- Address Box -->
        <div
          class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-2 font-mono text-xs sm:text-sm"
        >
          <span
            class="font-bold uppercase tracking-widest text-[#D9381E] block text-[11px]"
          >
            Official Venue Address
          </span>
          <p class="font-black text-base text-[#161616]">
            Veena - Varna Theatre Complex
          </p>
          <p class="text-zinc-700">
            Main Road, Mananthavady, Wayanad District, Kerala — 670645
          </p>
          <p class="text-zinc-500 text-xs pt-1">
            Organized in association with Mananthavady Municipality &amp;
            Pazhassi Raja Smaraka Granthalayam.
          </p>
        </div>
      </section>

      <!-- Bottom Submission Route -->
      <div
        class="border-t-2 border-[#161616] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs"
      >
        <a
          href="/contact"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          &larr; Need Help? Contact Helpdesk
        </a>

        <a
          href="/submit"
          class="inline-flex items-center gap-2 px-6 py-3 font-black uppercase tracking-widest text-[#F6F4EE] bg-[#161616] shadow-[3px_3px_0px_0px_#D9381E] hover:bg-[#D9381E] transition-all"
        >
          <span>Submit Film to Season 03</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
