---
// src/pages/venue.astro
import Layout from "../layouts/Layout.astro";

const venueHighlights = [
  {
    title: "Main Screening Hall",
    location: "Veena - Varna Theatre, Mananthavady",
    desc: "Primary indoor screening auditorium for official competition entries, open forum discussions, and the grand finale awards ceremony.",
  },
  {
    title: "Outdoor LED Arena",
    location: "Theatre Courtyard & Public Square",
    desc: "High-resolution outdoor LED wall setup outside the theatre to accommodate large audiences and festival attendees.",
  },
  {
    title: "Admission & Access",
    location: "Free Entry (Mandatory Registration)",
    desc: "Admission to all screening sessions is completely free. Prior registration is required to receive festival delegate passes.",
  },
];

const venuePhotos = [
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWk2MknLWIqh0cH_T_5SS4ZCOdQ6m98hAcivf5327pxGbv8fUboHDcGpPJvXS2pp5KtSpx5SOrcdXIMm9CvRB5LnRjq8bGdIyN9oG_bDxkXMZbA1L8D_nNsTYjbPlSHgPnRHS_8=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Mananthavady Exterior View",
    caption: "Veena - Varna Theatre, Mananthavady",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmnOolYFfIMXhp8ibmV3IqqwWSCYQt2kwCrvX37xAtsv8p9qm7lTU7cUVbaOxt3dCAiav200w2xxFjq38NOIPtMm30yBQa_oasvMUoGwP_zD0RgfnTkGioJP4_GMyiMoROLv7r-=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Complex Front View",
    caption: "Theatre Entrance & Screening Complex",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkasxHpu9cB217yC4O9nTsEV1K8cxwBROCnw5TcGY9B063__2-MNIaCodsp4nqVN0cJgEfLw6x2VAYnXv7bRfNgtFH-8KRyiQEr_m8MevPCmtBguqr_q9g-6nTzENAHd5QjPfkU=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Arena View",
    caption: "Auditorium & Arena View",
  },
  {
    src: "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWkMawIDzrhLFrPCx4vY08os953QAkom87-dK1OhNaKlzoNTix8-2QUsSq7yQK-5eUu_jVyQ-HiL7bF6K5JML8E07IVJinHhlCJnBb2BLPKmYTOuEBb3Gmn5gTBFNPBCk9EW7zXUFg=s1360-w1360-h1020-rw",
    alt: "Veena - Varna Theatre Screening Complex",
    caption: "Venue Surroundings & Compound",
  },
];

const travelInfo = [
  {
    mode: "By Bus",
    detail:
      "Mananthavady KSRTC Bus Station is just 1 km from the theatre. Direct buses operate from Kozhikode, Kannur, Sultan Bathery, and Kalpetta.",
  },
  {
    mode: "By Train",
    detail:
      "Nearest railway stations are Thalassery (approx. 80 km) and Kozhikode (approx. 105 km), connected by frequent road transport.",
  },
  {
    mode: "By Air",
    detail:
      "Kannur International Airport (CNN) is the nearest airport, located approximately 70 km from Mananthavady.",
  },
];
---

<Layout title="Venue & Access | PSFF Season 03">
  <div
    class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-4 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
  >
    <!-- Background Frame Accents -->
    <div
      class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
      <svg
        class="absolute -left-20 top-20 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8"></circle>
      </svg>
      <svg
        class="absolute -right-24 bottom-24 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6"></circle>
      </svg>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-16 sm:space-y-20">
      <!-- Page Header -->
      <header class="border-b border-[#FDB813]/30 pb-8 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-200"
        >
          <a href="/" class="hover:text-[#FDB813] transition-colors"
            >&larr; Home</a
          >
          <span>&bull;</span>
          <span class="text-[#FDB813] font-bold">Location</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white font-mono leading-none drop-shadow-sm"
        >
          Festival Venue
        </h1>
        <p
          class="font-mono text-sm sm:text-base text-zinc-200 max-w-3xl leading-relaxed"
        >
          Veena - Varna Theatre, Mananthavady, Wayanad . Featuring the indoor
          cinema auditorium and an open-air outdoor LED arena .
        </p>
      </header>

      <!-- Key Highlights Grid (High-Contrast Cards) -->
      <section class="grid grid-cols-1 md:grid-cols-3 gap-6 font-mono">
        {
          venueHighlights.map((item, idx) => (
            <div class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 shadow-[6px_6px_0px_0px_#000000] space-y-3 flex flex-col justify-between hover:-translate-y-1 hover:shadow-[8px_8px_0px_0px_#FDB813] transition-all">
              <div class="space-y-2">
                <span class="text-xs font-black text-[#B31D12] block">
                  0{idx + 1}.
                </span>
                <h2 class="text-xl font-black uppercase text-[#18181B] tracking-tight font-mono">
                  {item.title}
                </h2>
                <p class="text-xs font-bold text-[#B31D12]">{item.location}</p>
              </div>
              <p class="text-xs text-zinc-700 leading-relaxed pt-3 border-t-2 border-black/10 font-sans">
                {item.desc}
              </p>
            </div>
          ))
        }
      </section>

      <!-- Venue Photography Grid -->
      <section class="space-y-6">
        <div
          class="border-b border-[#FDB813]/30 pb-3 flex items-baseline justify-between"
        >
          <h2
            class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono"
          >
            Venue &amp; Atmosphere
          </h2>
          <span class="font-mono text-xs uppercase text-[#FDB813] font-bold">
            Mananthavady, Wayanad
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            venuePhotos.map((photo) => (
              <div class="border border-[#FDB813]/40 bg-[#8B140B]/90 rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,0.35)] p-4 space-y-3 backdrop-blur-xs">
                <div class="border border-[#FDB813]/30 rounded-xl h-[280px] sm:h-[340px] bg-[#5C0D07] p-2 flex items-center justify-center overflow-hidden shadow-inner">
                  <img
                    src={photo.src}
                    alt={photo.alt}
                    class="w-full h-full object-contain rounded-lg"
                    loading="lazy"
                  />
                </div>
                <p class="font-mono text-xs font-bold uppercase tracking-wider text-[#FDB813] text-center">
                  {photo.caption}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Location Map & Directions Section -->
      <section class="space-y-6 font-mono">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2
            class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-white font-mono"
          >
            How to Reach
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            travelInfo.map((item, idx) => (
              <div class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 shadow-[5px_5px_0px_0px_#000000] space-y-2">
                <div class="flex items-center gap-2 text-xs font-black text-[#B31D12]">
                  <span>0{idx + 1}. </span>
                  <h3 class="uppercase text-[#18181B] text-sm font-black font-mono">
                    {item.mode}
                  </h3>
                </div>
                <p class="text-xs text-zinc-700 leading-relaxed font-sans pt-1">
                  {item.detail}
                </p>
              </div>
            ))
          }
        </div>

        <!-- Address Box (High-Contrast Slate) -->
        <div
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000] space-y-2 text-xs sm:text-sm"
        >
          <span
            class="font-black uppercase tracking-widest text-[#B31D12] block text-[11px]"
          >
            Official Venue Address
          </span>
          <p class="font-black text-base text-[#18181B] font-mono">
            Veena - Varna Theatre Complex
          </p>
          <p class="text-zinc-700 font-sans">
            Main Road, Mananthavady, Wayanad District, Kerala — 670645
          </p>
          <p class="text-zinc-500 text-xs pt-1 font-sans">
            Organized by Pazhassi Raja Smaraka Granthalayam in association with
            Mananthavady Municipality.
          </p>
        </div>
      </section>

      <!-- Bottom Submission Route -->
      <div
        class="border-t border-[#FDB813]/30 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs"
      >
        <a
          href="/contact"
          class="font-bold uppercase tracking-wider text-zinc-200 hover:text-[#FDB813] transition-colors"
        >
          &larr; Need Help? Contact Helpdesk
        </a>

        <a
          href="/submit"
          class="inline-flex items-center gap-2 px-6 py-3 font-black uppercase tracking-widest text-[#B31D12] bg-[#FDB813] hover:bg-white rounded-lg shadow-[2px_2px_0px_0px_#000000] hover:-translate-y-0.5 transition-all cursor-pointer"
        >
          <span>Submit Film to Season 03</span>
          <span>&rarr; </span>
        </a>
      </div>
    </div>
  </div>
</Layout>
