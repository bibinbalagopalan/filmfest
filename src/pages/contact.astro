---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";

const emailChannels = [
  {
    role: "General Helpdesk & Queries",
    email: "help@psff.in",
    desc: "General inquiries, delegate registration, and festival assistance.",
    primary: true,
  },
  {
    role: "Film Submissions & Technical Desk",
    email: "submissions@psff.in",
    desc: "Screener links, subtitle validation, and technical file queries.",
    primary: false,
  },
  {
    role: "Press, Media & Communications",
    email: "press@psff.in",
    desc: "Media accreditation, official bulletins, and interview inquiries.",
    primary: false,
  },
  {
    role: "Festival Directorate & Partnerships",
    email: "directorate@psff.in",
    desc: "Institutional tie-ups, sponsorship, and committee communication.",
    primary: false,
  },
];

const phoneNumbers = [
  {
    name: "Vishnu K",
    role: "Festival Convenor",
    number: "+91 62351 34455",
    raw: "6235134455",
  },
  {
    name: "Bibin Balagopal",
    role: "Festival Convenor",
    number: "+91 8590204208",
    raw: "8590204208",
  },
  {
    name: "KP Sunith",
    role: "Festival Director",
    number: "+91 92497 74814",
    raw: "9249774814",
  },
  {
    name: "Pazhassi Smaraka Granthalayam",
    role: "Library Office Landline",
    number: "04935 242756",
    raw: "04935242756",
  },
  {
    name: "Arun EV",
    role: "Secretary, Pazhassi Smaraka Granthalayam & Festival Patron",
    number: "+91 94466 40764",
    raw: "9446640764",
  },
];

const inquiryTypes = [
  "Film Submission & Technical Queries",
  "Delegate Registration & Venue Access",
  "Press & Media Accreditation",
  "Sponsorship & Partnerships",
  "General Inquiries",
];
---

<Layout title="Contact & Helpdesk | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          >
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Helpdesk</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none"
        >
          Contact
        </h1>
        <p
          class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed"
        >
          Official contact points for film submissions, delegate passes, press
          accreditation, and festival management.
        </p>
      </header>

      <!-- Section 1: Departmental Email Channels -->
      <section class="space-y-6">
        <div
          class="border-b-2 border-[#161616] pb-3 flex items-baseline justify-between"
        >
          <h2
            class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-[#161616]"
          >
            Official Email Channels
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Direct Desks
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            emailChannels.map((channel) => (
              <div
                class={`border-2 border-[#161616] p-6 shadow-[5px_5px_0px_0px_#161616] space-y-2 flex flex-col justify-between ${
                  channel.primary
                    ? "bg-[#161616] text-[#F6F4EE] shadow-[5px_5px_0px_0px_#D9381E]"
                    : "bg-[#F6F4EE] text-[#161616]"
                }`}
              >
                <div class="space-y-1.5">
                  <span
                    class={`font-mono text-[11px] uppercase tracking-widest font-bold block ${
                      channel.primary ? "text-[#D9381E]" : "text-zinc-500"
                    }`}
                  >
                    {channel.role}
                  </span>
                  <a
                    href={`mailto:${channel.email}`}
                    class={`text-xl sm:text-2xl font-mono font-black tracking-tight block hover:text-[#D9381E] transition-colors ${
                      channel.primary ? "text-white" : "text-[#161616]"
                    }`}
                  >
                    {channel.email}
                  </a>
                </div>
                <p
                  class={`font-mono text-xs pt-2 border-t ${
                    channel.primary
                      ? "border-zinc-800 text-zinc-400"
                      : "border-zinc-300 text-zinc-700"
                  }`}
                >
                  {channel.desc}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 2: Designated Contact Directory & Form -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Key Officials & Secretariat Address -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Key Officials Phone List -->
          <div
            class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-6"
          >
            <div class="border-b border-zinc-300 pb-2">
              <span
                class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E]"
              >
                Direct Contacts &amp; Helplines
              </span>
            </div>

            <div class="divide-y divide-zinc-300 space-y-4 font-mono">
              {
                phoneNumbers.map((phone, idx) => (
                  <div class={idx > 0 ? "pt-4 space-y-1" : "space-y-1"}>
                    <div class="flex items-baseline justify-between gap-2">
                      <h3 class="text-base font-black text-[#161616] uppercase">
                        {phone.name}
                      </h3>
                    </div>
                    <span class="block text-[11px] uppercase tracking-wider text-zinc-500 font-bold">
                      {phone.role}
                    </span>
                    <a
                      href={`tel:${phone.raw}`}
                      class="text-base font-black text-[#161616] hover:text-[#D9381E] transition-colors inline-block pt-0.5"
                    >
                      {phone.number}
                    </a>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Festival Secretariat Postal Address -->
          <div
            class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-4"
          >
            <div class="border-b border-zinc-300 pb-2">
              <span
                class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E]"
              >
                Write to Us
              </span>
            </div>

            <div
              class="font-mono text-xs sm:text-sm text-zinc-800 space-y-1 leading-relaxed"
            >
              <p class="font-black text-[#161616] text-sm sm:text-base">
                Festival Director
              </p>
              <p class="font-bold">
                Pazhassi Short Film Festival (PSFF Season 03)
              </p>
              <p>Pazhassi Raja Smaraka Granthalayam</p>
              <p>Mananthavady P.O., Medical College Road</p>
              <p>Mananthavady, Wayanad District, Kerala — 670645</p>
            </div>
          </div>
        </div>

        <!-- Right: Message Form -->
        <div
          class="lg:col-span-6 border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#161616] space-y-6"
        >
          <div class="border-b border-zinc-300 pb-3">
            <h2
              class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#161616]"
            >
              Send a Direct Message
            </h2>
            <p class="font-mono text-xs text-zinc-600 mt-1">
              Submit your query and the help desk will respond directly.
            </p>
          </div>

          <form
            action="mailto:help@psff.in"
            method="POST"
            enctype="text/plain"
            class="space-y-4 font-mono text-xs"
          >
            <div class="space-y-1.5">
              <label
                for="name"
                class="block font-bold uppercase tracking-wider text-[#161616]"
              >
                Full Name *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Enter your name"
                class="w-full bg-white border-2 border-[#161616] p-3 text-xs text-[#161616] focus:outline-none focus:border-[#D9381E]"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label
                  for="email"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="w-full bg-white border-2 border-[#161616] p-3 text-xs text-[#161616] focus:outline-none focus:border-[#D9381E]"
                />
              </div>

              <div class="space-y-1.5">
                <label
                  for="phone"
                  class="block font-bold uppercase tracking-wider text-[#161616]"
                >
                  Contact Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+91 00000 00000"
                  class="w-full bg-white border-2 border-[#161616] p-3 text-xs text-[#161616] focus:outline-none focus:border-[#D9381E]"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label
                for="subject"
                class="block font-bold uppercase tracking-wider text-[#161616]"
              >
                Department / Inquiry Type *
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full bg-white border-2 border-[#161616] p-3 text-xs text-[#161616] focus:outline-none focus:border-[#D9381E]"
              >
                {
                  inquiryTypes.map((type) => (
                    <option value={type}>{type}</option>
                  ))
                }
              </select>
            </div>

            <div class="space-y-1.5">
              <label
                for="message"
                class="block font-bold uppercase tracking-wider text-[#161616]"
              >
                Your Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Please describe your query in detail..."
                class="w-full bg-white border-2 border-[#161616] p-3 text-xs text-[#161616] focus:outline-none focus:border-[#D9381E]"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 text-xs font-mono font-black uppercase tracking-widest text-[#F6F4EE] bg-[#161616] border-2 border-[#161616] shadow-[3px_3px_0px_0px_#D9381E] hover:bg-[#D9381E] hover:border-[#D9381E] hover:text-white transition-all cursor-pointer"
            >
              Submit &rarr;
            </button>
          </form>
        </div>
      </div>

      <!-- Quick Navigation Footer -->
      <div
        class="border-t-2 border-[#161616] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs"
      >
        <a
          href="/venue"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          &larr; View Venue &amp; Travel Guide
        </a>

        <a
          href="/submit"
          class="inline-flex items-center gap-2 px-6 py-3 font-black uppercase tracking-widest text-[#F6F4EE] bg-[#161616] shadow-[3px_3px_0px_0px_#D9381E] hover:bg-[#D9381E] transition-all"
        >
          <span>Submit Film to Season 03</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</Layout>
