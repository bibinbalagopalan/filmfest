---
// src/pages/rules.astro
import Layout from "../layouts/Layout.astro";

const awards = [
  {
    rank: "01",
    title: "Best Short Film",
    prize: "₹25,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "02",
    title: "Best Director",
    prize: "₹15,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "03",
    title: "Best Cinematographer",
    prize: "₹10,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "04",
    title: "Best Popular Short Film",
    prize: "₹10,000",
    extra: "Audience Electronic Voting & Citation",
  },
];

const keyGuidelines = [
  {
    title: "Maximum Runtime",
    desc: "Total running time must not exceed 30 minutes, including opening and closing credits.",
  },
  {
    title: "Submission Deadline",
    desc: "All entries, screening links, and registration fees must be received on or before 30 September 2026.",
  },
  {
    title: "Technical Delivery Format",
    desc: "Submissions must be delivered in Full HD (1080p minimum) in MP4 (H.264 / AAC) broadcast quality.",
  },
  {
    title: "Official Screenings",
    desc: "Exactly 10 films will be selected by the screening committee for official public screenings at the festival venue.",
  },
  {
    title: "Entry Fee",
    desc: "A non-refundable registration fee of ₹1,000 is required per submitted entry.",
  },
  {
    title: "Multiple Entries",
    desc: "Filmmakers, production companies, or academic institutions may submit multiple films. Each requires a separate entry and fee.",
  },
];

const legalSections = [
  {
    title: "1. Eligibility & Production Year",
    points: [
      "Films completed between 01 September 2023 and 31 August 2026 are eligible for competitive consideration in Season 03.",
      "Entries in languages other than English or Malayalam must have embedded or burn-in English subtitles.",
      "Works that have previously been entered into past editions of the Pazhassi Short Film Festival are not eligible for re-submission.",
    ],
  },
  {
    title: "2. Copyrights, Music Licensing & Clearances",
    points: [
      "The applicant guarantees that they possess full legal authority to submit the film and that all copyrights, music synchronization licenses, actor releases, and literary properties have been lawfully cleared.",
      "The festival committee, organizers, and venue partners assume no responsibility for copyright infringements, unauthorized samples, or intellectual property disputes arising from submitted works.",
      "Applicants agree to indemnify and hold harmless the Pazhassi Short Film Festival, Drishtidosham Chalachithravedi, and affiliated bodies against any third-party legal claims, damages, or costs.",
    ],
  },
  {
    title: "3. Selection, Screenings & Promotional Rights",
    points: [
      "The official selection of 10 films will be curated by the screening panel. Selection decisions are final and binding.",
      "Once a film is confirmed for the Official Selection, the entrant cannot withdraw the film from the festival program.",
      "By submitting, the applicant grants the festival the non-exclusive right to screen the film at the festival venue and utilize up to 60 seconds of video footage, trailer clips, stills, and posters for non-commercial promotional and broadcast purposes across print and digital media.",
    ],
  },
  {
    title: "4. Adjudication & Jury Decision",
    points: [
      "Competitive awards will be determined by an independent jury panel based on official scoring rubrics.",
      "The Popular Film award is decided exclusively by audience voting on-ground at the venue.",
      "The decision of the jury is final, sovereign, and not subject to appeal, review, or legal challenge.",
    ],
  },
  {
    title: "5. Disqualification & Force Majeure",
    points: [
      "Entries with incomplete screener links, corrupted files, unpaid fees, or runtime exceeding 30 minutes will be disqualified without refund.",
      "The festival directorate reserves the right to alter the schedule, venue arrangements, or award presentation format in the event of unforeseen technical circumstances, severe weather, or force majeure events.",
    ],
  },
];
---

<Layout title="Rules & Regulations | PSFF Season 03">
  <div
    class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-4 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
  >
    <!-- Background Frame Accents -->
    <div
      class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden"
    >
      <div
        class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
        style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
      >
      </div>
      <div
        class="absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>
      <svg
        class="absolute -left-20 top-20 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="140" stroke-dasharray="8 8"></circle>
      </svg>
      <svg
        class="absolute -right-24 bottom-24 w-[480px] h-[480px] text-[#FDB813]"
        viewBox="0 0 400 400"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190"
        ></path>
        <circle cx="200" cy="200" r="160" stroke-dasharray="6 6"></circle>
      </svg>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-16 sm:space-y-20">
      <!-- Page Header -->
      <header class="border-b border-[#FDB813]/30 pb-8 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-200"
        >
          <a href="/" class="hover:text-[#FDB813] transition-colors"
            >&larr; Home</a
          >
          <span>&bull;</span>
          <span class="text-[#FDB813] font-bold">Guidelines</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-white font-mono leading-none drop-shadow-sm"
        >
          Rules &amp; Regulations
        </h1>
        <p
          class="font-mono text-sm sm:text-base text-zinc-200 max-w-3xl leading-relaxed"
        >
          Official eligibility criteria, prize distribution, submission
          parameters, and legal terms for the 3rd Pazhassi Short Film Festival
          2026.
        </p>
      </header>

      <!-- Section 1: Official Cash Prizes & Awards Structure (High Contrast) -->
      <section class="space-y-6">
        <div
          class="border-b border-[#FDB813]/30 pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2"
        >
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono"
          >
            Awards &amp; Endowments
          </h2>
          <span class="font-mono text-xs uppercase text-[#FDB813] font-bold">
            Season 03 Purse
          </span>
        </div>

        <div
          class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl divide-y-2 divide-black/10 shadow-[6px_6px_0px_0px_#000000] overflow-hidden"
        >
          {
            awards.map((item) => (
              <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono hover:bg-zinc-50 transition-colors">
                <div class="space-y-1">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-black text-[#B31D12]">
                      {item.rank}.
                    </span>
                    <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-[#18181B] font-mono">
                      {item.title}
                    </h3>
                  </div>
                  <p class="text-xs text-zinc-600 pl-7 font-sans">
                    {item.extra}
                  </p>
                </div>

                <div class="pl-7 sm:pl-0 font-mono text-right flex sm:flex-col items-baseline sm:items-end justify-between">
                  <span class="text-2xl sm:text-3xl font-black text-[#18181B]">
                    {item.prize}
                  </span>
                  <span class="text-[10px] text-[#B31D12] uppercase tracking-widest font-black">
                    Award Value
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 2: Core Submission Guidelines (High Contrast Grid) -->
      <section class="space-y-6 font-mono">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono"
          >
            Key Entry Guidelines
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            keyGuidelines.map((item, idx) => (
              <div class="bg-[#FDFCF7] text-[#18181B] border-2 border-black rounded-2xl p-6 shadow-[5px_5px_0px_0px_#000000] flex flex-col justify-between space-y-4 hover:-translate-y-1 hover:shadow-[7px_7px_0px_0px_#FDB813] transition-all">
                <div class="space-y-2">
                  <span class="text-xs font-black text-[#B31D12] block">
                    0{idx + 1}.
                  </span>
                  <h3 class="text-lg font-black uppercase tracking-tight text-[#18181B] font-mono">
                    {item.title}
                  </h3>
                </div>
                <p class="text-xs text-zinc-700 leading-relaxed border-t-2 border-black/10 pt-3 font-sans">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 3: Comprehensive Legal Terms & Standards (High Contrast) -->
      <section class="space-y-6 font-mono">
        <div class="border-b border-[#FDB813]/30 pb-3">
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white font-mono"
          >
            Terms, Conditions &amp; Legal Clauses
          </h2>
        </div>

        <div class="space-y-6 text-xs sm:text-sm text-[#18181B]">
          {
            legalSections.map((sec) => (
              <div class="bg-[#FDFCF7] border-2 border-black rounded-2xl p-6 sm:p-8 shadow-[5px_5px_0px_0px_#000000] space-y-4">
                <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-[#18181B] font-mono border-b-2 border-black/10 pb-2">
                  {sec.title}
                </h3>
                <ul class="space-y-2.5 leading-relaxed font-sans text-zinc-800">
                  {sec.points.map((pt) => (
                    <li class="flex items-start gap-3">
                      <span class="text-[#B31D12] font-black mt-0.5 font-mono">
                        &bull;
                      </span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 4: Bottom Call to Action -->
      <section
        class="border-2 border-black bg-[#8B140B] text-[#FDFCF7] p-8 sm:p-10 rounded-2xl shadow-[6px_6px_0px_0px_#000000] flex flex-col md:flex-row md:items-center justify-between gap-6 font-mono"
      >
        <div class="space-y-2">
          <span
            class="inline-block text-xs uppercase tracking-widest text-[#FDB813] font-bold"
          >
            Ready to Enter?
          </span>
          <h3
            class="text-2xl sm:text-3xl font-black uppercase text-white tracking-tight font-mono"
          >
            Submit Your Short Film
          </h3>
          <p class="text-xs text-zinc-200 max-w-xl font-sans">
            <b>
              Entry Fee: ₹1,000 &bull; Deadline: 30 September 2026 &bull;
              Runtime &le; 30 Minutes
            </b>
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3.5 text-xs font-mono font-black uppercase tracking-wider text-[#B31D12] bg-[#FDB813] hover:bg-white rounded-lg transition-all shadow-[2px_2px_0px_0px_#000000] hover:-translate-y-0.5 cursor-pointer shrink-0"
        >
          Proceed to Submission &rarr;
        </a>
      </section>

      <!-- Navigation Routing -->
      <div
        class="border-t border-[#FDB813]/30 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs"
      >
        <a
          href="/schedule"
          class="font-bold uppercase tracking-wider text-zinc-200 hover:text-[#FDB813] transition-colors"
        >
          &larr; View Festival Schedule
        </a>

        <a
          href="/contact"
          class="font-bold uppercase tracking-wider text-zinc-200 hover:text-[#FDB813] transition-colors"
        >
          Have Questions? Contact Us &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
