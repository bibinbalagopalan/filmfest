---
// src/pages/rules.astro
import Layout from "../layouts/Layout.astro";

const awards = [
  {
    rank: "01",
    title: "Best Short Film",
    prize: "₹25,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "02",
    title: "Best Director",
    prize: "₹15,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "03",
    title: "Best Cinematographer",
    prize: "₹10,000",
    extra: "Festival Trophy & Citation",
  },
  {
    rank: "04",
    title: "Best Popular Short Film",
    prize: "₹10,000",
    extra: "Audience Electronic Voting & Citation",
  },
  {
    rank: "05",
    title: "Consolation Prizes (Official Selection)",
    prize: "₹2,500 each",
    extra: "Awarded to remaining non-winning films in the Top 10",
  },
];

const keyGuidelines = [
  {
    title: "Maximum Runtime",
    desc: "Total running time must not exceed 30 minutes, including opening and closing credits.",
  },
  {
    title: "Submission Deadline",
    desc: "All entries, screening links, and registration fees must be received on or before 30 September 2026.",
  },
  {
    title: "Technical Delivery Format",
    desc: "Submissions must be delivered in Full HD (1080p minimum) in MP4 (H.264 / AAC) broadcast quality.",
  },
  {
    title: "Official Screenings",
    desc: "Exactly 10 films will be selected by the screening committee for official public screenings at the festival venue.",
  },
  {
    title: "Entry Fee",
    desc: "A non-refundable registration fee of ₹1,000 is required per submitted entry.",
  },
  {
    title: "Multiple Entries",
    desc: "Filmmakers, production companies, or academic institutions may submit multiple films. Each requires a separate entry and fee.",
  },
];

const legalSections = [
  {
    title: "1. Eligibility & Production Year",
    points: [
      "Films completed between 01 September 2025 and 31 August 2026 are eligible for competitive consideration in Season 03.",
      "Entries in languages other than English or Malayalam must have embedded or burn-in English subtitles.",
      "Works that have previously been entered into past editions of the Pazhassi Short Film Festival are not eligible for re-submission.",
    ],
  },
  {
    title: "2. Copyrights, Music Licensing & Clearances",
    points: [
      "The applicant guarantees that they possess full legal authority to submit the film and that all copyrights, music synchronization licenses, actor releases, and literary properties have been lawfully cleared.",
      "The festival committee, organizers, and venue partners assume no responsibility for copyright infringements, unauthorized samples, or intellectual property disputes arising from submitted works.",
      "Applicants agree to indemnify and hold harmless the Pazhassi Short Film Festival, Drishtidosham Chalachithravedi, and affiliated bodies against any third-party legal claims, damages, or costs.",
    ],
  },
  {
    title: "3. Selection, Screenings & Promotional Rights",
    points: [
      "The official selection of 10 films will be curated by the screening panel. Selection decisions are final and binding.",
      "Once a film is confirmed for the Official Selection, the entrant cannot withdraw the film from the festival program.",
      "By submitting, the applicant grants the festival the non-exclusive right to screen the film at the festival venue and utilize up to 60 seconds of video footage, trailer clips, stills, and posters for non-commercial promotional and broadcast purposes across print and digital media.",
    ],
  },
  {
    title: "4. Adjudication & Jury Decision",
    points: [
      "Competitive awards will be determined by an independent jury panel based on official scoring rubrics.",
      "The Popular Film award is decided exclusively by audience voting on-ground at the venue.",
      "The decision of the jury is final, sovereign, and not subject to appeal, review, or legal challenge.",
    ],
  },
  {
    title: "5. Disqualification & Force Majeure",
    points: [
      "Entries with incomplete screener links, corrupted files, unpaid fees, or runtime exceeding 30 minutes will be disqualified without refund.",
      "The festival directorate reserves the right to alter the schedule, venue arrangements, or award presentation format in the event of unforeseen technical circumstances, severe weather, or force majeure events.",
    ],
  },
];
---

<Layout title="Rules & Regulations | PSFF Season 03">
  <div
    class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]"
  >
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div
          class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500"
        >
          <a href="/" class="hover:text-[#D9381E] transition-colors"
            >&larr; Home</a
          >
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Guidelines</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1
          class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none"
        >
          Rules &amp; Regulations
        </h1>
        <p
          class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed"
        >
          Official eligibility criteria, prize distribution, submission
          parameters, and legal terms for the 3rd Pazhassi Short Film Festival
          2026.
        </p>
      </header>

      <!-- Section 1: Official Cash Prizes & Awards Structure -->
      <section class="space-y-6">
        <div
          class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2"
        >
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]"
          >
            Awards &amp; Endowments
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Season 03 Purse
          </span>
        </div>

        <div
          class="border-2 border-[#161616] bg-[#F6F4EE] divide-y-2 divide-[#161616] shadow-[6px_6px_0px_0px_#161616]"
        >
          {
            awards.map((item) => (
              <div class="p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono">
                <div class="space-y-1">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-black text-[#D9381E]">
                      {item.rank}.
                    </span>
                    <h3 class="text-lg sm:text-xl font-black uppercase tracking-tight text-[#161616]">
                      {item.title}
                    </h3>
                  </div>
                  <p class="text-xs text-zinc-600 pl-7 font-sans">
                    {item.extra}
                  </p>
                </div>

                <div class="pl-7 sm:pl-0 font-mono text-right flex sm:flex-col items-baseline sm:items-end justify-between">
                  <span class="text-2xl sm:text-3xl font-black text-[#161616]">
                    {item.prize}
                  </span>
                  <span class="text-[10px] text-zinc-500 uppercase tracking-widest font-bold">
                    Award Value
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 2: Core Submission Guidelines -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3">
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]"
          >
            Key Entry Guidelines
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            keyGuidelines.map((item, idx) => (
              <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 shadow-[5px_5px_0px_0px_#161616] flex flex-col justify-between space-y-4">
                <div class="space-y-2">
                  <span class="font-mono text-xs font-bold text-[#D9381E] block">
                    0{idx + 1}.
                  </span>
                  <h3 class="text-lg font-black uppercase tracking-tight text-[#161616]">
                    {item.title}
                  </h3>
                </div>
                <p class="font-mono text-xs text-zinc-700 leading-relaxed border-t border-zinc-300 pt-3">
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 3: Comprehensive Legal Terms & Standards -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3">
          <h2
            class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]"
          >
            Terms, Conditions &amp; Legal Clauses
          </h2>
        </div>

        <div class="space-y-8 font-mono text-xs sm:text-sm text-zinc-800">
          {
            legalSections.map((sec) => (
              <div class="border-2 border-[#161616] bg-[#F6F4EE] p-6 sm:p-8 shadow-[5px_5px_0px_0px_#161616] space-y-4">
                <h3 class="text-base sm:text-lg font-black uppercase tracking-tight text-[#161616] border-b border-zinc-300 pb-2">
                  {sec.title}
                </h3>
                <ul class="space-y-2.5 leading-relaxed">
                  {sec.points.map((pt) => (
                    <li class="flex items-start gap-3">
                      <span class="text-[#D9381E] font-bold mt-0.5">
                        &bull;
                      </span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Section 4: Bottom Call to Action -->
      <section
        class="border-2 border-[#161616] bg-[#161616] text-[#F6F4EE] p-8 sm:p-10 shadow-[6px_6px_0px_0px_#D9381E] flex flex-col md:flex-row md:items-center justify-between gap-6"
      >
        <div class="space-y-2">
          <span
            class="inline-block font-mono text-xs uppercase tracking-widest text-[#D9381E] font-bold"
          >
            Ready to Enter?
          </span>
          <h3
            class="text-2xl sm:text-3xl font-black uppercase text-white tracking-tight"
          >
            Submit Your Short Film
          </h3>
          <p class="font-mono text-xs text-zinc-400 max-w-xl">
            Entry Fee: ₹1,000 &bull; Deadline: 30 September 2026 &bull; Runtime
            &le; 30 Minutes
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3.5 text-xs font-mono font-black uppercase tracking-wider text-[#161616] bg-[#F6F4EE] hover:bg-[#D9381E] hover:text-white transition-all shadow-[3px_3px_0px_0px_#D9381E]"
        >
          Proceed to Submission &rarr;
        </a>
      </section>

      <!-- Navigation Routing -->
      <div
        class="border-t-2 border-[#161616] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs"
      >
        <a
          href="/schedule"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          &larr; View Festival Schedule
        </a>

        <a
          href="/contact"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          Have Questions? Contact Us &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>
