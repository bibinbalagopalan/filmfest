---
// src/pages/schedule.astro
import Layout from "../layouts/Layout.astro";

const timelinePhases = [
  {
    phase: "01",
    status: "Call for Entries",
    dates: "01 September — 30 September 2026",
    title: "Online Submissions Window",
    desc: "Open for short films completed between 01 September 2025 and 31 August 2026. Submissions must be under 30 minutes runtime.",
    badge: "Active",
    badgeColor: "bg-[#D9381E] text-white",
  },
  {
    phase: "02",
    status: "Phase 01 Review",
    dates: "01 October — 30 October 2026",
    title: "Preliminary Screening & Elimination",
    desc: "The 12-member festival screening panel reviews all valid online entries to curate the official selection shortlist.",
    badge: "Screening Panel",
    badgeColor: "bg-[#161616] text-[#F6F4EE]",
  },
  {
    phase: "03",
    status: "Final Adjudication",
    dates: "01 November — 10 November 2026",
    title: "Main Jury Evaluation",
    desc: "The chief jury and evaluation committee view and score the shortlisted official selections against calibrated evaluation rubrics.",
    badge: "Main Jury",
    badgeColor: "bg-[#161616] text-[#F6F4EE]",
  },
  {
    phase: "04",
    status: "Grand Finale",
    dates: "28 November 2026",
    title: "Festival Screenings & Award Declaration",
    desc: "Public screenings at Veena - Varna Theatre and the outdoor LED arena, live audience electronic voting for Best Popular Film, and the awards ceremony.",
    badge: "Public Event",
    badgeColor: "bg-[#D9381E] text-white",
  },
];
---

<Layout title="Festival Schedule & Timeline | PSFF Season 03">
  <div class="w-full border-b border-zinc-900 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#D9381E] selection:text-[#F6F4EE]">
    <div class="max-w-6xl mx-auto space-y-16 sm:space-y-20">
      
      <!-- Page Header -->
      <header class="border-b-2 border-[#161616] pb-8 space-y-4">
        <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-zinc-500">
          <a href="/" class="hover:text-[#D9381E] transition-colors">&larr; Home</a>
          <span>&bull;</span>
          <span class="text-[#D9381E] font-bold">Timeline</span>
          <span>&bull;</span>
          <span>Season 03</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black uppercase tracking-tight text-[#161616] leading-none">
          Festival Schedule
        </h1>
        <p class="font-mono text-sm sm:text-base text-zinc-700 max-w-3xl leading-relaxed">
          Key dates, submission deadlines, jury evaluation phases, and the screening timeline for the 3rd Pazhassi Short Film Festival 2026.
        </p>
      </header>

      <!-- Section 1: 4-Phase Season Timeline -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
            Season 03 Roadmap
          </h2>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            August — November 2026
          </span>
        </div>

        <div class="border-2 border-[#161616] bg-[#F6F4EE] divide-y-2 divide-[#161616] shadow-[6px_6px_0px_0px_#161616]">
          {timelinePhases.map((phase) => (
            <div class="p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
              
              <div class="space-y-2 md:max-w-2xl">
                <div class="flex flex-wrap items-center gap-3 font-mono">
                  <span class="text-xs font-black text-[#D9381E]">PHASE {phase.phase}</span>
                  <span class="text-zinc-400">&bull;</span>
                  <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 ${phase.badgeColor}`}>
                    {phase.badge}
                  </span>
                </div>

                <h3 class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#161616]">
                  {phase.title}
                </h3>

                <p class="font-mono text-xs sm:text-sm text-zinc-700 leading-relaxed">
                  {phase.desc}
                </p>
              </div>

              <!-- Date Badge -->
              <div class="font-mono md:text-right border-t md:border-t-0 pt-4 md:pt-0 border-zinc-300 min-w-[260px]">
                <span class="text-[10px] uppercase text-zinc-500 font-bold block mb-1">
                  {phase.status}
                </span>
                <span class="text-base sm:text-lg font-black text-[#161616] block">
                  {phase.dates}
                </span>
              </div>

            </div>
          ))}
        </div>
      </section>

      <!-- Section 2: Grand Finale Program Notice -->
      <section class="space-y-6">
        <div class="border-b-2 border-[#161616] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
          <div>
            <span class="font-mono text-xs font-bold uppercase tracking-widest text-[#D9381E] block mb-1">
              Grand Finale Day
            </span>
            <h2 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-[#161616]">
              28 November 2026 Program
            </h2>
          </div>
          <span class="font-mono text-xs uppercase text-zinc-500 font-bold">
            Veena - Varna Theatre
          </span>
        </div>

        <div class="border-2 border-[#161616] bg-[#F6F4EE] p-8 sm:p-12 shadow-[5px_5px_0px_0px_#161616] text-center space-y-3">
          <span class="font-mono text-xs uppercase tracking-widest text-[#D9381E] font-bold block">
            Screening & Event Timeline
          </span>
          <p class="text-xl sm:text-2xl font-black uppercase tracking-tight text-[#161616]">
            Detailed Schedule Will Be Updated Shortly
          </p>
          <p class="font-mono text-xs sm:text-sm text-zinc-700 max-w-xl mx-auto leading-relaxed">
            The full lineup of competition screenings, open forum sessions, and the award ceremony order will be announced following the completion of jury evaluations.
          </p>
        </div>
      </section>

      <!-- Bottom Submission CTA -->
      <section class="border-2 border-[#161616] bg-[#161616] text-[#F6F4EE] p-8 sm:p-10 shadow-[6px_6px_0px_0px_#D9381E] flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#D9381E] font-bold">
            Submission Window
          </span>
          <h3 class="text-2xl sm:text-3xl font-black uppercase text-white tracking-tight">
            Entries Close: 30 September 2026
          </h3>
          <p class="font-mono text-xs text-zinc-400 max-w-xl">
            Submit your screener links, subtitle files, and film details before the window closes.
          </p>
        </div>

        <a
          href="/submit"
          class="inline-block px-6 py-3.5 text-xs font-mono font-black uppercase tracking-wider text-[#161616] bg-[#F6F4EE] hover:bg-[#D9381E] hover:text-white transition-all shadow-[3px_3px_0px_0px_#D9381E]"
        >
          Submit Entry Now &rarr;
        </a>
      </section>

      <!-- Footer Routing -->
      <div class="border-t-2 border-[#161616] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
        <a
          href="/venue"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          &larr; View Screening Venue &amp; Travel Guide
        </a>

        <a
          href="/rules"
          class="font-bold uppercase tracking-wider text-[#161616] hover:text-[#D9381E] transition-colors"
        >
          Read Rules &amp; Regulations &rarr;
        </a>
      </div>

    </div>
  </div>
</Layout>