---
// src/layouts/Layout.astro
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "3rd Pazhassi Short Film Festival 2026 | Mananthavady",
  description = "Official portal of the 3rd Pazhassi Short Film Festival (PSFF Season 03), organized by Drishtidosham Chalachithravedi and Pazhassi Raja Smaraka Granthalayam in collaboration with Mananthavady Municipality.",
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="bg-[#F6F4EE] text-[#161616] antialiased selection:bg-[#D9381E] selection:text-[#F6F4EE] scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;700;800&family=Noto+Sans+Malayalam:wght@400;700;900&family=Noto+Serif+Malayalam:wght@400;600;700;900&family=Syne:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        --font-display: "Syne", sans-serif;
        --font-editorial: "Instrument Serif", Georgia, serif;
        --font-mono: "JetBrains Mono", monospace;
        --font-malayalam: "Noto Sans Malayalam", sans-serif;
        --font-malayalam-serif: "Noto Serif Malayalam", serif;
      }
      .font-display {
        font-family: var(--font-display);
      }
      .font-editorial {
        font-family: var(--font-editorial);
      }
      .font-mono-custom {
        font-family: var(--font-mono);
      }
      .font-ml {
        font-family: var(--font-malayalam);
      }
      .font-ml-serif {
        font-family: var(--font-malayalam-serif);
      }

      /* Subtle Film Print Texture */
      .bg-editorial-grain {
        background-color: #f6f4ee;
        background-image:
          radial-gradient(
            at 100% 0%,
            rgba(217, 56, 30, 0.035) 0px,
            transparent 50%
          ),
          radial-gradient(
            at 0% 100%,
            rgba(67, 56, 202, 0.035) 0px,
            transparent 50%
          ),
          url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.035'/%3E%3C/svg%3E");
      }
    </style>
  </head>
  <body
    class="min-h-screen bg-editorial-grain text-[#161616] flex flex-col justify-between"
  >
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
