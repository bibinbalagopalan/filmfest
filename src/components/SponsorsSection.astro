---
// src/components/SponsorsSection.astro

const sponsors = [
  {
    name: "Pazhassi Raja Smaraka Granthalayam",
    logo: "https://i.ibb.co/Y7WYgy12/308498146-403106168660352-4248819466489882370-n.jpg",
    url: null,
  },
  {
    name: "Mananthavady Municipality",
    logo: "https://i.ibb.co/4Z0gvZ7M/Emblem-new.png",
    url: null,
  },
  {
    name: "Drishtidosham Chalachithravedi",
    logo: "https://i.ibb.co/8gND0Ktp/465973754-2789790697873483-7085224223616281315-n.jpg",
    url: null,
  },
  {
    name: "Aegis Auctor",
    logo: "https://i.ibb.co/sJ9gDy1d/Logo-NB.png",
    url: "https://www.aegisauctor.com",
  },
];
---

<section
  class="w-full bg-white text-zinc-950 border-b border-zinc-200 py-16 sm:py-24 px-6 sm:px-12 selection:bg-[#4338ca] selection:text-white"
>
  <div class="max-w-6xl mx-auto space-y-10 sm:space-y-12">
    <!-- Section Header -->
    <div class="border-b-2 border-zinc-950 pb-4">
      <h2
        class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-zinc-950"
      >
        Partners &amp; Sponsors
      </h2>
    </div>

    <!-- Full-Color Logo Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8">
      {
        sponsors.map((sponsor) => {
          const Wrapper = sponsor.url ? "a" : "div";
          const wrapperProps = sponsor.url
            ? {
                href: sponsor.url,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};

          return (
            <Wrapper
              {...wrapperProps}
              class={`border-2 border-zinc-950 bg-white p-6 sm:p-8 flex items-center justify-center aspect-square shadow-[4px_4px_0px_0px_#18181b] transition-all duration-150 ${sponsor.url ? "hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_#18181b]" : ""}`}
              title={sponsor.name}
            >
              <img
                src={sponsor.logo}
                alt={sponsor.name}
                class="max-h-full max-w-full object-contain"
                loading="lazy"
              />
            </Wrapper>
          );
        })
      }
    </div>
  </div>
</section>
