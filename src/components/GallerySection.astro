---
// src/components/GallerySection.astro

const photos = [
  {
    src: "https://i.ibb.co/mC4H1MgK/1.jpg",
    alt: "Festival archives moment 1",
    span: "col-span-1 md:col-span-2 row-span-2 aspect-[4/3] md:aspect-auto",
  },
  {
    src: "https://i.ibb.co/KxHxmk1T/2.jpg",
    alt: "Festival archives moment 2",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/TBTCTz1z/3.jpg",
    alt: "Festival archives moment 3",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/JwZj6Tdk/4.jpg",
    alt: "Festival archives moment 4",
    span: "col-span-1 md:col-span-2 aspect-[16/9]",
  },
  {
    src: "https://i.ibb.co/hRBb5YNy/5.jpg",
    alt: "Festival archives moment 5",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/Qj8VWR5G/6.jpg",
    alt: "Festival archives moment 6",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/WNkXQhPH/7.jpg",
    alt: "Festival archives moment 7",
    span: "col-span-1 md:col-span-2 aspect-[16/9]",
  },
  {
    src: "https://i.ibb.co/B53kxjGZ/8.jpg",
    alt: "Festival archives moment 8",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/tp8Hh3Vg/9.jpg",
    alt: "Festival archives moment 9",
    span: "col-span-1 aspect-[4/3]",
  },
  {
    src: "https://i.ibb.co/4g9Y6xp5/10.jpg",
    alt: "Festival archives moment 10",
    span: "col-span-1 md:col-span-2 aspect-[16/9]",
  },
];
---

<section
  class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-20 sm:py-28 px-6 sm:px-12 selection:bg-[#FDB813] selection:text-[#B31D12] overflow-hidden"
>
  <!-- Background Graph & Film Reel Borders -->
  <div class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden">
    <div
      class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
      style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
      style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
    >
    </div>
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto space-y-12 sm:space-y-16">
    <!-- Header -->
    <div
      class="border-b border-[#FDB813]/30 pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4"
    >
      <div class="space-y-2">
        <div
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#FDB813] font-bold"
        >
          <span>Festival Retrospective</span>
          <span>&bull;</span>
          <span>Photo Archives</span>
        </div>
        <h2
          class="text-4xl sm:text-6xl font-black uppercase tracking-tight text-white font-mono drop-shadow-sm"
        >
          Frames &amp; Moments
        </h2>
      </div>

      <p class="font-mono text-xs text-zinc-200 uppercase tracking-widest">
        Glimpses From Season 02
      </p>
    </div>

    <!-- Mosaic Grid with Warm Card Frames -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      {
        photos.map((photo) => (
          <button
            type="button"
            class={`group relative overflow-hidden rounded-xl bg-[#5C0D07] border-2 border-[#FDB813]/30 hover:border-[#FDB813] cursor-pointer focus:outline-none transition-all duration-300 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.3)] hover:shadow-[6px_6px_0px_0px_#FDB813] hover:-translate-y-0.5 ${photo.span}`}
            onclick={`openLightbox('${photo.src}')`}
            aria-label="View enlarged photograph"
          >
            <img
              src={photo.src}
              alt={photo.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#5C0D07]/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-between p-3">
              <span class="font-mono text-[10px] font-bold uppercase tracking-wider text-[#FDB813] bg-[#8B140B] px-2 py-0.5 rounded border border-[#FDB813]/40">
                Enlarge ↗
              </span>
            </div>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 bg-black/85 hidden items-center justify-center p-4 sm:p-8 backdrop-blur-sm"
    onclick="closeLightbox(event)"
  >
    <div class="relative max-w-5xl max-h-[90vh] flex flex-col items-end">
      <button
        type="button"
        onclick="closeLightboxDirect()"
        class="mb-3 text-[#B31D12] font-mono text-xs font-black uppercase tracking-widest bg-[#FDB813] hover:bg-white border-2 border-black px-4 py-1.5 transition-colors cursor-pointer rounded shadow-md"
      >
        Close [ESC]
      </button>
      <img
        id="lightbox-image"
        src=""
        alt="Expanded photograph"
        class="max-w-full max-h-[80vh] object-contain border-2 border-[#FDB813] bg-[#5C0D07] shadow-2xl rounded-lg"
      />
    </div>
  </div>
</section>

<script is:inline>
  function openLightbox(src) {
    const modal = document.getElementById("lightbox-modal");
    const image = document.getElementById("lightbox-image");
    if (modal && image) {
      image.src = src;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    }
  }

  function closeLightboxDirect() {
    const modal = document.getElementById("lightbox-modal");
    const image = document.getElementById("lightbox-image");
    if (modal && image) {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      image.src = "";
      document.body.style.overflow = "";
    }
  }

  function closeLightbox(event) {
    if (event.target.id === "lightbox-modal") {
      closeLightboxDirect();
    }
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeLightboxDirect();
    }
  });
</script>
