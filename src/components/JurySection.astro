---
// src/components/JurySection.astro

const juries = [
  {
    slug: "sherry-govindan",
    name: "Sherry Govindan",
    role: "Jury Chairman",
    designation: "Filmmaker",
    image: "https://i.ibb.co/j9nP0PKK/director-1311202512-56-01.jpg",
    isPlaceholder: false,
    highlights: [
      "National Film Award (2011) — Special Mention for Best Director",
      "Kerala State Film Award (2011) — Best Debut Director",
      "Jury Member — International Film Festival of Kerala (IFFK)",
      "Selection Jury Member — 49th Kerala State Film Awards",
      "Former Executive Member — Kerala State Chalachitra Academy"
    ],
    bio: "Sherry Govindan is an acclaimed Indian filmmaker whose cinematic works have earned prominent state and national recognition, making him a deeply respected voice in Malayalam independent cinema."
  },
  {
    slug: "arjun-k",
    name: "Arjun K",
    role: "Jury Member",
    designation: "Filmmaker & Film Critic",
    image: "https://i.ibb.co/mrhXq0PB/0e8b1e52-f84a-476e-8204-badc6373b8ef.jpg",
    isPlaceholder: false,
    highlights: [
      "Director — K-Pop (2025) - 13th ARKIPEL Jakarta International Documentary & Experimental Film Festival (2026)",
      "Director — Dialogues on Emancipation (2023)",
      "Festival Programmer — Independent & Experimental Film Festival of Kerala",
      "Film History Faculty — New Wave Film School",
      "Published Critic — Chalachitra Sameeksha & Drishyathalam"
    ],
    bio: "Arjun K is a Kerala-based filmmaker and critic whose work bridges fiction, documentary, and experimental cinema. Rooted in history, memory, and philosophical inquiry, his films challenge narrative conventions while maintaining sharp socio-political relevance."
  },
  {
    slug: "sanath-pc",
    name: "Sanath PC",
    role: "Festival Patron",
    designation: "Visual Effects Designer, Coordinator and Supervisor",
    image: "https://i.ibb.co/HDbc53tc/28-BGMSANATH2.jpg",
    isPlaceholder: false,
    highlights: [
      "Distinguished industry professional",
      "Evaluation committee member for official selections",
      "Co-Founder of the Visual effects company Firefly Creative Studio",
      "Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category (Oscars)",
      "National Film Award for Best Special Effects (2004)",
      "VFX Supervisor of Kalki, Bahubali, Malik, Pulimurugan, Robot etc.",
    ],
    bio: "Sanath Pilleri Chelleri professionally credited as P. C. Sanath is an Indian visual effects designer, coordinator and supervisor known for his works primarily in Telugu, Tamil and Malayalam cinema. Sanath is Co-Founder of the Visual effects company Firefly Creative Studio. Sanath is a Member of the Academy of Motion Picture Arts and Sciences in the Visual Effects category."
  }
];
---

<section
  id="jury"
  class="relative w-full bg-[#B31D12] text-[#FDFCF7] border-b-2 border-black py-16 sm:py-24 px-6 sm:px-12 overflow-hidden selection:bg-[#FDB813] selection:text-[#B31D12]"
>
  <!-- Hero Section Continuing Background Patterns & Film Borders -->
  <div class="absolute inset-0 pointer-events-none opacity-15 overflow-hidden">
    <!-- Top & Bottom Film Reel Border Patterns Matching Hero -->
    <div 
      class="absolute top-0 left-0 right-0 h-4 border-b border-[#FDB813]/40"
      style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
    ></div>
    <div 
      class="absolute bottom-0 left-0 right-0 h-4 border-t border-[#FDB813]/40"
      style="background-image: radial-gradient(#FDB813 35%, transparent 35%); background-size: 16px 16px;"
    ></div>

    <!-- Golden Graph Grid Continuation -->
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(to right, #FDB813 1px, transparent 1px), linear-gradient(to bottom, #FDB813 1px, transparent 1px); background-size: 24px 24px;"
    ></div>

    <!-- Swirling Ambient Waves -->
    <svg class="absolute -right-24 -bottom-24 w-[500px] h-[500px] text-[#FDB813]" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M50 200 C80 120, 160 80, 240 120 C320 160, 360 260, 290 330 C220 400, 100 370, 70 290 C40 210, 110 140, 190 140 C270 140, 310 220, 280 270 C250 320, 190 320, 160 280 C130 240, 150 190, 200 190" />
      <circle cx="200" cy="200" r="150" stroke-dasharray="6 6" />
    </svg>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto space-y-12 sm:space-y-16">
    
    <!-- Executive Section Header Flowing from Hero Palette -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-[#FDB813]/30 pb-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#FDB813] font-bold">
          <span>Official Evaluation Committee</span>
          <span>&bull;</span>
          <span>PSFF Season 03</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tight text-white font-mono drop-shadow-sm">
          Jury &amp; Patrons
        </h2>
      </div>

      <p class="font-mono text-xs text-zinc-100 max-w-sm leading-relaxed">
        Distinguished filmmakers and cinema practitioners heading the official evaluation panel for Season 03.
      </p>
    </div>

    <!-- Three-Column Profile Grid Sharing Hero Card Architecture -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch font-mono">
      {juries.map((jury) => (
        <article class="group relative rounded-xl bg-[#8B140B]/85 border border-[#FDB813]/40 hover:border-[#FDB813] transition-all duration-300 p-5 sm:p-6 flex flex-col justify-between shadow-[4px_4px_0px_0px_rgba(0,0,0,0.3)] hover:shadow-[6px_6px_0px_0px_#FDB813] hover:-translate-y-1 backdrop-blur-xs">
          
          <div class="space-y-5">
            <!-- Full-Color Portrait with Crisp Border Frame -->
            <a 
              href={jury.slug ? `/jury/${jury.slug}` : "#"} 
              class={`block relative aspect-[4/5] rounded-lg overflow-hidden border border-[#FDB813]/30 bg-[#5C0D07] shadow-inner ${jury.isPlaceholder ? 'flex items-center justify-center border-dashed' : ''}`}
            >
              {jury.isPlaceholder ? (
                <div class="flex flex-col items-center justify-center p-6 text-center font-mono text-zinc-300">
                  <span class="text-3xl font-light mb-2">?</span>
                  <span class="text-xs font-bold uppercase tracking-wider text-[#FDB813]">Announcement Pending</span>
                </div>
              ) : (
                <img
                  src={jury.image}
                  alt={jury.name}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />
              )}
              
              <!-- Floating Role Pill -->
              <div class="absolute bottom-3 left-3 px-3 py-1 bg-[#B31D12] text-white font-mono text-[10px] font-black uppercase tracking-wider rounded border border-[#FDB813]/60 shadow-md">
                {jury.role}
              </div>
            </a>

            <!-- Names, Designation & Overview -->
            <div class="space-y-3">
              <div class="border-b border-[#FDB813]/20 pb-3">
                <h3 class="text-xl font-black uppercase tracking-tight text-white group-hover:text-[#FDB813] transition-colors duration-200">
                  <a href={jury.slug ? `/jury/${jury.slug}` : "#"}>
                    {jury.name}
                  </a>
                </h3>
                <p class="font-mono text-xs uppercase tracking-wider text-[#FDB813] font-bold mt-1">
                  {jury.designation}
                </p>
              </div>

              <!-- Brief Bio -->
              <p class="text-xs text-zinc-100 leading-relaxed line-clamp-3 font-sans opacity-90">
                {jury.bio}
              </p>

              <!-- Curated Career Highlights -->
              <div class="pt-1">
                <div class="border-l-2 border-[#FDB813] pl-3 py-0.5 space-y-1.5">
                  {jury.highlights.slice(0, 3).map((item) => (
                    <div class="text-[11px] font-mono leading-snug text-zinc-200 truncate font-medium">
                      &bull; {item}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Professional Action Link -->
          <div class="pt-4 mt-5 border-t border-[#FDB813]/20">
            <a
              href={`/jury/${jury.slug}`}
              class="inline-flex items-center justify-between w-full py-2.5 px-3.5 rounded-lg bg-[#5C0D07]/80 hover:bg-[#FDB813] hover:text-[#B31D12] text-xs font-bold font-mono uppercase tracking-wider text-white transition-all duration-200 border border-[#FDB813]/30 hover:border-[#FDB813] shadow-sm"
            >
              <span>View Full Dossier</span>
              <span class="text-sm font-sans group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>